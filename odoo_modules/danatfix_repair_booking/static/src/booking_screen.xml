<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="danatfix_repair_booking.BookingScreen">
  <div class="df_bk">

    <div class="df_bk_bar">
      <h2 class="df_bk_title">Website Bookings</h2>
      <span class="df_bk_pill" t-att-class="{ 'df_bk_pulse': state.newCount }">
        <t t-esc="state.newCount"/> new
      </span>
      <span class="df_bk_pill df_bk_pill_open"><t t-esc="state.rows.length"/> open</span>
      <span class="df_bk_poll" t-if="state.pollReady" title="New bookings are posted to the staff WhatsApp group with a poll">
        WhatsApp poll on
      </span>
      <span class="df_bk_grow"/>
      <button class="btn btn-warning" t-if="!state.soundOn" t-on-click="onEnableSound">
        Turn on the alarm
      </button>
      <t t-else="">
        <span class="df_bk_sound_on">Alarm on</span>
        <button class="btn btn-secondary btn-sm" t-on-click="onTestSound">Test sound</button>
      </t>
      <button class="btn btn-link" t-on-click="openList">All bookings</button>
    </div>

    <div class="df_bk_warn" t-if="!state.soundOn">
      No sound yet. The browser will not play anything until you click, so new
      bookings would arrive silently - turn the alarm on.
    </div>

    <div class="df_bk_empty" t-if="!state.loading and !state.rows.length">
      <div class="df_bk_empty_mark">✓</div>
      <div>Nothing waiting. New website bookings appear here on their own.</div>
    </div>

    <div class="df_bk_grid">
      <t t-foreach="state.rows" t-as="row" t-key="row.id">
        <div class="df_bk_card" t-att-class="'df_bk_' + row.state">

          <div class="df_bk_top">
            <a href="#" class="df_bk_ref" t-on-click.prevent="() => this.openRecord(row)">
              <t t-esc="row.name"/>
            </a>
            <span class="df_bk_stage"><t t-esc="stageLabel(row)"/></span>
            <span class="df_bk_age"><t t-esc="age(row)"/></span>
          </div>
          <div class="df_bk_meta">
            <span t-if="row.web_ref"><t t-esc="row.web_ref"/></span>
            <span t-if="row.brand"><t t-esc="row.brand"/></span>
            <span t-if="row.source"><t t-esc="row.source"/></span>
          </div>

          <div class="df_bk_who">
            <div class="df_bk_cust"><t t-esc="row.customer or 'No name given'"/></div>
            <div t-if="row.phone" class="df_bk_contact">
              <a t-attf-href="tel:+#{row.phone_digits}"><t t-esc="row.phone"/></a>
              <a class="df_bk_wa" t-attf-href="https://wa.me/#{row.phone_digits}" target="_blank" rel="noopener">WhatsApp</a>
            </div>
            <div t-if="row.email"><a t-attf-href="mailto:#{row.email}"><t t-esc="row.email"/></a></div>
            <div t-if="row.address or row.area" class="df_bk_addr">
              <t t-esc="where(row)"/>
              <a t-if="row.map_url" t-att-href="row.map_url" target="_blank" rel="noopener"> · map</a>
            </div>
          </div>

          <ul class="df_bk_lines" t-if="row.lines.length">
            <t t-foreach="row.lines" t-as="line" t-key="line.id">
              <li>
                <span class="df_bk_qty"><t t-esc="line.qty"/></span>
                <span><t t-esc="lineLabel(line)"/></span>
              </li>
            </t>
          </ul>
          <div class="df_bk_note" t-if="row.coupon">Coupon: <b><t t-esc="row.coupon"/></b></div>
          <div class="df_bk_note" t-if="row.note"><t t-esc="row.note"/></div>

          <div class="df_bk_taken" t-if="row.taken_by">
            <t t-if="row.state === 'calling'">Calling: </t>
            <t t-else="">Taken by </t>
            <b><t t-esc="row.taken_by"/></b>
            <t t-if="row.decided_via === 'whatsapp'"> (WhatsApp poll)</t>
          </div>
          <div class="df_bk_err" t-if="row.poll_error" t-att-title="row.poll_error">
            WhatsApp poll not sent
          </div>

          <div class="df_bk_actions">
            <t t-if="row.state === 'new' or row.state === 'calling'">
              <button class="btn btn-primary" t-att-disabled="state.busy"
                      t-on-click="() => this.act(row, 'accept')">Accept</button>
            </t>
            <t t-if="row.state === 'new'">
              <button class="btn btn-secondary" t-att-disabled="state.busy"
                      t-on-click="() => this.act(row, 'call')">Call customer first</button>
            </t>
            <t t-if="row.state === 'accepted' or row.state === 'calling'">
              <button class="btn btn-success" t-att-disabled="state.busy"
                      t-on-click="() => this.act(row, 'done')">Done</button>
            </t>
            <button class="btn btn-link text-danger" t-att-disabled="state.busy"
                    t-on-click="() => this.onCancel(row)">Cancel</button>
          </div>
        </div>
      </t>
    </div>
  </div>
</t>

</templates>
