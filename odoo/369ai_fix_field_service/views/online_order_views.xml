<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_online_order_form_visit" model="ir.ui.view">
        <field name="name">online.service.order.form.visit</field>
        <field name="model">online.service.order</field>
        <field name="inherit_id" ref="369ai_fix_customer_module.view_online_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_confirm']" position="after">
                <button name="action_schedule_visit" type="object" string="Schedule Visit"
                        invisible="mode != 'doorstep' or state == 'cancelled' or visit_count"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_visits" type="object" class="oe_stat_button"
                        icon="fa-motorcycle" invisible="not visit_count">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Visit</span>
                        <field name="visit_state" readonly="1"/>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='map_url']" position="after">
                <field name="customer_lat" invisible="not customer_lat and not customer_lng"/>
                <field name="customer_lng" invisible="not customer_lat and not customer_lng"/>
                <field name="location_accuracy" invisible="not location_accuracy"/>
                <field name="location_source" invisible="not location_source"/>
                <field name="visit_count" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_online_order_list_visit" model="ir.ui.view">
        <field name="name">online.service.order.list.visit</field>
        <field name="model">online.service.order</field>
        <field name="inherit_id" ref="369ai_fix_customer_module.view_online_order_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='job_card_state']" position="after">
                <field name="visit_state" optional="show" string="Visit"/>
            </xpath>
        </field>
    </record>
</odoo>
