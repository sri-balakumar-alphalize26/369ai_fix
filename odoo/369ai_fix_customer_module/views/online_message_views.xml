<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_online_message_list" model="ir.ui.view">
        <field name="name">online.service.message.list</field>
        <field name="model">online.service.message</field>
        <field name="arch" type="xml">
            <list string="Status Messages">
                <field name="sequence" widget="handle"/>
                <field name="key"/>
                <field name="body"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_online_message_form" model="ir.ui.view">
        <field name="name">online.service.message.form</field>
        <field name="model">online.service.message</field>
        <field name="arch" type="xml">
            <form string="Status Message">
                <sheet>
                    <group>
                        <field name="key"/>
                        <field name="active"/>
                        <field name="body" widget="text"/>
                    </group>
                    <div class="text-muted small">
                        Placeholders: {name} customer, {order} order no., {status}, {job_card} job card no.,
                        {site} website name, {track_url} tracking link, {summary} what was booked.
                        Switch a message off to send nothing at that status.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_online_message" model="ir.actions.act_window">
        <field name="name">Status Messages</field>
        <field name="res_model">online.service.message</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

</odoo>
