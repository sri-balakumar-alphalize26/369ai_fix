<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_visit_result_wizard_form" model="ir.ui.view">
        <field name="name">fix.visit.result.wizard.form</field>
        <field name="model">fix.visit.result.wizard</field>
        <field name="arch" type="xml">
            <form string="What did you find?">
                <field name="visit_id" invisible="1"/>
                <field name="need_device" invisible="1"/>
                <field name="has_parts" invisible="1"/>
                <field name="to_order" invisible="1"/>
                <group>
                    <field name="found" placeholder="e.g. The screen is cracked and the battery is swollen" nolabel="1" colspan="2"/>
                </group>
                <group invisible="not need_device" string="Device (no job card yet)">
                    <group>
                        <field name="category_id" options="{'no_create': True}"/>
                        <field name="brand_id" options="{'no_create': True}" required="need_device"/>
                    </group>
                    <group>
                        <field name="model_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <h4>Parts needed <small class="text-muted">(leave empty when no part is needed)</small></h4>
                <field name="line_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="product_id" options="{'no_create': True}"/>
                        <field name="qty"/>
                        <field name="price" readonly="1" optional="show"/>
                        <field name="status" widget="badge" readonly="1"
                               decoration-success="status == 'in_stock'" decoration-warning="status == 'other_branch'"
                               decoration-danger="status == 'order'"/>
                        <field name="where" readonly="1"/>
                    </list>
                </field>

                <!-- parts: the quotation goes first, with what happens once the customer approves -->
                <div invisible="not has_parts" class="mt-3">
                    <div class="alert alert-info" role="status">
                        The customer gets the parts and the price to <strong>approve first</strong>
                        (WhatsApp link, or tell you at the door). Nothing is repaired, taken or ordered before.
                    </div>
                    <group>
                        <group>
                            <field name="plan_here" widget="radio" invisible="to_order"/>
                            <field name="plan_order" widget="radio" invisible="not to_order"/>
                            <field name="part_days" invisible="not to_order"/>
                        </group>
                        <group>
                            <label for="days" string="Fixed within"
                                   invisible="to_order or plan_here == 'now'"/>
                            <label for="days" string="Repair after the part arrives"
                                   invisible="not to_order or plan_order != 'order_take'"/>
                            <div class="o_row" invisible="(not to_order and plan_here == 'now') or (to_order and plan_order != 'order_take')">
                                <field name="days" nolabel="1" class="oe_inline"/>
                                <field name="days_unit" nolabel="1" class="oe_inline"/>
                            </div>
                        </group>
                    </group>
                </div>
                <footer>
                    <button name="action_fixed" type="object" string="Fixed on the spot" class="btn-primary"
                            invisible="has_parts"/>
                    <button name="action_quote" type="object" string="Send the quotation" class="btn-primary"
                            invisible="not has_parts"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
