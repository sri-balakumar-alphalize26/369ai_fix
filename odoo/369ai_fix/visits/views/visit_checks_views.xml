<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The two lists (menus: app/views/menus.xml, 369 ai Fix > Configuration) -->
    <record id="view_safety_item_list" model="ir.ui.view">
        <field name="name">fix.safety.item.list</field>
        <field name="model">fix.safety.item</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="required"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="action_safety_items" model="ir.actions.act_window">
        <field name="name">Safety Checklist</field>
        <field name="res_model">fix.safety.item</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add what the technician wears before touching a device</p>
            <p>Gloves, mask, wrist strap... Work cannot start until every required item is ticked.</p>
        </field>
    </record>

    <record id="view_device_angle_list" model="ir.ui.view">
        <field name="name">fix.device.angle.list</field>
        <field name="model">fix.device.angle</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" string="Side"/>
                <field name="required"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="action_device_angles" model="ir.actions.act_window">
        <field name="name">Device Photos</field>
        <field name="res_model">fix.device.angle</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add the sides of the device to photograph</p>
            <p>Front, back, left, right, top, bottom: the device's condition before anyone touches it.</p>
        </field>
    </record>

    <!-- "Before you start": opened by Start work while the checks are not done -->
    <record id="view_service_visit_checks_form" model="ir.ui.view">
        <field name="name">fix.service.visit.checks</field>
        <field name="model">fix.service.visit</field>
        <field name="priority">50</field>
        <field name="arch" type="xml">
            <form string="Before you start">
                <field name="state" invisible="1"/>
                <field name="checks_done" invisible="1"/>
                <field name="checks_is_manager" invisible="1"/>
                <div class="alert alert-warning" role="alert" invisible="checks_done">
                    <strong>Still to do before work starts</strong>
                    <field name="checks_missing" nolabel="1" readonly="1"/>
                </div>
                <div class="alert alert-success" role="alert" invisible="not checks_done">
                    All checks are done. Press <strong>Start work</strong>.
                </div>

                <h4>Brand warranty <small class="text-muted">(asked first - dial *#06# for the IMEI)</small></h4>
                <field name="warranty_answer" readonly="1" placeholder="Not answered yet"/>
                <div class="mb-3" invisible="warranty_answer in ('no', 'ours')">
                    <button name="action_vc_warranty_no" type="object" string="Not under warranty" class="btn-secondary"/>
                    <button name="action_vc_warranty_ours" type="object" string="Under warranty: customer wants our repair" class="btn-secondary ms-2"/>
                    <button name="action_vc_warranty_keep" type="object" string="Under warranty: customer keeps it (close)" class="btn-secondary ms-2"
                            confirm="The visit closes now, nothing is opened, and the customer gets a polite message. Continue?"/>
                </div>

                <h4>1. Safety check</h4>
                <field name="safety_line_ids" nolabel="1">
                    <list editable="bottom" create="0" delete="0">
                        <field name="name" readonly="1"/>
                        <field name="required" readonly="1" optional="hide"/>
                        <field name="worn" widget="boolean_toggle"/>
                    </list>
                </field>
                <h4 class="mt-3">2. Photo of the technician ready to work <small class="text-muted">(1 to 3)</small></h4>
                <field name="safety_photo_ids" nolabel="1" mode="kanban" context="{'default_kind': 'safety'}">
                    <kanban>
                        <field name="image"/>
                        <templates>
                            <t t-name="card">
                                <field name="image" widget="image" options="{'size': [120, 120]}"/>
                            </t>
                        </templates>
                    </kanban>
                    <form string="Safety photo">
                        <field name="kind" invisible="1"/>
                        <field name="image" widget="image" required="1"/>
                    </form>
                </field>
                <h4 class="mt-3">3. Device photos <small class="text-muted">(every side)</small></h4>
                <field name="device_photo_ids" nolabel="1" mode="kanban">
                    <kanban create="0" delete="0">
                        <field name="image"/>
                        <field name="name"/>
                        <templates>
                            <t t-name="card">
                                <strong><field name="name"/></strong>
                                <field name="image" widget="image" options="{'size': [120, 120]}"/>
                                <span t-if="!record.image.raw_value" class="text-danger">Tap to take the photo</span>
                            </t>
                        </templates>
                    </kanban>
                    <form string="Device photo">
                        <field name="name" readonly="1"/>
                        <field name="image" widget="image"/>
                    </form>
                </field>
                <h4 class="mt-3">4. Short video of the device</h4>
                <field name="device_video_name" invisible="1"/>
                <field name="device_video" filename="device_video_name" nolabel="1"/>

                <group invisible="not checks_is_manager or checks_done" class="mt-3">
                    <field name="checks_override_reason" placeholder="Only if work must start anyway"/>
                </group>
                <footer>
                    <button name="action_start_checked" type="object" string="Start work" class="btn-primary"/>
                    <button special="save" string="Save, start later" class="btn-secondary"/>
                    <button name="action_start_without_checks" type="object" string="Start without the checks"
                            class="btn-link text-danger" invisible="not checks_is_manager or checks_done"
                            confirm="Start work without the safety check and photos? The reason is recorded."/>
                    <button special="cancel" string="Close" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- On the visit: a "Before work" tab, and the window from the header -->
    <record id="view_service_visit_form_checks" model="ir.ui.view">
        <field name="name">fix.service.visit.form.checks</field>
        <field name="model">fix.service.visit</field>
        <field name="inherit_id" ref="369ai_fix.view_service_visit_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_start']" position="after">
                <button name="action_open_checks" type="object" string="Before you start"
                        invisible="state != 'arrived'"/>
                <field name="check_result" invisible="1"/>
                <button name="action_open_result" type="object" string="What did you find?" class="btn-primary"
                        invisible="state != 'in_progress' or check_result in ('waiting', 'repairing', 'to_take')"/>
                <!-- the quotation is with the customer -->
                <button name="action_vr_approved_here" type="object" string="Customer approved" class="btn-primary"
                        invisible="state != 'in_progress' or check_result != 'waiting'"
                        confirm="The customer approved the price? The plan goes ahead."/>
                <button name="action_vr_declined_here" type="object" string="Customer declined"
                        invisible="state != 'in_progress' or check_result != 'waiting'"
                        confirm="The customer declined? Nothing is repaired or ordered."/>
                <button name="action_vr_later" type="object" string="Customer decides later"
                        invisible="state != 'in_progress' or check_result != 'waiting'"/>
                <!-- approved -->
                <button name="action_vr_done" type="object" string="Repair done" class="btn-primary"
                        invisible="state != 'in_progress' or check_result != 'repairing'"/>
                <button name="action_open_take" type="object" string="Take the device" class="btn-primary"
                        invisible="state != 'in_progress' or check_result != 'to_take'"/>
            </xpath>
            <xpath expr="//page[@name='timeline']" position="before">
                <page string="Visit work" name="before_work">
                    <group invisible="not check_result" string="What the technician found">
                        <field name="check_result" widget="badge"/>
                        <field name="check_found" readonly="1"/>
                        <field name="check_days" invisible="not check_days"/>
                        <field name="pend_plan" invisible="not pend_plan"/>
                        <field name="pend_date" invisible="not pend_date"/>
                        <field name="check_result_on"/>
                    </group>
                    <field name="checks_done" invisible="1"/>
                    <div class="alert alert-success" role="status" invisible="not checks_done">
                        Safety check, device photos and video done<span invisible="not checks_done_on">
                        on <field name="checks_done_on" readonly="1" class="d-inline"/></span>.
                    </div>
                    <div class="alert alert-warning" role="status" invisible="checks_done">
                        <strong>Still to do</strong>
                        <field name="checks_missing" nolabel="1" readonly="1"/>
                    </div>
                    <group invisible="not checks_override_by_id">
                        <field name="checks_override_by_id"/>
                        <field name="checks_override_reason" readonly="1"/>
                    </group>
                    <group>
                        <group string="Safety check">
                            <field name="safety_line_ids" nolabel="1" colspan="2">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="name" readonly="1"/>
                                    <field name="worn" widget="boolean_toggle"/>
                                    <field name="checked_on" optional="show"/>
                                </list>
                            </field>
                        </group>
                        <group string="Device video">
                            <field name="device_video_name" invisible="1"/>
                            <field name="device_video" filename="device_video_name" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                    <separator string="Safety photos"/>
                    <field name="safety_photo_ids" nolabel="1" mode="kanban" context="{'default_kind': 'safety'}">
                        <kanban>
                            <field name="image"/>
                            <field name="taken_on"/>
                            <templates>
                                <t t-name="card">
                                    <field name="image" widget="image" options="{'size': [120, 120]}"/>
                                    <small class="text-muted"><field name="taken_on"/></small>
                                </t>
                            </templates>
                        </kanban>
                        <form string="Safety photo">
                            <field name="kind" invisible="1"/>
                            <field name="image" widget="image" required="1"/>
                        </form>
                    </field>
                    <separator string="Device photos"/>
                    <field name="device_photo_ids" nolabel="1" mode="kanban">
                        <kanban create="0" delete="0">
                            <field name="image"/>
                            <field name="name"/>
                            <field name="taken_on"/>
                            <templates>
                                <t t-name="card">
                                    <strong><field name="name"/></strong>
                                    <field name="image" widget="image" options="{'size': [120, 120]}"/>
                                    <span t-if="!record.image.raw_value" class="text-danger">Missing</span>
                                    <small t-else="" class="text-muted"><field name="taken_on"/></small>
                                </t>
                            </templates>
                        </kanban>
                        <form string="Device photo">
                            <field name="name" readonly="1"/>
                            <field name="image" widget="image"/>
                        </form>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
