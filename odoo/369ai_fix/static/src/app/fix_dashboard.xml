<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="369ai_fix.Dashboard">
        <div class="o_fxdash">
            <!-- 369 Mart's desk look: title, tiles (each opens its list), boxes -->
            <header class="fxdash-head">
                <h1>Dashboard</h1>
                <p>Website bookings, job cards and visits at a glance.</p>
            </header>

            <t t-if="state.isLoading">
                <div class="fxdash-loading"><i class="fa fa-circle-o-notch fa-spin fa-2x"/><p class="mt-2">Loading…</p></div>
            </t>

            <t t-else="">
                <!-- Website bookings that need staff -->
                <h2 class="fxdash-h2">Website bookings</h2>
                <div class="fxdash-tiles">
                    <button class="fxdash-tile fxdash-red" t-on-click="() => this.open('bookings', 'new')">
                        <span class="fxdash-tile-top"><i class="fa fa-bell" aria-hidden="true"/> Waiting for approval</span>
                        <span class="fxdash-tile-count" t-out="state.data.wb_waiting || 0"/>
                        <small>Show these</small>
                    </button>
                    <button class="fxdash-tile fxdash-blue" t-on-click="() => this.open('bookings', 'slot_unseen')">
                        <span class="fxdash-tile-top"><i class="fa fa-calendar-check-o" aria-hidden="true"/> Visit time booked</span>
                        <span class="fxdash-tile-count" t-out="state.data.wb_slot_unseen || 0"/>
                        <small>Show these</small>
                    </button>
                    <button class="fxdash-tile fxdash-amber" t-on-click="() => this.open('bookings', 'parts')">
                        <span class="fxdash-tile-top"><i class="fa fa-cube" aria-hidden="true"/> Waiting for parts</span>
                        <span class="fxdash-tile-count" t-out="state.data.wb_parts || 0"/>
                        <small>Show these</small>
                    </button>
                    <button class="fxdash-tile fxdash-grey" t-on-click="() => this.open('bookings', 'rejected_today')">
                        <span class="fxdash-tile-top"><i class="fa fa-ban" aria-hidden="true"/> Rejected today</span>
                        <span class="fxdash-tile-count" t-out="state.data.wb_rejected_today || 0"/>
                        <small>Show these</small>
                    </button>
                </div>

                <!-- Job cards made from website bookings -->
                <h2 class="fxdash-h2">Job cards</h2>
                <div class="fxdash-tiles">
                    <button class="fxdash-tile fxdash-grey" t-on-click="() => this.openJobCards('draft')">
                        <span class="fxdash-tile-top"><i class="fa fa-pencil-square-o" aria-hidden="true"/> Draft</span>
                        <span class="fxdash-tile-count" t-out="state.data.state_counts.draft || 0"/>
                        <small>Show these</small>
                    </button>
                    <button class="fxdash-tile fxdash-blue" t-on-click="() => this.openJobCards('inspection')">
                        <span class="fxdash-tile-top"><i class="fa fa-search" aria-hidden="true"/> Inspection</span>
                        <span class="fxdash-tile-count" t-out="state.data.state_counts.inspection || 0"/>
                        <small>Show these</small>
                    </button>
                    <button class="fxdash-tile fxdash-amber" t-on-click="() => this.openJobCards('quotation')">
                        <span class="fxdash-tile-top"><i class="fa fa-clipboard" aria-hidden="true"/> Quotation</span>
                        <span class="fxdash-tile-count" t-out="state.data.state_counts.quotation || 0"/>
                        <small>Show these</small>
                    </button>
                    <button class="fxdash-tile fxdash-green" t-on-click="() => this.openJobCards('repair')">
                        <span class="fxdash-tile-top"><i class="fa fa-wrench" aria-hidden="true"/> Repair</span>
                        <span class="fxdash-tile-count" t-out="state.data.state_counts.repair || 0"/>
                        <small>Show these</small>
                    </button>
                    <button class="fxdash-tile fxdash-green" t-on-click="() => this.openJobCards('completed')">
                        <span class="fxdash-tile-top"><i class="fa fa-check-circle-o" aria-hidden="true"/> Completed</span>
                        <span class="fxdash-tile-count" t-out="state.data.state_counts.completed || 0"/>
                        <small>Show these</small>
                    </button>
                    <button class="fxdash-tile fxdash-red" t-on-click="() => this.openJobCards('cancelled')">
                        <span class="fxdash-tile-top"><i class="fa fa-times-circle-o" aria-hidden="true"/> Cancelled</span>
                        <span class="fxdash-tile-count" t-out="state.data.state_counts.cancelled || 0"/>
                        <small>Show these</small>
                    </button>
                </div>

                <div class="fxdash-row">
                    <div class="fxdash-box">
                        <h3>Statistics</h3>
                        <div class="fxdash-stats">
                            <div class="fxdash-stat">
                                <div class="fxdash-stat-count" t-out="state.data.completed || 0"/>
                                <div class="fxdash-stat-label">Completed</div>
                            </div>
                            <div class="fxdash-stat fxdash-stat-pending">
                                <div class="fxdash-stat-count" t-out="state.data.pending || 0"/>
                                <div class="fxdash-stat-label">Pending</div>
                            </div>
                        </div>
                    </div>

                    <div class="fxdash-box">
                        <h3>Online orders</h3>
                        <div class="fxdash-lines">
                            <button class="fxdash-line" t-on-click="() => this.open('bookings', 'new_doorstep')">
                                <span class="fxdash-dot fxdash-blue"/><span>New doorstep</span><b t-out="state.data.online_new_doorstep || 0"/>
                            </button>
                            <button class="fxdash-line" t-on-click="() => this.open('bookings', 'new_pickup')">
                                <span class="fxdash-dot fxdash-amber"/><span>New pickup</span><b t-out="state.data.online_new_pickup || 0"/>
                            </button>
                            <button class="fxdash-line" t-on-click="() => this.open('bookings', 'to_confirm')">
                                <span class="fxdash-dot fxdash-grey"/><span>To confirm</span><b t-out="state.data.online_new_other || 0"/>
                            </button>
                            <button class="fxdash-line" t-on-click="() => this.open('bookings', 'confirmed')">
                                <span class="fxdash-dot fxdash-green"/><span>Confirmed, in progress</span><b t-out="state.data.online_open || 0"/>
                            </button>
                        </div>
                    </div>

                    <div class="fxdash-box">
                        <h3>Doorstep visits</h3>
                        <div class="fxdash-lines">
                            <button class="fxdash-line" t-on-click="() => this.openVisits('draft')">
                                <span class="fxdash-dot fxdash-grey"/><span>To assign</span><b t-out="state.data.visits.draft || 0"/>
                            </button>
                            <button class="fxdash-line" t-on-click="() => this.openVisits('assigned')">
                                <span class="fxdash-dot fxdash-blue"/><span>Assigned</span><b t-out="state.data.visits.assigned || 0"/>
                            </button>
                            <button class="fxdash-line" t-on-click="() => this.openVisits('on_the_way')">
                                <span class="fxdash-dot fxdash-amber"/><span>On the way</span><b t-out="state.data.visits.on_the_way || 0"/>
                            </button>
                            <button class="fxdash-line" t-on-click="() => this.openVisits('at_customer')">
                                <span class="fxdash-dot fxdash-green"/><span>At the customer</span><b t-out="state.data.visits.at_customer || 0"/>
                            </button>
                            <button class="fxdash-line" t-on-click="() => this.openVisits('done_today')">
                                <span class="fxdash-dot fxdash-green"/><span>Done today</span><b t-out="state.data.visits.done_today || 0"/>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="fxdash-box fxdash-chart">
                    <h3>Completed repairs by month</h3>
                    <div class="fxdash-bars">
                        <t t-foreach="state.data.completed_by_month || []" t-as="item" t-key="item.month">
                            <div class="fxdash-bar">
                                <div class="fxdash-bar-value" t-out="item.count"/>
                                <div class="fxdash-bar-fill" t-attf-style="height: {{ barHeight(item) }}%"/>
                                <div class="fxdash-bar-label" t-out="item.month"/>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
