<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- the list's order (Booking Desk, My Visits): our own menu, not the browser's dropdown -->
    <t t-name="369ai_fix.FixSort">
        <div class="fxd-sort" t-att-class="{ 'fxd-sort-open': state.open }" t-ref="root">
            <button type="button" class="fxd-sort-btn" aria-haspopup="listbox" title="Order of the list"
                    t-att-aria-expanded="state.open ? 'true' : 'false'" t-on-click="toggle" t-on-keydown="onKey">
                <i class="fa fa-sort-amount-desc fxd-sort-ic" aria-hidden="true"/>
                <span class="fxd-sort-label" t-esc="current[1]"/>
                <i class="fa fa-chevron-down fxd-sort-caret" aria-hidden="true"/>
            </button>
            <ul class="fxd-sort-menu" role="listbox" aria-label="Order of the list" t-if="state.open">
                <li class="fxd-sort-title" role="presentation">Show first</li>
                <t t-foreach="props.options" t-as="opt" t-key="opt[0]">
                    <li role="option" t-att-aria-selected="opt[0] === props.value ? 'true' : 'false'"
                        t-att-class="{ 'fxd-sort-on': opt[0] === props.value, 'fxd-sort-active': opt_index === state.active }"
                        t-on-click="() => this.pick(opt[0])" t-on-mouseenter="() => state.active = opt_index">
                        <span t-esc="opt[1]"/>
                        <i class="fa fa-check" t-if="opt[0] === props.value" aria-hidden="true"/>
                    </li>
                </t>
            </ul>
        </div>
    </t>

    <!-- the part questions of a booking and their answers (Booking Desk, My Visits): `asks`, `cur`;
         the component gives `when(at)` and `money(amount, currency)` -->
    <t t-name="369ai_fix.PartAskHistory">
        <ul class="fxd-ask-list">
            <t t-foreach="asks" t-as="a" t-key="a.id">
                <li t-attf-class="fxd-ask-row fxd-ask-row-{{ a.state }}">
                    <div class="fxd-ask-q">
                        <b t-esc="a.name"/>
                        <small><t t-esc="a.technician or 'Technician'"/> · <t t-esc="when(a.asked_on)"/><t t-if="a.rough_price"> · about <t t-esc="money(a.rough_price, a.currency || cur)"/></t><t t-if="a.visit"> · <t t-esc="a.visit"/></t></small>
                    </div>
                    <div class="fxd-ask-a">
                        <span class="fxd-ask-badge" t-esc="a.state_label"/>
                        <span t-if="a.state === 'found'"><t t-esc="a.part"/> · <t t-esc="money(a.price, a.currency || cur)"/></span>
                        <span t-if="a.reply" t-esc="a.reply"/>
                        <small t-if="a.by"><t t-esc="a.by"/><t t-if="a.answered_on"> · <t t-esc="when(a.answered_on)"/></t></small>
                    </div>
                </li>
            </t>
        </ul>
    </t>

    <!-- ================================================================ the screen -->
    <t t-name="369ai_fix.Desk">
        <Layout display="{ controlPanel: {} }" className="'o_fxd o_fxdesk h-100'">
            <!-- 369 Mart's desk look (in our green): head, tiles, the stages as tabs + search, cards | the booking -->
            <div class="fxd fxk">

                <header class="fxk-head">
                    <div class="fxk-title">
                        <h1>Booking Desk</h1>
                        <p>Every website booking, from new to done.</p>
                    </div>
                    <!-- no spacer: the alarm toasts cover the top right, so the search and buttons stay by the title -->
                    <div class="fxk-head-acts">
                        <!-- search every booking (any stage, any date): name, phone, OS/…, VIS/… or the job card -->
                        <label class="mart-search fxk-search" role="search">
                            <i class="fa fa-search" aria-hidden="true"/>
                            <input type="search" placeholder="Name, phone, OS/01520 or VIS/01045"
                                   aria-label="Search bookings" autocomplete="off" t-att-value="state.searchQ"
                                   t-on-input="onSearch" t-on-keydown="onSearchKey"/>
                            <i class="fa fa-circle-o-notch fa-spin" t-if="state.searching" aria-hidden="true"/>
                            <button type="button" class="mart-search-x" t-elif="state.searchQ" aria-label="Clear the search" t-on-click="clearSearch"><i class="fa fa-times"/></button>
                        </label>
                        <button class="mart-btn fxk-alarm-off" t-if="!state.soundOn" t-on-click="onEnableSound">
                            <i class="fa fa-volume-up"/> Turn on the alarm
                        </button>
                        <t t-else="">
                            <span class="fxk-sound"><i class="fa fa-volume-up"/> Alarm on</span>
                            <button class="mart-btn mart-btn-sm" t-on-click="onTestSound">Test</button>
                        </t>
                        <span class="mart-pill mart-t-green" t-if="state.pollReady" title="New bookings are posted to the staff WhatsApp group with a poll">
                            <i/> WhatsApp poll on
                        </span>
                        <button class="mart-btn mart-btn-sm" t-on-click="openAll"><i class="fa fa-list"/> All bookings</button>
                    </div>
                </header>

                <div class="pe-error fxk-warn" t-if="!state.soundOn">
                    No sound yet: the browser will not play anything until you click. Turn the alarm on, or new bookings arrive silently.
                </div>

                <!-- what needs someone now, as tiles: each opens its tab (and leaves any search) -->
                <div class="fxk-tiles" t-att-class="{ 'fxk-tiles-hide': state.tilesHidden }">
                    <button type="button" class="fxk-tile fxk-tile-new" t-att-class="{ 'fxk-tile-on': state.stage === 'new' and !searchActive, 'fxk-tile-hot': state.counts.new }"
                            t-on-click="() => this.goTo('new')">
                        <span class="fxk-tile-top"><i class="fa fa-bell"/> New bookings</span>
                        <b t-esc="state.counts.new || 0"/><small>Approve, call or reject</small>
                    </button>
                    <button type="button" class="fxk-tile" t-att-class="{ 'fxk-tile-on': state.stage === 'booked' and !searchActive, 'fxk-tile-hot': state.counts.booked }"
                            t-on-click="() => this.goTo('booked')">
                        <span class="fxk-tile-top"><i class="fa fa-calendar-check-o"/> Times booked</span>
                        <b t-esc="state.counts.booked || 0"/><small>Customers picked a time</small>
                    </button>
                    <button type="button" class="fxk-tile" t-att-class="{ 'fxk-tile-on': state.stage === 'live' and !searchActive }"
                            t-on-click="() => this.goTo('live')">
                        <span class="fxk-tile-top"><i class="fa fa-car"/> Technicians out</span>
                        <b t-esc="state.counts.live || 0"/><small>On the way or at the door</small>
                    </button>
                    <button type="button" class="fxk-tile" t-att-class="{ 'fxk-tile-hot': state.partAsks }"
                            t-on-click="() => this.goTo('working', (row) => row.part_asked)">
                        <span class="fxk-tile-top"><i class="fa fa-cogs"/> Parts asked</span>
                        <b t-esc="state.partAsks || 0"/><small>A technician waits for your answer</small>
                    </button>
                </div>

                <!-- the stages as tabs -->
                <div class="pe-toolbar fxk-toolbar">
                    <Tabs tabs="stageTabs" value="state.stage" onChange="(k) => this.setStage(k)"/>
                </div>

                <div class="fxd-body" t-att-class="{ 'fxd-detail-open': state.showDetail }">

                    <!-- the cards of the stage -->
                    <section class="fxd-list" t-on-scroll="onPaneScroll">
                        <t t-if="searchActive">
                            <div class="fxd-list-head">
                                <div class="fxd-list-title">
                                    <h2>Search results</h2>
                                    <span class="fxd-found" t-if="state.found !== null" role="status">
                                        <t t-esc="state.foundCount"/> found<t t-if="state.foundCount > state.found.length"> · newest <t t-esc="state.found.length"/> shown</t>
                                    </span>
                                </div>
                                <small>All bookings, every stage and date. Tap one to open it.</small>
                            </div>
                            <div class="fxd-empty" t-if="state.found !== null and !state.found.length">
                                <span class="fxd-empty-mark fxd-empty-soft"><i class="fa fa-search"/></span>
                                <span>No booking matches "<t t-esc="state.searchQ.trim()"/>". Try the number only (e.g. 1520) or part of the name.</span>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="fxd-list-head">
                                <div class="fxd-list-title">
                                    <h2 t-esc="stageLabel(state.stage)"/>
                                    <FixSort options="sorts" value="state.sort" onChange="(key) => this.setSort(key)"/>
                                </div>
                                <small t-esc="stageHint(state.stage)"/>
                            </div>
                            <div class="fxd-empty" t-if="state.loading"><i class="fa fa-circle-o-notch fa-spin"/> Loading…</div>
                            <div class="fxd-empty" t-elif="!state.rows.length">
                                <span class="fxd-empty-mark"><i class="fa fa-check"/></span>
                                <span>Nothing here. New bookings appear on their own.</span>
                            </div>
                        </t>
                        <!-- the cards; in search results each stage gets its own heading line ("Working · 1") -->
                        <t t-foreach="listItems" t-as="it" t-key="it.key">
                            <t t-set="row" t-value="it.row"/>
                            <div t-if="it.head" t-attf-class="fxd-group-head fxd-stage-{{ it.stage }}" role="heading" aria-level="3">
                                <span class="fxd-group-dot"/>
                                <span class="fxd-group-label" t-esc="it.head"/>
                                <span class="fxd-group-count" t-esc="it.count"/>
                            </div>
                            <article t-else="" t-att-class="cardClass(row)" t-on-click="() => this.select(row)" role="button" tabindex="0">
                                <div class="fxd-card-top">
                                    <b class="fxd-ref" t-esc="row.name"/>
                                    <span class="fxd-mode" t-esc="row.mode_label"/>
                                    <span class="fxd-age" t-esc="age(row)"/>
                                </div>
                                <div class="fxd-card-cust"><t t-esc="row.customer or 'No name given'"/><small t-if="row.area"> · <t t-esc="row.area"/></small></div>
                                <div class="fxd-card-sum" t-if="row.summary" t-esc="row.summary"/>
                                <div class="fxd-card-meta">
                                    <span class="fxd-chip" t-if="searchActive and row.visits"><i class="fa fa-car"/> <t t-esc="row.visits"/></span>
                                    <span class="fxd-chip fxd-chip-blue" t-if="row.slot" t-att-class="{ 'fxd-chip-pulse': row.slot_unseen }"><i class="fa fa-calendar"/> <t t-esc="row.slot"/></span>
                                    <span class="fxd-chip" t-if="row.total"><t t-esc="money(row.total, row.currency)"/></span>
                                    <span class="fxd-chip fxd-chip-amber" t-if="row.parts_badge" t-esc="row.parts_badge"/>
                                    <span class="fxd-chip" t-if="row.technician"><i t-if="row.stale" class="fxd-stale" title="Signal lost"/><i t-else="" class="fa fa-user"/> <t t-esc="row.technician"/></span>
                                    <span class="fxd-chip fxd-chip-blue" t-if="row.eta">ETA <t t-esc="row.eta"/> min</span>
                                    <span class="fxd-chip fxd-chip-amber" t-if="row.calling_by">Calling: <t t-esc="row.calling_by"/></span>
                                    <span class="fxd-chip fxd-chip-amber" t-if="row.office === 'on_way'"><i class="fa fa-truck"/> On the way to the office</span>
                                    <span class="fxd-chip fxd-chip-red" t-if="row.overdue"><i class="fa fa-exclamation-circle"/> Overdue: <t t-esc="row.overdue === 'price' ? 'price' : 'return'"/></span>
                                    <span class="fxd-chip" t-if="row.labour"><i class="fa fa-wrench"/> Labour: <t t-esc="row.labour === 'free' ? 'free' : money(row.labour, row.currency)"/></span>
                                    <span class="fxd-chip fxd-chip-amber" t-if="row.recheck" t-att-title="'No fault found on ' + row.recheck"><i class="fa fa-refresh"/> Free re-check</span>
                                    <span class="fxd-chip fxd-chip-red fxd-chip-pulse" t-if="row.part_asked" t-att-title="row.part_asked"><i class="fa fa-bell"/> Part asked: <t t-esc="row.part_asked"/></span>
                                    <span class="fxd-chip fxd-chip-red" t-if="row.tools_missing" t-att-title="'Missing Tools: ' + row.tools_missing"><i class="fa fa-briefcase"/> Tool missing: <t t-esc="row.tools_missing"/></span>
                                    <span class="fxd-chip fxd-chip-red" t-if="row.reject_pending">Reject: reason needed</span>
                                    <span class="fxd-chip fxd-chip-red" t-if="row.needs_screen" t-att-title="row.needs_screen">Finish here</span>
                                    <span class="fxd-chip" t-if="row.at_office and row.office !== 'on_way'" t-att-title="row.office_by and ('Received by ' + row.office_by)"><i class="fa fa-building"/> At the office<t t-if="row.office_by"> · received by <t t-esc="row.office_by"/></t></span>
                                    <span class="fxd-chip" t-if="row.visit_label and row.stage !== 'new'" t-esc="row.visit_label"/>
                                </div>
                            </article>
                        </t>
                    </section>

                    <!-- the booking -->
                    <aside class="fxd-pane" t-on-scroll="onPaneScroll">
                        <div class="fxd-empty fxd-pane-empty" t-if="!state.selectedId">
                            <span class="fxd-empty-mark fxd-empty-soft"><i class="fa fa-hand-pointer-o"/></span>
                            <span>Pick a booking on the left.</span>
                        </div>
                        <div class="fxd-empty fxd-pane-empty" t-elif="!state.detail"><i class="fa fa-circle-o-notch fa-spin"/> Loading…</div>
                        <t t-else="" t-call="369ai_fix.DeskDetail"/>
                    </aside>
                </div>

                <!-- the customer's photo / video, on this page -->
                <div class="fxd-media" t-if="state.media" t-on-click.self="closeMedia" role="dialog" aria-modal="true">
                    <button type="button" class="fxd-media-x" t-on-click="closeMedia" aria-label="Close"><i class="fa fa-times"/></button>
                    <video t-if="state.media.type === 'video'" t-att-src="state.media.src" controls="controls" autoplay="autoplay" playsinline="playsinline"/>
                    <img t-else="" t-att-src="state.media.src" alt="Customer photo"/>
                    <a class="fxd-media-open" t-att-href="state.media.src" target="_blank" rel="noopener"><i class="fa fa-external-link"/> Open in a new tab</a>
                </div>
            </div>
        </Layout>
    </t>

    <!-- ================================================================ the detail pane -->
    <t t-name="369ai_fix.DeskDetail">
        <t t-set="d" t-value="state.detail"/>
        <div class="fxd-detail">

            <div class="fxd-head">
                <button class="fxd-back" t-on-click="closeDetail" title="Back to the list"><i class="fa fa-arrow-left"/></button>
                <div class="fxd-head-main">
                    <h2><t t-esc="d.name"/><span t-attf-class="fxd-stage-pill fxd-stage-{{ d.stage }}"><t t-esc="d.stage_label or d.state_label"/></span></h2>
                    <small><t t-esc="d.mode_label"/> · booked <t t-esc="when(d.created)"/><t t-if="d.opened_by"> · opened by <t t-esc="d.opened_by"/></t></small>
                </div>
            </div>
            <div class="fxd-moved" t-if="d.moved">This booking moved to another stage. The list shows it there now.</div>

            <!-- the pane's tabs: everything about the booking without leaving the desk -->
            <nav class="fxd-tabs" aria-label="Booking parts">
                <t t-foreach="paneTabs" t-as="tab" t-key="tab.key">
                    <button class="fxd-tab" t-att-class="{ 'fxd-tab-on': state.paneTab === tab.key }" t-on-click="() => this.setTab(tab.key)">
                        <i t-attf-class="fa {{ tab.icon }}"/> <t t-esc="tab.label"/>
                    </button>
                </t>
            </nav>

            <t t-if="state.paneTab === 'booking'">
                <FixRecord screen="'bookings'" recordId="d.id" embedded="true" onChanged="() => this.onPaneChanged()"/>
            </t>
            <t t-elif="state.paneTab === 'card' and cardId">
                <div class="fxd-cards" t-if="d.job_cards.length > 1">
                    <t t-foreach="d.job_cards" t-as="card" t-key="card.id">
                        <button class="fxd-cardlink" t-att-class="{ 'fxd-cardlink-on': card.id === cardId }" t-on-click="() => state.paneCard = card.id">
                            <i class="fa fa-file-text-o"/> <t t-esc="card.name"/> <small t-esc="card.state_label"/>
                        </button>
                    </t>
                </div>
                <FixRecord screen="'job_cards'" recordId="cardId" embedded="true" onChanged="() => this.onPaneChanged()"/>
            </t>
            <t t-elif="state.paneTab === 'visit' and d.visit">
                <FixRecord screen="'visits'" recordId="d.visit.id" embedded="true" onChanged="() => this.onPaneChanged()"/>
            </t>
            <t t-elif="state.paneTab === 'notes'">
                <section class="fxd-box">
                    <h3><i class="fa fa-comments-o"/> Notes on the booking, its job cards and its visit</h3>
                    <div class="fxd-assign">
                        <textarea class="fxd-in" rows="2" placeholder="Add a note for the team (kept on the booking)…" t-model="state.noteText"/>
                        <button class="fxd-btn fxd-btn-primary fxd-btn-sm" t-att-disabled="!state.noteText.trim()" t-on-click="addNote"><i class="fa fa-plus"/> Add note</button>
                    </div>
                    <ul class="fxd-notes">
                        <t t-foreach="state.notes" t-as="note" t-key="note.screen + note.id">
                            <li>
                                <div><b t-esc="note.author"/> <small class="fxd-muted"><t t-esc="noteWhen(note)"/> · <t t-esc="note.where"/></small></div>
                                <div t-if="noteText(note)" class="fxd-note-body" t-esc="noteText(note)"/>
                                <t t-foreach="note.changes" t-as="ch" t-key="ch_index">
                                    <div class="fxd-muted"><t t-esc="ch.field"/>: <t t-esc="ch.old or '—'"/> → <b t-esc="ch.new or '—'"/></div>
                                </t>
                            </li>
                        </t>
                        <li class="fxd-muted" t-if="!state.notes.length">No notes yet.</li>
                    </ul>
                </section>
            </t>
            <t t-elif="state.paneTab === 'whatsapp'">
                <!-- exactly what the customer and the technician got, links included -->
                <section class="fxd-box">
                    <h3><i class="fa fa-whatsapp"/> WhatsApp messages of this booking</h3>
                    <p class="fxd-muted fxd-wa-hint">The same words the customer and the technician get. "Waiting" means WhatsApp is not connected: the message goes out once it is.</p>
                    <ul class="fxd-wa">
                        <t t-foreach="d.whatsapp" t-as="m" t-key="m.id">
                            <li t-attf-class="fxd-wa-msg fxd-wa-{{ m.who }}">
                                <div class="fxd-wa-to"><i t-attf-class="fa {{ m.who === 'technician' ? 'fa-wrench' : 'fa-user' }}"/> To the <t t-esc="m.who_label.toLowerCase()"/><small t-if="m.phone"> · <t t-esc="m.phone"/></small></div>
                                <div class="fxd-wa-body"><t t-foreach="waParts(m.body)" t-as="p" t-key="p_index"><a t-if="p.link" t-att-href="p.text" target="_blank" rel="noopener" t-esc="p.text"/><t t-else="" t-esc="p.text"/></t></div>
                                <div class="fxd-wa-meta">
                                    <span t-esc="when(m.at)"/>
                                    <span t-attf-class="fxd-wa-st fxd-wa-st-{{ m.status }}" t-esc="m.status_label"/>
                                </div>
                            </li>
                        </t>
                        <li class="fxd-muted" t-if="!d.whatsapp.length">No WhatsApp messages for this booking yet.</li>
                    </ul>
                </section>
            </t>

            <t t-else="">
            <!-- a part the technician asked for at the door: answer it here (Part found / Not available) -->
            <section t-if="d.ask" t-attf-class="fxd-ask fxd-ask-{{ d.ask.state }}" role="status">
                <img t-if="d.ask.photo" class="fxd-ask-photo" t-attf-src="/web/image/fix.service.visit/{{ d.ask.visit_id }}/ask_photo/160x160"
                     alt="Photo of the part" t-on-click="() => this.openMedia('image', 'fix.service.visit/' + d.ask.visit_id + '/ask_photo')"/>
                <div class="fxd-ask-text">
                    <t t-if="d.ask.state === 'asked'">
                        <b><i class="fa fa-bell"/> <t t-esc="d.technician or 'The technician'"/> is waiting at the door for a part</b>
                        <span><t t-esc="d.ask.name"/><t t-if="d.ask.price"> · about <t t-esc="money(d.ask.price, d.currency)"/></t></span>
                        <small>Asked <t t-esc="when(d.ask.on)"/>. Answer below: Part found, or Not available.</small>
                    </t>
                    <t t-elif="d.ask.state === 'found'">
                        <b><i class="fa fa-check-circle"/> Part sent to the technician</b>
                        <span><t t-esc="d.ask.part"/> · <t t-esc="money(d.ask.part_price, d.currency)"/></span>
                        <small>By <t t-esc="d.ask.by"/><t t-if="d.ask.reply"> · <t t-esc="d.ask.reply"/></t></small>
                    </t>
                    <t t-else="">
                        <b><i class="fa fa-times-circle"/> Not available: <t t-esc="d.ask.name"/></b>
                        <span t-esc="d.ask.reply"/>
                        <small>By <t t-esc="d.ask.by"/>. The technician chooses what next.</small>
                    </t>
                </div>
            </section>
            <!-- buttons of this stage -->
            <div class="fxd-actions" t-if="d.actions.length">
                <t t-foreach="d.actions" t-as="key" t-key="key">
                    <t t-set="b" t-value="button(key)"/>
                    <t t-if="key === 'assign'">
                        <div class="fxd-assign">
                            <select class="fxd-pick" t-model.number="state.techPick" aria-label="Technician">
                                <option value="0">Choose the technician…</option>
                                <!-- whoever is off on the booking's day is left out (Configuration > Days Off) -->
                                <t t-foreach="state.technicians" t-as="tech" t-key="tech.id">
                                    <option t-if="!offOn(tech, d)" t-att-value="tech.id"><t t-esc="tech.name"/><t t-if="tech.phone"> · <t t-esc="tech.phone"/></t></option>
                                </t>
                            </select>
                            <button t-attf-class="fxd-btn fxd-btn-{{ b.kind }}" t-att-disabled="state.busy" t-on-click="() => this.act('assign')">
                                <i t-attf-class="fa {{ b.icon }}"/> <t t-esc="b.label"/>
                            </button>
                        </div>
                        <p class="fxd-muted fxd-off-note" t-if="offNames(d)">Off that day: <t t-esc="offNames(d)"/></p>
                    </t>
                    <t t-elif="key === 'cancel_visit' and state.askCancel">
                        <div class="fxd-assign fxd-cancel">
                            <input class="fxd-in" type="text" placeholder="Why? (optional, kept on the visit)" t-model="state.cancelReason"/>
                            <button class="fxd-btn fxd-btn-danger" t-att-disabled="state.busy" t-on-click="() => this.act('cancel_visit')"><i class="fa fa-ban"/> Yes, cancel the visit</button>
                            <button class="fxd-btn fxd-btn-ghost" t-on-click="() => state.askCancel = false">Keep it</button>
                        </div>
                    </t>
                    <t t-elif="key === 'part_none' and state.askNone">
                        <div class="fxd-assign fxd-cancel">
                            <input class="fxd-in" type="text" placeholder="Why not? The technician reads it (e.g. no supplier for this model)" t-model="state.noneReason"/>
                            <button class="fxd-btn fxd-btn-danger" t-att-disabled="state.busy or !state.noneReason.trim()" t-on-click="() => this.act('part_none')"><i class="fa fa-times"/> Tell the technician</button>
                            <button class="fxd-btn fxd-btn-ghost" t-on-click="() => state.askNone = false">Back</button>
                        </div>
                    </t>
                    <t t-elif="key === 'finish_skip' and state.askFinish">
                        <div class="fxd-assign fxd-cancel">
                            <input class="fxd-in" type="text" placeholder="Why without the customer's code? (kept on the visit)" t-model="state.finishReason"/>
                            <button class="fxd-btn fxd-btn-primary" t-att-disabled="state.busy or !state.finishReason.trim()" t-on-click="() => this.act('finish_skip')"><i class="fa fa-flag-checkered"/> Finish the visit</button>
                            <button class="fxd-btn fxd-btn-ghost" t-on-click="() => state.askFinish = false">Back</button>
                        </div>
                    </t>
                    <button t-else="" t-attf-class="fxd-btn fxd-btn-{{ b.kind }}" t-att-disabled="state.busy" t-on-click="() => this.act(key)">
                        <i t-attf-class="fa {{ b.icon }}"/> <t t-esc="b.label"/>
                    </button>
                </t>
            </div>
            <div class="fxd-note fxd-note-red" t-if="d.needs_screen">Accepted on WhatsApp, but <t t-esc="d.needs_screen"/>.</div>
            <div class="fxd-note fxd-note-amber" t-if="d.calling_by">Calling the customer: <b t-esc="d.calling_by"/></div>
            <div class="fxd-note fxd-note-red" t-if="d.reject_reason">Rejected by <t t-esc="d.rejected_by"/>: <t t-esc="d.reject_reason"/></div>
            <!-- a device at our office -->
            <div class="fxd-note fxd-note-amber" t-if="d.office === 'on_way'">The technician is bringing the device to the office. Press <b>Received at the office</b> when it arrives and check the accessories.</div>
            <div class="fxd-note fxd-note-red" t-if="d.overdue === 'price'">Overdue: the customer was promised the price by now. Check the device and send the price.</div>
            <div class="fxd-note fxd-note-red" t-if="d.overdue === 'return'">Overdue: the customer was promised the device back by now.</div>

            <!-- every part the technician asked of the office, and the answer (kept for good) -->
            <section class="fxd-box fxd-asks" t-if="(d.ask_history or []).length">
                <h3><i class="fa fa-cogs"/> Part questions <small>(<t t-esc="d.ask_history.length"/>)</small></h3>
                <t t-set="asks" t-value="d.ask_history"/>
                <t t-set="cur" t-value="d.currency"/>
                <t t-call="369ai_fix.PartAskHistory"/>
            </section>

            <div class="fxd-grid">
                <!-- customer -->
                <section class="fxd-box">
                    <h3><i class="fa fa-user"/> Customer</h3>
                    <div class="fxd-cust-name" t-esc="d.customer or 'No name given'"/>
                    <div class="fxd-numbers">
                        <t t-foreach="d.numbers" t-as="num" t-key="num.digits">
                            <a class="fxd-tel" t-attf-href="tel:+#{num.digits}">
                                <span class="fxd-tel-badge" t-att-class="{ 'fxd-tel-alt': num.label !== 'Main' }" t-esc="num.label"/>
                                <i class="fa fa-phone"/> <t t-esc="num.number"/>
                            </a>
                        </t>
                        <span class="fxd-muted" t-if="!d.numbers.length">No phone number.</span>
                    </div>
                    <div class="fxd-addr" t-if="d.address or d.area">
                        <i class="fa fa-map-marker"/> <t t-esc="where(d)"/>
                        <a t-if="d.map_url" t-att-href="d.map_url" target="_blank" rel="noopener"> · map</a>
                    </div>
                    <div class="fxd-muted" t-if="d.email" t-esc="d.email"/>
                    <div class="fxd-slot" t-if="d.slot"><i class="fa fa-calendar"/> <b t-esc="d.slot"/><small t-if="d.slot_seen_by"> · seen by <t t-esc="d.slot_seen_by"/></small><small t-elif="d.slot_booked_on"> · booked <t t-esc="when(d.slot_booked_on)"/></small></div>
                </section>

                <!-- repairs and estimate -->
                <section class="fxd-box">
                    <h3><i class="fa fa-wrench"/> Repairs &amp; estimate</h3>
                    <ul class="fxd-lines" t-if="d.lines.length">
                        <t t-foreach="d.lines" t-as="line" t-key="line.id">
                            <li>
                                <span class="fxd-qty" t-esc="line.qty"/>
                                <span t-esc="lineLabel(line)"/>
                                <span class="fxd-price" t-if="line.price !== null" t-esc="money(line.price, d.currency)"/>
                            </li>
                        </t>
                    </ul>
                    <div class="fxd-total" t-if="d.total">Estimate <b t-esc="money(d.total, d.currency)"/><small t-if="d.bill_type === 'easy'"> incl. VAT</small><small t-if="d.approved_by"> · approved by <t t-esc="d.approved_by"/> <t t-esc="when(d.approved_on)"/></small></div>
                    <div class="fxd-muted" t-else="">No priced repair on the job card yet.</div>
                    <!-- how it is billed: with tax (Easy Sales) or without (Estimate Sale); the office's choice -->
                    <div class="fxd-bill" t-if="d.bill_type">
                        <span>Bill</span>
                        <div class="fxd-seg" role="group" aria-label="Bill with or without tax">
                            <button type="button" t-att-class="{ on: d.bill_type === 'estimate' }" t-att-aria-pressed="d.bill_type === 'estimate' ? 'true' : 'false'"
                                    t-att-disabled="d.bill_locked or state.busy" t-on-click="() => this.setBill('estimate')">Without tax</button>
                            <button type="button" t-att-class="{ on: d.bill_type === 'easy' }" t-att-aria-pressed="d.bill_type === 'easy' ? 'true' : 'false'"
                                    t-att-disabled="d.bill_locked or state.busy" t-on-click="() => this.setBill('easy')">With tax</button>
                        </div>
                        <small t-if="d.bill_locked">The bill is made: it cannot change.</small>
                        <small t-elif="d.bill_type === 'easy'">Easy Sales · the customer sees prices incl. VAT</small>
                        <small t-else="">Estimate Sale · no tax</small>
                    </div>
                    <ul class="fxd-parts" t-if="d.parts.length">
                        <t t-foreach="d.parts" t-as="part" t-key="part_index">
                            <li>
                                <span><t t-esc="part.name"/> × <t t-esc="part.qty"/></span>
                                <span t-att-class="part.missing ? 'fxd-stock-no' : 'fxd-stock-ok'">
                                    <t t-if="!part.missing"><t t-esc="part.on_hand"/> in stock</t>
                                    <t t-else="">none - order it</t>
                                </span>
                            </li>
                        </t>
                    </ul>
                    <div class="fxd-chip fxd-chip-amber" t-if="d.parts_badge"><t t-esc="d.parts_badge"/><t t-if="d.parts_days"> · about <t t-esc="d.parts_days"/> days</t></div>
                    <div class="fxd-cards" t-if="d.job_cards.length">
                        <t t-foreach="d.job_cards" t-as="card" t-key="card.id">
                            <button class="fxd-cardlink" t-on-click="() => this.openForm('job.card', card.id)">
                                <i class="fa fa-file-text-o"/> <t t-esc="card.name"/> <small t-esc="card.state_label"/>
                                <small t-if="card.technician"> · <t t-esc="card.technician"/></small>
                                <small t-if="card.at_office"> · at the office<t t-if="card.return_by">, back by <t t-esc="card.return_by"/></t></small>
                                <small t-if="card.quote"> · <t t-esc="card.quote"/></small>
                            </button>
                        </t>
                    </div>
                </section>

                <!-- Spin & Win: the prize on this booking, or one the customer still holds -->
                <section class="fxd-box" t-if="d.prize">
                    <h3><i class="fa fa-gift"/> Spin &amp; Win prize</h3>
                    <div><b t-esc="d.prize.prize"/> <span class="fxd-muted">· code <t t-esc="d.prize.code"/></span></div>
                    <div class="fxd-muted" t-if="d.prize.on_booking and d.prize.given">Given to the customer.</div>
                    <div class="fxd-muted" t-elif="d.prize.on_booking">On this booking, free on the job card. The technician marks it given.</div>
                    <div class="fxd-muted" t-else="">Not on this booking yet. The customer can use it until <t t-esc="d.prize.valid_until"/>.</div>
                </section>

                <!-- the customer's words, photos, video -->
                <section class="fxd-box" t-if="d.problem or d.note or d.photos.length or d.videos">
                    <h3><i class="fa fa-comment-o"/> Customer says</h3>
                    <blockquote class="fxd-quote" t-if="d.problem">“<t t-esc="d.problem"/>”</blockquote>
                    <div class="fxd-muted" t-if="d.note">Note: <t t-esc="d.note"/></div>
                    <div class="fxd-photos" t-if="d.photos.length or d.videos">
                        <t t-foreach="d.photos" t-as="pid" t-key="pid">
                            <a t-attf-href="/web/content/#{pid}" t-on-click.prevent="() => this.openMedia('image', pid)" title="View the photo">
                                <img t-attf-src="/web/image/#{pid}/96x96" alt="Customer photo" loading="lazy"/>
                            </a>
                        </t>
                        <t t-foreach="d.video_ids or []" t-as="vid" t-key="vid">
                            <a class="fxd-vid" t-attf-href="/web/content/#{vid}" t-on-click.prevent="() => this.openMedia('video', vid)" title="Play the customer's video">
                                <video t-attf-src="/web/content/#{vid}#t=0.1" preload="metadata" muted="muted" playsinline="playsinline"/>
                                <i class="fa fa-play"/>
                            </a>
                        </t>
                    </div>
                </section>

                <!-- WhatsApp / poll -->
                <section class="fxd-box fxd-box-slim" t-if="state.pollReady or d.poll_sent or d.poll_error_text">
                    <h3><i class="fa fa-whatsapp"/> Staff WhatsApp</h3>
                    <div t-if="d.poll_error_text" class="fxd-note fxd-note-red">Poll not sent: <t t-esc="d.poll_error_text"/></div>
                    <div t-elif="d.poll_sent" class="fxd-muted">Posted to the staff group with the poll.</div>
                    <div t-else="" class="fxd-muted">Not posted to the staff group.</div>
                </section>

                <!-- the visit -->
                <section class="fxd-box fxd-box-wide" t-if="d.visit">
                    <h3><i class="fa fa-car"/> Visit <small t-esc="d.visit.name"/> <span class="fxd-chip" t-esc="d.visit.state_label"/>
                        <span class="fxd-chip" t-if="d.visit.result_label" t-esc="d.visit.result_label"/>
                        <button class="fxd-link" t-on-click="() => this.openForm('fix.service.visit', d.visit.id)">open</button></h3>
                    <div class="fxd-tech" t-if="d.visit.technician">
                        <i class="fa fa-user-circle"/> <b t-esc="d.visit.technician"/>
                        <a t-if="d.visit.technician_phone" t-attf-href="tel:#{d.visit.technician_phone}" class="fxd-muted"> <t t-esc="d.visit.technician_phone"/></a>
                        <small class="fxd-muted" t-if="d.visit.link_sent_on"> · link sent <t t-esc="when(d.visit.link_sent_on)"/></small>
                    </div>
                    <div class="fxd-muted" t-if="d.visit.slot_start">Visit window: <t t-esc="when(d.visit.slot_start)"/> – <t t-esc="when(d.visit.slot_end)"/></div>
                    <div class="fxd-code" t-if="d.visit.arrival_code">
                        <span>Arrival code</span><b t-esc="d.visit.arrival_code"/>
                        <small>The customer reads it out at the door.</small>
                    </div>
                    <!-- after the repair: photo, payment, the customer's finish code -->
                    <div class="fxd-code" t-if="d.visit.finish_code">
                        <span>Finish code</span><b t-esc="d.visit.finish_code"/>
                        <small>The customer gives it to the technician when happy with the repair.</small>
                    </div>
                    <div class="fxd-muted" t-if="d.visit.finishing and d.visit.finish_missing.length">Still to do: <t t-esc="d.visit.finish_missing.join(', ')"/></div>
                    <div class="fxd-muted" t-if="d.visit.outcome_label">Found: <b t-esc="d.visit.outcome_label"/></div>
                    <div class="fxd-muted" t-if="d.visit.paid_text"><i class="fa fa-money"/> Paid at the door: <b t-esc="d.visit.paid_text"/></div>
                    <div class="fxd-muted" t-if="d.visit.warranty_until"><i class="fa fa-shield"/> Warranty until <t t-esc="d.visit.warranty_until"/></div>
                    <div class="fxd-muted" t-if="d.visit.rating"><i class="fa fa-star"/> Rated <b><t t-esc="d.visit.rating"/>/5</b><t t-if="d.visit.rating_note">: “<t t-esc="d.visit.rating_note"/>”</t></div>
                    <ol class="fxd-timeline" t-if="d.visit.timeline.length">
                        <t t-foreach="d.visit.timeline" t-as="step" t-key="step.key">
                            <li t-att-class="{ 'fxd-done': step.done, 'fxd-now': step.current }">
                                <span class="fxd-tl-dot"/>
                                <span class="fxd-tl-label" t-esc="step.label"/>
                                <span class="fxd-tl-at" t-esc="when(step.at)"/>
                            </li>
                        </t>
                    </ol>
                    <div class="fxd-muted" t-if="d.visit.cancel_reason">Cancelled: <t t-esc="d.visit.cancel_reason"/></div>
                    <div class="fxd-muted" t-if="d.visit.arrived_distance_m">Arrived <t t-esc="d.visit.arrived_distance_m"/> m from the customer's point.</div>

                    <!-- the live map -->
                    <t t-if="d.map">
                        <div class="fxd-map-head">
                            <span class="fxd-legend"><i class="fxd-leg fxd-leg-cust"/> customer <i class="fxd-leg fxd-leg-tech"/> technician <i class="fxd-leg fxd-leg-trail"/> trail</span>
                            <span class="fxd-chip fxd-chip-blue" t-if="mapChip" t-esc="mapChip"/>
                            <span class="fxd-chip fxd-chip-red" t-if="d.map.tech and d.map.tech.stale"><i class="fxd-stale"/> signal lost</span>
                            <span class="fxd-chip" t-elif="d.map.tech">position <t t-esc="when(d.map.tech.fix_on)"/></span>
                            <a class="fxd-link" t-if="d.visit.directions_url" t-att-href="d.visit.directions_url" target="_blank" rel="noopener">directions</a>
                        </div>
                        <div class="fxd-map" t-if="hasMap and (d.map.customer or d.map.tech)" t-ref="map"/>
                        <div class="fxd-muted" t-elif="!hasMap">The map library did not load.</div>
                        <div class="fxd-muted" t-else="">No position yet: the customer's point is unknown and the technician's phone has not reported.</div>
                    </t>
                </section>
                <section class="fxd-box fxd-box-wide fxd-box-slim" t-elif="d.mode === 'doorstep' and d.state === 'confirmed'">
                    <h3><i class="fa fa-car"/> Visit</h3>
                    <div class="fxd-muted">No visit yet. Assigning a technician creates it.</div>
                </section>

                <!-- the tool bag: when the technician left the office (that day) and this customer's place -->
                <section class="fxd-box fxd-box-wide" t-if="d.visit and d.visit.tools">
                    <h3><i class="fa fa-briefcase"/> Tool bag <small t-esc="d.visit.technician"/></h3>
                    <div class="fxd-tools">
                        <!-- the bag they set off with: the office (first trip of the day) or the last place they left -->
                        <t t-set="start" t-value="d.visit.tools.start"/>
                        <t t-call="369ai_fix.DeskToolSide">
                            <t t-set="check" t-value="start"/>
                            <t t-set="title" t-value="start and start.kind === 'house' ? 'From the last place' : 'From the office'"/>
                            <t t-set="icon" t-value="start and start.kind === 'house' ? 'fa-home' : 'fa-building'"/>
                            <t t-set="empty" t-value="'Not checked yet'"/>
                            <t t-set="showPlace" t-value="true"/>
                        </t>
                        <t t-call="369ai_fix.DeskToolSide">
                            <t t-set="check" t-value="d.visit.tools.house"/>
                            <t t-set="title" t-value="'From the service place'"/>
                            <t t-set="icon" t-value="'fa-home'"/>
                            <t t-set="empty" t-value="d.visit.state === 'done' ? 'Not checked' : 'Asked after &quot;Can it be fixed?&quot;'"/>
                            <t t-set="showPlace" t-value="false"/>
                        </t>
                    </div>
                </section>
            </div>
            </t>
        </div>
    </t>

    <!-- one side of the tool bag: status, when and who, the bag photo, each tool ✓ / ✗ -->
    <t t-name="369ai_fix.DeskToolSide">
        <div class="fxd-tside">
            <div class="fxd-tside-head">
                <i t-attf-class="fa {{ icon }}"/> <b t-esc="title"/>
                <span class="fxd-chip" t-if="!check" t-esc="empty"/>
                <span class="fxd-chip fxd-chip-amber" t-elif="check.state === 'todo'">Not done yet</span>
                <span class="fxd-chip fxd-chip-amber" t-elif="check.state === 'skipped'">Skipped</span>
                <span class="fxd-chip fxd-chip-red" t-elif="check.missing"><t t-esc="check.missing"/> missing</span>
                <span class="fxd-chip fxd-chip-ok" t-else="">All in the bag</span>
            </div>
            <t t-if="check">
                <div t-if="showPlace and check.ref"><b t-esc="check.customer or 'Customer'"/> <small class="fxd-muted">· <t t-esc="check.ref"/></small></div>
                <div class="fxd-muted" t-if="check.on">
                    <t t-esc="check.state === 'skipped' ? 'Skipped' : 'Checked'"/> <t t-esc="when(check.on)"/><t t-if="check.by"> by <t t-esc="check.by"/></t>
                </div>
                <div class="fxd-muted" t-if="check.skip_reason">Reason: <t t-esc="check.skip_reason"/></div>
                <div class="fxd-tside-body">
                    <a class="fxd-tphoto" t-if="check.photo" t-att-href="'/web/image/fix.tool.check/' + check.id + '/photo'" target="_blank" rel="noopener" title="Bag photo">
                        <img t-att-src="'/web/image/fix.tool.check/' + check.id + '/photo/160x160'" alt="Bag photo"/>
                    </a>
                    <ul class="fxd-tlist">
                        <li t-foreach="check.tools" t-as="tool" t-key="tool.id" t-attf-class="fxd-t-{{ tool.state }}">
                            <i t-attf-class="fa {{ tool.state === 'ok' ? 'fa-check' : (tool.state === 'missing' ? 'fa-times' : 'fa-circle-o') }}"/>
                            <t t-esc="tool.name"/><small t-if="tool.note"> · <t t-esc="tool.note"/></small><small t-if="tool.found"> · found</small>
                        </li>
                    </ul>
                </div>
            </t>
        </div>
    </t>

</templates>
