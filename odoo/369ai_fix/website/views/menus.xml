<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fix Website: its own home-screen app for the website's pictures (and later its content). -->
    <menuitem id="menu_fix_website_root"
              name="Fix Website"
              web_icon="369ai_fix,static/description/fix_website_icon.png"
              groups="group_fix_website_editor"
              sequence="26"/>

    <menuitem id="menu_fix_website_details" name="Website Details" parent="menu_fix_website_root"
              action="action_website_details" sequence="1"/>

    <menuitem id="menu_fix_home_pages" name="Home Page" parent="menu_fix_website_root"
              action="action_fix_home_pages" sequence="2"/>

    <menuitem id="menu_fix_website_pictures" name="Pictures" parent="menu_fix_website_root" sequence="10"/>
    <menuitem id="menu_fix_device_pictures" name="Device Pictures" parent="menu_fix_website_pictures"
              action="action_device_pictures_client" sequence="1"/>
    <menuitem id="menu_fix_brand_logos" name="Brand Logos" parent="menu_fix_website_pictures"
              action="action_brand_logos" sequence="2"/>
    <menuitem id="menu_fix_service_pictures" name="Service Pictures" parent="menu_fix_website_pictures"
              action="action_service_pictures" sequence="3"/>
</odoo>
