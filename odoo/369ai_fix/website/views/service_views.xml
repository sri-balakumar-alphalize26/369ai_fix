<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Service Pictures: each repair service's photo gallery ===== -->
    <record id="view_service_pictures_list" model="ir.ui.view">
        <field name="name">product.template.service.pictures.list</field>
        <field name="model">product.template</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Service Pictures" create="0">
                <field name="web_photo_preview" widget="image" options="{'size': [0, 48]}" string="Photo"/>
                <field name="name"/>
                <field name="repair_category_ids" widget="many2many_tags"/>
                <field name="web_photo_count"/>
            </list>
        </field>
    </record>

    <record id="view_service_pictures_form" model="ir.ui.view">
        <field name="name">product.template.service.pictures.form</field>
        <field name="model">product.template</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Service Pictures" create="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <field name="repair_category_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                    <p class="text-muted">
                        Keep a few photos here and press "Show on website" on the one the website should use.
                        Without a choice the website uses the first photo.
                    </p>
                    <field name="web_photo_ids" mode="kanban"
                           context="{'default_product_tmpl_id': id, 'default_name': name, 'kanban_view_ref': '369ai_fix.view_fix_web_image_kanban', 'form_view_ref': '369ai_fix.view_fix_web_image_form'}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_service_pictures_search" model="ir.ui.view">
        <field name="name">product.template.service.pictures.search</field>
        <field name="model">product.template</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="repair_category_ids"/>
                <filter name="no_photo" string="Missing picture" domain="[('web_photo_count', '=', 0)]"/>
                <filter name="few_photos" string="Fewer than 3 photos" domain="[('web_photo_count', '&lt;', 3)]"/>
            </search>
        </field>
    </record>

    <record id="action_service_pictures" model="ir.actions.act_window">
        <field name="name">Service Pictures</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('repair_category_ids', '!=', False)]</field>
        <field name="search_view_id" ref="view_service_pictures_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_service_pictures_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_service_pictures_form')})]"/>
    </record>
</odoo>
