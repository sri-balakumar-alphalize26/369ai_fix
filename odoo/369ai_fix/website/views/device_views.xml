<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Device Pictures: each device type's photo gallery ===== -->
    <record id="view_device_category_pictures_list" model="ir.ui.view">
        <field name="name">device.category.pictures.list</field>
        <field name="model">device.category</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Device Pictures" create="0">
                <field name="web_look" string="Website shows" widget="badge"
                       decoration-info="web_look == 'drawing'" decoration-success="web_look == 'photo'"/>
                <field name="web_drawing" widget="image" options="{'size': [0, 48]}" string="Drawing"/>
                <field name="web_photo_preview" widget="image" options="{'size': [0, 48]}" string="Photo"/>
                <field name="name"/>
                <field name="web_photo_count"/>
            </list>
        </field>
    </record>

    <record id="view_device_category_pictures_form" model="ir.ui.view">
        <field name="name">device.category.pictures.form</field>
        <field name="model">device.category</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <form string="Device Pictures" create="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <p class="text-muted">
                        The website shows this device type as its drawing, or as the photo marked
                        "On website", depending on the toggle in Website Details. Both stay saved.
                    </p>
                    <div class="mb-2">Website shows now: <field name="web_look" widget="badge" class="ms-1"
                         decoration-info="web_look == 'drawing'" decoration-success="web_look == 'photo'"/>
                        <span class="text-muted ms-2">(switch it at the top of Device Pictures)</span></div>
                    <separator string="Drawings (5 styles; Device Pictures chooses which style the website uses)"/>
                    <div class="d-flex flex-wrap gap-4 mb-3">
                        <div class="text-center"><field name="web_drawing" widget="image" options="{'size': [0, 120]}"/><div class="small text-muted">3D</div></div>
                        <div class="text-center"><field name="web_drawing_line" widget="image" options="{'size': [0, 120]}"/><div class="small text-muted">Line</div></div>
                        <div class="text-center"><field name="web_drawing_flat" widget="image" options="{'size': [0, 120]}"/><div class="small text-muted">Flat</div></div>
                        <div class="text-center"><field name="web_drawing_sketch" widget="image" options="{'size': [0, 120]}"/><div class="small text-muted">Sketch</div></div>
                        <div class="text-center"><field name="web_drawing_duotone" widget="image" options="{'size': [0, 120]}"/><div class="small text-muted">Duotone</div></div>
                    </div>
                    <separator string="Photos"/>
                    <field name="web_photo_ids" mode="kanban"
                           context="{'default_category_id': id, 'default_name': name, 'kanban_view_ref': '369ai_fix.view_fix_web_image_kanban', 'form_view_ref': '369ai_fix.view_fix_web_image_form'}"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_device_category_pictures_search" model="ir.ui.view">
        <field name="name">device.category.pictures.search</field>
        <field name="model">device.category</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="no_photo" string="Missing picture" domain="[('web_photo_count', '=', 0)]"/>
                <filter name="no_drawing" string="Missing drawing" domain="[('web_has_drawing', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_device_pictures" model="ir.actions.act_window">
        <field name="name">Device Pictures</field>
        <field name="res_model">device.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_device_category_pictures_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_device_category_pictures_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_device_category_pictures_form')})]"/>
    </record>

    <!-- ===== Brand Logos ===== -->
    <record id="view_device_brand_logos_list" model="ir.ui.view">
        <field name="name">device.brand.logos.list</field>
        <field name="model">device.brand</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Brand Logos" create="0" editable="bottom">
                <field name="web_logo" widget="image" options="{'size': [0, 40]}"/>
                <field name="name" readonly="1"/>
                <field name="category_id" readonly="1"/>
                <field name="web_color" widget="color"/>
                <field name="web_has_logo" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_device_brand_logos_search" model="ir.ui.view">
        <field name="name">device.brand.logos.search</field>
        <field name="model">device.brand</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <filter name="no_logo" string="Missing logo" domain="[('web_has_logo', '=', False)]"/>
                <group>
                    <filter name="by_category" string="Device type" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_brand_logos" model="ir.actions.act_window">
        <field name="name">Brand Logos</field>
        <field name="res_model">device.brand</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_device_brand_logos_search"/>
        <field name="context">{}</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('view_device_brand_logos_list')})]"/>
    </record>
</odoo>
