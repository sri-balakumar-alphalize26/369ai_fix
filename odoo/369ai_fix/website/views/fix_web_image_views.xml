<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- One picture, opened from a gallery (or "Add a line" to upload your own). -->
    <record id="view_fix_web_image_form" model="ir.ui.view">
        <field name="name">fix.web.image.form</field>
        <field name="model">fix.web.image</field>
        <field name="arch" type="xml">
            <form string="Website picture">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_512'}"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="is_shown" widget="boolean_toggle"/>
                            <field name="category_id" readonly="1" invisible="not category_id"/>
                            <field name="product_tmpl_id" readonly="1" invisible="not product_tmpl_id"/>
                        </group>
                        <group>
                            <field name="source"/>
                            <field name="credit" invisible="source != 'free'"/>
                            <field name="license" invisible="source != 'free'"/>
                            <field name="source_url" widget="url" invisible="source != 'free'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- The gallery: picture cards with "Show on website"; the shown one carries a green badge. -->
    <record id="view_fix_web_image_kanban" model="ir.ui.view">
        <field name="name">fix.web.image.kanban</field>
        <field name="model">fix.web.image</field>
        <field name="arch" type="xml">
            <kanban class="o_fix_gallery">
                <field name="is_shown"/>
                <templates>
                    <t t-name="card" class="p-0">
                        <field name="image_256" widget="image" class="w-100 text-center" options="{'size': [0, 150]}"/>
                        <div class="p-2 d-flex flex-column gap-1">
                            <field name="name" class="fw-bold text-truncate"/>
                            <span class="badge text-bg-success align-self-start" invisible="not is_shown">On website</span>
                            <button name="action_show" type="object" string="Show on website"
                                    class="btn btn-sm btn-outline-primary align-self-start" invisible="is_shown"/>
                            <field name="source" class="small text-muted"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
</odoo>
