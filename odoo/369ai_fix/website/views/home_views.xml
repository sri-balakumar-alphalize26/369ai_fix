<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===== Home pages: the everyday page and dated ones ===== -->
    <record id="view_fix_home_page_list" model="ir.ui.view">
        <field name="name">fix.home.page.list</field>
        <field name="model">fix.home.page</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'live'" decoration-info="state == 'scheduled'" decoration-muted="state in ('off', 'ended')">
                <field name="name"/>
                <field name="site_id" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="state_note"/>
                <field name="starts_on" optional="show"/>
                <field name="ends_on" optional="show"/>
                <field name="section_count" string="Sections"/>
                <field name="is_current" widget="boolean_toggle" string="Everyday"/>
            </list>
        </field>
    </record>

    <record id="view_fix_home_page_form" model="ir.ui.view">
        <field name="name">fix.home.page.form</field>
        <field name="model">fix.home.page</field>
        <field name="arch" type="xml">
            <form string="Home page">
                <header>
                    <button name="action_make_current" type="object" string="Make this the everyday page" class="btn-primary" icon="fa-home" invisible="is_current"/>
                    <button name="action_duplicate" type="object" string="Duplicate" icon="fa-copy"/>
                    <button name="action_open_website" type="object" string="Open the website" icon="fa-external-link"/>
                    <field name="state" widget="statusbar" statusbar_visible="live,scheduled,off,ended"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Live now" bg_color="text-bg-success" invisible="state != 'live'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Everyday page, Eid offer"/></h1>
                        <field name="note" placeholder="A reminder for staff (not shown on the site)"/>
                    </div>
                    <group>
                        <group string="When the website shows it">
                            <field name="is_current" help="Shown whenever no dated page is running. Only one per website."/>
                            <field name="starts_on"/>
                            <field name="ends_on"/>
                            <field name="state_note" readonly="1"/>
                        </group>
                        <group string="Website">
                            <field name="site_id" options="{'no_create': true}"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sections, top to bottom" name="sections">
                            <div class="text-muted small mb-2">The way the visitor scrolls. Drag a row to move that section; switch it off to hide it without deleting anything. Open a row to edit its wording, pictures and lines.</div>
                            <field name="section_ids" nolabel="1" context="{'default_page_id': id}">
                                <list default_order="sequence" decoration-muted="not active">
                                    <field name="sequence" widget="handle"/>
                                    <field name="kind"/>
                                    <field name="title"/>
                                    <field name="title2" optional="hide"/>
                                    <field name="active" widget="boolean_toggle"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fix_home_pages" model="ir.actions.act_window">
        <field name="name">Home page</field>
        <field name="res_model">fix.home.page</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No home page yet</p>
            <p>Press <b>Load starter content</b> on the Website record to create the everyday page from what the site shows today, or make a new page here.</p>
        </field>
    </record>

    <!-- ===== Sections ===== -->
    <record id="view_fix_home_section_form" model="ir.ui.view">
        <field name="name">fix.home.section.form</field>
        <field name="model">fix.home.section</field>
        <field name="arch" type="xml">
            <form string="Section">
                <header>
                    <button name="action_toggle_active" type="object" string="Show on the website" class="btn-primary" icon="fa-toggle-off" invisible="active"/>
                    <button name="action_toggle_active" type="object" string="Hide from the website" class="btn-secondary" icon="fa-toggle-on" invisible="not active"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Hidden" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="kind" widget="radio"/>
                        </group>
                        <group>
                            <field name="page_id" readonly="1"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                            <field name="line_label" invisible="1"/>
                            <field name="line_name_label" invisible="1"/>
                            <field name="line_text_label" invisible="1"/>
                        </group>
                    </group>
                    <group string="Wording">
                        <group>
                            <field name="badge" invisible="kind != 'services'" placeholder="e.g. 7 services · doorstep &amp; pickup"/>
                            <field name="eyebrow" placeholder="e.g. Doorstep electronics repair · Oman"/>
                            <field name="title" placeholder="e.g. Your Technology."/>
                            <field name="title2" placeholder="e.g. Fixed Right." invisible="kind in ('services', 'reviews', 'milestones')"/>
                            <field name="subtitle" placeholder="e.g. Phone • Laptop • Computer • Printer • CCTV" invisible="kind in ('brands', 'milestones', 'cta')"/>
                        </group>
                        <group>
                            <field name="text" placeholder="A short paragraph, if the section has one" invisible="kind in ('hero', 'modes', 'brands', 'milestones')"/>
                            <field name="button1" placeholder="e.g. Book Your Slot" invisible="kind not in ('hero', 'cta', 'services', 'modes')"/>
                            <field name="button1_link" placeholder="/services#catalog" invisible="kind not in ('hero', 'cta', 'services', 'modes')"/>
                            <field name="button2" placeholder="e.g. WhatsApp us" invisible="kind != 'hero'"/>
                            <field name="button2_link" placeholder="Empty = WhatsApp" invisible="kind != 'hero'"/>
                        </group>
                    </group>
                    <group string="Background video and picture" invisible="kind != 'hero'">
                        <group>
                            <field name="video_url" placeholder="/media/kling.mp4"/>
                        </group>
                        <group>
                            <field name="image_1920" widget="image" options="{'size': [0, 120]}" string="Still picture"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="kind != 'services'">
                        The device tiles are the device types ticked <b>Show on home</b> (Catalogue ▸ Device Categories).
                        "Most booked" are the repair services ticked <b>Most booked</b> (Catalogue ▸ Repair Services), in their "Home order".
                    </div>
                    <div class="alert alert-info" role="alert" invisible="kind != 'modes'">
                        One repair flow, also shown on the <b>Services page</b> (even if this section is hidden here). The technician always comes first.
                        <b>Line 1</b> is the visit: title, arrival time and steps; its <b>last step</b> is the "fixed on the spot" branch.
                        <b>Line 2</b> is the other branch, when it needs a part or more work: title, a short note (e.g. "Price confirmed with you first"), the time and its steps.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="kind != 'brands'">
                        The logos are the brands ticked <b>In the brands strip</b> (Fix Website ▸ Pictures ▸ Brand Logos).
                    </div>
                    <group string="Lines, in order - drag to rearrange" invisible="kind in ('services', 'brands')">
                        <field name="line_ids" nolabel="1" colspan="2" context="{'default_section_id': id}">
                            <list editable="bottom" default_order="sequence" decoration-muted="not active">
                                <field name="sequence" widget="handle"/>
                                <field name="kind" column_invisible="1"/>
                                <field name="image_128" widget="image" options="{'size': [40, 40]}" column_invisible="parent.kind != 'partners'" string="Logo"/>
                                <field name="value" column_invisible="parent.kind not in ('hero', 'modes', 'reviews', 'milestones')" string="Number / year / arrival / area"/>
                                <field name="name" string="Name / title / label"/>
                                <field name="extra" column_invisible="parent.kind not in ('modes', 'reviews')" string="Short line / service"/>
                                <field name="stars" column_invisible="parent.kind != 'reviews'"/>
                                <field name="text" column_invisible="parent.kind not in ('modes', 'reviews', 'milestones')" string="Text / steps"/>
                                <field name="link" column_invisible="parent.kind != 'partners'"/>
                                <field name="active" widget="boolean_toggle"/>
                            </list>
                        </field>
                        <div colspan="2" class="text-muted small">
                            Top banner: counters (number + label). How we fix it: line 1 = the visit (last step = fixed on the spot), line 2 = when it needs a part or more work; steps one per line.
                            Reviews: customer, area, service, stars and the review. Our journey: year, title, text. Partners: logo and name. Closing banner: trust points.
                        </div>
                    </group>
                    <separator string="How it looks on the website"/>
                    <field name="preview_html" nolabel="1" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fix_home_section_list" model="ir.ui.view">
        <field name="name">fix.home.section.list</field>
        <field name="model">fix.home.section</field>
        <field name="arch" type="xml">
            <list default_order="sequence" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="page_id"/>
                <field name="kind"/>
                <field name="title"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
</odoo>
