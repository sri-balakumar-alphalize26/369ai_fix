</Base>

<script>
  import { price, site } from '../data/site';
  import { checkPhone, bindPhone, limitPhone, dialFor } from '../lib/phone';
  import { areaGeo, branchGeo, km } from '../lib/areaGeo';

  type Svc = { id: number | null; name: string; price: number | null; b: number | null; s: number | null; m: number | null };
  type Cat = {
    id: string; odooId: number | null; name: string; onsiteOnly: boolean; issues: string[]; services: Svc[];
    brands: { id: string; odooId: number | null; name: string; models: string[] }[];
  };
  type Data = {
    odoo: boolean;
    categories: Cat[];
    coverage: Record<string, { eta: string; zones: { name: string; areas: string[] }[] }>;
  };
  const data: Data = JSON.parse(document.getElementById('svc-data')!.textContent!);
  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s)!;
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll<T>(s)];
  const titles: Record<string, string> = { doorstep: 'Doorstep Service', pickup: 'Pickup & Service' };
  const norm = (s: string) => s.toLowerCase().replace(/\s+/g, ' ').trim();
  const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]!);

  const areaSearch = $<HTMLInputElement>('[data-area-search]');
  // booking details live in the wizard's last step
  const wzArea = $<HTMLInputElement>('[data-wz-area]');
  let wzAt: [number, number] | null = null; // set by "Use my location" — sent as a map link

  let mode = 'doorstep';

  // ---------- service mode + coverage ----------
  // Areas the chosen service covers (for suggestions and the "we serve here" check)
  let listed: { a: string; z: string }[] = [];
  const fillAreas = () => {
    listed = data.coverage[mode].zones.flatMap((z) => z.areas.map((a) => ({ a, z: z.name.replace(/ \(.*\)/, '') })));
    if (typeof areaStatus === 'function') areaStatus();
  };

  const filterAreas = () => {
    const q = norm(areaSearch.value);
    const panel = $(`[data-zones="${mode}"]`);
    let hits = 0;
    $$<HTMLButtonElement>('.area', panel).forEach((b) => {
      const match = !!q && norm(b.dataset.area!).includes(q);
      b.classList.toggle('hit', match);
      b.classList.toggle('dim', !!q && !match);
      if (match) hits++;
    });
    const out = $('[data-cov-result]');
    if (!q) out.textContent = '';
    else if (hits) out.innerHTML = `<b>Yes</b> — ${titles[mode]} reaches ${hits === 1 ? 'this area' : hits + ' matching areas'}.`;
    else {
      const other = mode === 'doorstep' ? 'pickup' : 'doorstep';
      const inOther = data.coverage[other].zones.some((z) => z.areas.some((a) => norm(a).includes(q)));
      out.innerHTML = inOther
        ? `Not on the ${titles[mode]} list, but <button type="button" class="linkish" data-switch="${other}">${titles[other]}</button> covers it.`
        : 'Not listed yet — book anyway and we will confirm.';
    }
  };

  // Branch tabs inside each mode's coverage
  const setZone = (box: HTMLElement, k: string) => {
    box.querySelectorAll<HTMLElement>('[data-ztab]').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.ztab === k)));
    box.querySelectorAll<HTMLElement>('[data-zpanel]').forEach((p) => (p.hidden = p.dataset.zpanel !== k));
    box.querySelectorAll<HTMLElement>('[data-zmap]').forEach((p) => (p.hidden = p.dataset.zmap !== k));
  };
  $$('[data-zones]').forEach((box) => box.querySelectorAll<HTMLElement>('[data-ztab]').forEach((t) => t.addEventListener('click', () => setZone(box, t.dataset.ztab!))));
  areaSearch.addEventListener('input', () => {
    const box = $(`[data-zones="${mode}"]`);
    const hit = box.querySelector<HTMLElement>('.area.hit');
    if (hit) setZone(box, hit.closest<HTMLElement>('[data-zpanel]')!.dataset.zpanel!);
  });

  const setMode = (m: string) => {
    if (!data.coverage[m]) return;
    // CCTV and networking are installed on-site: they can only be doorstep.
    if (m === 'pickup' && wzCat()?.onsiteOnly) m = 'doorstep';
    mode = m;
    $$('[data-mode]').forEach((c) => {
      c.setAttribute('aria-checked', String(c.dataset.mode === m));
      const ch = c.querySelector('[data-choose]');
      if (ch) ch.textContent = c.dataset.mode === m ? 'Selected' : 'Choose';
    });
    $$('[data-zones]').forEach((z) => (z.hidden = z.dataset.zones !== m));
    $('[data-cov-title]').textContent = titles[m];
    $('[data-cov-eta]').textContent = data.coverage[m].eta;
    paintWzMode();
    fillAreas();
    filterAreas();
  };

  $$('[data-mode]').forEach((c) => c.addEventListener('click', () => setMode(c.dataset.mode!)));
  areaSearch.addEventListener('input', filterAreas);
  $('[data-cov-result]').addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-switch]');
    if (b) setMode(b.dataset.switch!);
  });
  $$<HTMLButtonElement>('.area').forEach((b) => b.addEventListener('click', () => {
    wzArea.value = b.dataset.area!; wzAt = null;
    areaStatus(); wzProgress();
    $$('.area').forEach((x) => x.classList.toggle('picked', x === b));
  }));



  // ---------- booking wizard: 1 device → 2 model → 3 repairs (Add) → 4 cart → 5 book ----------
  // Urban Company style: repairs go straight into the site cart (CartDrawer's window.danatCart),
  // one device after another; the Book step sends everything in the cart as one booking.
  const wz = $('[data-wz]');
  const wzState = { step: 1, cat: '', brand: '', model: '', modelId: 0, seriesId: 0 };
  let wzReady = false;   // true once a saved booking-in-progress has been put back (restoreWz); saving waits for it
  let fixFor = '';       // cart line (id) whose model is being chosen from the Cart step
  let bookedRef = '';    // set once the booking is made (the cart empties; the Book step shows the done note)
  const LAST = 5;   // 1 device · 2 model · 3 repairs · 4 cart · 5 book
  const tel = site.phone.tel.replace('+', '');
  const waUrl = (m: string) => `https://wa.me/${tel}?text=${encodeURIComponent(m)}`;
  const wzCat = () => data.categories.find((c) => c.id === wzState.cat);
  const wzSearch = $<HTMLInputElement>('[data-model-search]', wz);
  // The wizard has no Doorstep/Pickup choice (the technician comes first, the lab if needed);
  // on-site-only services (CCTV, networking) don't go to the lab, so that line is hidden for them.
  function paintWzMode() {
    const items = cartItems();
    $('[data-wz-labline]', wz).hidden = items.length ? items.every((it) => !!catFor(it)?.onsiteOnly) : !!wzCat()?.onsiteOnly;
  }

  // ---------- the cart (shared with the header bag) ----------
  type CartItem = { id: string; device: string; model: string; issues: string[]; qty?: Record<string, number>;
    cat?: string; brand?: string; ids?: { category_id?: number; brand_id?: number; series_id?: number; model_id?: number };
    pid?: Record<string, number>; px?: Record<string, number> };
  const cartApi = () => (window as any).danatCart;
  const cartItems = (): CartItem[] => cartApi()?.items() ?? [];
  const cartCount = (): number => cartApi()?.count() ?? 0;
  const qtyIn = (it: CartItem, s: string) => it.qty?.[s] ?? 1;
  /** The device being booked right now, as the cart keys it (category name + "Brand Model"). */
  const curDev = () => {
    const c = wzCat()!;
    return {
      device: c.name, model: [brandName(), wzState.model].filter(Boolean).join(' '), cat: c.id, brand: wzState.brand,
      ids: { category_id: c.odooId || undefined, brand_id: brandOdooId() || undefined, series_id: wzState.seriesId || undefined, model_id: wzState.modelId || undefined },
    };
  };
  // Lines added on Home or Our Services carry only names: find their category and repair here.
  const catFor = (it: CartItem) => {
    const d = norm(it.device);
    return data.categories.find((c) => c.id === it.cat)
      ?? data.categories.find((c) => norm(c.name) === d)
      ?? data.categories.find((c) => norm(c.name).startsWith(d.split(' ')[0].replace(/s$/, '')));
  };
  const svcFor = (it: CartItem, issue: string) => {
    const all = catFor(it)?.services.filter((s) => s.name === issue) ?? [];
    return all.find((s) => !s.b && !s.s && !s.m) ?? all[0];
  };
  const pidOf = (it: CartItem, issue: string) => it.pid?.[issue] || svcFor(it, issue)?.id || undefined;
  const pxOf = (it: CartItem, issue: string): number | null => it.px?.[issue] ?? (data.odoo ? svcFor(it, issue)?.price ?? null : null);
  const r3 = (n: number) => Math.round(n * 1000) / 1000;
  const cartTotal = () => {
    let sum = 0, known = false;
    cartItems().forEach((it) => it.issues.forEach((s) => { const p = pxOf(it, s); if (p !== null) { known = true; sum += p * qtyIn(it, s); } }));
    return known ? `from ${price(r3(sum))}` : price();
  };
  const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
  const cartSummary = () => `${plural(cartCount(), 'repair')} · ${plural(cartItems().length, 'device')}`;
  const devTitle = (it: CartItem) => it.model || 'Model not chosen';

  const canNext = () => (wzState.step === 1 ? !!wzState.cat : wzState.step === 2 ? true : cartCount() > 0);
  const wzGo = (n: number) => {
    if (bookedRef && n < LAST) {   // after a booking: a fresh one starts
      bookedRef = '';
      $('[data-acc-done]', wz).hidden = true;
      $('[data-acc-upmsg]', wz).hidden = true;
    }
    if (n > 1 && n < 4 && !wzState.cat) n = 1;
    if (n >= 4 && !cartCount() && !bookedRef) n = wzState.cat ? 3 : 1;
    if (n !== 2) fixFor = '';
    wzState.step = n;
    $$('[data-wz-panel]', wz).forEach((p) => { const on = p.dataset.wzPanel === String(n); p.hidden = !on; p.classList.toggle('on', on); });
    $$('[data-wz-dot]', wz).forEach((d) => { const k = Number(d.dataset.wzDot); d.classList.toggle('on', k === n); d.classList.toggle('done', k < n); });
    $('[data-wz-fill]', wz).style.width = `${((n - 1) / (LAST - 1)) * 100}%`;
    $('[data-wz-back]', wz).hidden = n === 1 || !!bookedRef;
    $('[data-wz-next]', wz).hidden = n === LAST;
    const c = wzCat();
    $('[data-wz-crumb]', wz).textContent = n >= 4 ? (bookedRef ? '' : cartSummary())
      : [c?.name, wz.querySelector<HTMLElement>(`[data-wz-brand="${wzState.brand}"]`)?.dataset.name, wzState.model].filter(Boolean).join(' › ');
    if (n === 3) paintIssues();
    if (n === 4) { renderCart(); paintCoupon(); }
    if (n === LAST && !bookedRef) renderEstimate();
    paintCart();
    if (wz.getBoundingClientRect().top < 0) wz.scrollIntoView({ behavior: 'smooth', block: 'start' });
    saveWz();
  };

  // step 1
  const setWzCat = (id: string) => {
    if (wzState.cat !== id) { wzState.brand = ''; wzState.model = ''; wzState.modelId = 0; wzState.seriesId = 0; }
    wzState.cat = id;
    $$('[data-wz-cat]', wz).forEach((b) => b.classList.toggle('on', b.dataset.wzCat === id));
    const c = wzCat()!;
    $('[data-wz-catname]', wz).textContent = c.name.replace(/s( &.*)?$/, '').replace(/ Installation$/, ' system').toLowerCase();
    $$('[data-wz-brand]', wz).forEach((b) => { b.hidden = b.dataset.wzBrandCat !== id; b.classList.toggle('on', b.dataset.wzBrand === wzState.brand); });
    $$('[data-wz-issues]', wz).forEach((g) => (g.hidden = g.dataset.wzIssues !== id));
    wzSearch.value = '';
    showWzModels();
    showIssues();
    if (c.onsiteOnly && mode === 'pickup') setMode('doorstep'); else paintWzMode();
  };
  // Repairs for one brand / series / model only show once that device is chosen.
  const brandOdooId = () => wzCat()?.brands.find((b) => b.id === wzState.brand)?.odooId || 0;
  function showIssues() {
    const g = wz.querySelector<HTMLElement>(`[data-wz-issues="${wzState.cat}"]`);
    if (!g) return;
    const fits = (v: string | undefined, have: number) => !v || (have > 0 && Number(v) === have);
    g.querySelectorAll<HTMLElement>('.wz-iss').forEach((b) => {
      b.hidden = !(fits(b.dataset.b, brandOdooId()) && fits(b.dataset.s, wzState.seriesId) && fits(b.dataset.m, wzState.modelId));
    });
    paintIssues();
  }
  $$('[data-wz-cat]', wz).forEach((b) => b.addEventListener('click', () => { setWzCat(b.dataset.wzCat!); wzGo(2); }));

  // step 2
  const showWzModels = () => {
    const q = norm(wzSearch.value);
    let n = 0;
    $$<HTMLElement>('.wz-model', wz).forEach((m) => {
      const ok = m.dataset.modelCat === wzState.cat && (q ? m.dataset.q!.includes(q) : !!wzState.brand && m.dataset.modelBrand === wzState.brand);
      m.parentElement!.hidden = !ok;
      m.classList.toggle('on', ok && m.dataset.model === wzState.model);
      if (ok) n++;
    });
    wz.querySelector('.wz-models')!.classList.toggle('empty', !q && !wzState.brand);
    $('[data-wz-mhint]', wz).textContent = q ? (n ? `${n} match${n === 1 ? '' : 'es'}` : 'No match — type your model below, or skip.') : wzState.brand ? `${n} models` : 'Pick a brand to see its models.';
    $('[data-wz-typed-box]', wz).hidden = !(data.odoo && wzState.brand);
  };
  // A model was chosen (or skipped): on to its repairs - or, when it was for a cart line
  // added without a model, that line takes this device and we go back to the cart.
  const modelDone = () => {
    showWzModels(); showIssues();
    if (fixFor) {
      if (wzState.model || wzState.brand) cartApi()?.retarget(fixFor, curDev());
      wzGo(4); return;
    }
    wzGo(3);
  };
  // Model not in Odoo's list: the customer types it; the job card gets it as text.
  const typedIn = $<HTMLInputElement>('[data-wz-typed]', wz);
  $('[data-wz-typed-go]', wz).addEventListener('click', () => {
    const v = typedIn.value.trim();
    if (v.length < 2) { typedIn.focus(); return; }
    wzState.model = v; wzState.modelId = 0; wzState.seriesId = 0;
    modelDone();
  });
  $$('[data-wz-brand]', wz).forEach((b) => b.addEventListener('click', () => {
    wzState.brand = b.dataset.wzBrand!; wzState.model = ''; wzState.modelId = 0; wzState.seriesId = 0;
    wz.style.setProperty('--mh', b.style.getPropertyValue('--h')); // model panel takes the brand's colour
    $$('[data-wz-brand]', wz).forEach((x) => x.classList.toggle('on', x === b));
    wzSearch.value = '';
    showWzModels(); showIssues(); wzGo(2);
  }));
  wzSearch.addEventListener('input', showWzModels);
  $$('.wz-model', wz).forEach((m) => m.addEventListener('click', () => {
    wzState.model = m.dataset.model!; wzState.brand = m.dataset.modelBrand!;
    wzState.modelId = Number(m.dataset.modelId) || 0; wzState.seriesId = Number(m.dataset.seriesId) || 0;
    $$('[data-wz-brand]', wz).forEach((x) => x.classList.toggle('on', x.dataset.wzBrand === wzState.brand));
    modelDone();
  }));
  $('[data-wz-skip]', wz).addEventListener('click', () => {
    if (fixFor) { wzGo(4); return; }   // still don't know it: back to the cart unchanged
    wzState.model = ''; wzState.modelId = 0; wzState.seriesId = 0; modelDone();
  });

  // step 3 · Add / − n + on each repair, straight into the cart for this device
  function paintIssues() {
    if (!wzState.cat || !cartApi()) return;
    const dev = curDev();
    wz.querySelectorAll<HTMLElement>(`[data-wz-issues="${wzState.cat}"] .wz-iss`).forEach((row) => {
      const n = cartApi().qty(dev, row.dataset.iss!);
      row.classList.toggle('in', n > 0);
      row.querySelector<HTMLElement>('[data-iss-add]')!.hidden = n > 0;
      row.querySelector<HTMLElement>('.wz-qty')!.hidden = !n;
      row.querySelector('.wz-qty output')!.textContent = String(n || 1);
    });
  }
  $$<HTMLElement>('.wz-iss', wz).forEach((row) => row.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest('button');
    if (!t || !cartApi()) return;
    const dev = curDev(), name = row.dataset.iss!;
    const n = cartApi().qty(dev, name) + (t.matches('[data-iss-dec]') ? -1 : 1);
    cartApi().set(dev, name, n, { pid: Number(row.dataset.pid) || undefined, px: row.dataset.price ? Number(row.dataset.price) : null });
  }));

  // ---------- live cart: side card (wide screens), bottom bar (phones), step buttons ----------
  const cbar = $('[data-wz-cbar]', wz);
  let wzSeen = false;   // the bar only rides along while the wizard is on screen
  new IntersectionObserver(([en]) => { wzSeen = en.isIntersecting; paintCart(); }, { rootMargin: '0px 0px -120px 0px' }).observe(wz);
  function paintCart() {
    const n = cartCount(), side = wzState.step <= 3;
    $('[data-wz-body]', wz).classList.toggle('full', !side);
    $('[data-wz-side]', wz).hidden = !side;
    $('[data-wz-scn]', wz).textContent = plural(n, 'item');
    $('[data-wz-sce]', wz).hidden = !!n;
    $('[data-wz-sct]', wz).hidden = !n;
    $$('[data-wz-viewcart]', wz).forEach((b) => (b.hidden = !n));
    $('[data-wz-scl]', wz).innerHTML = cartItems().flatMap((it) => it.issues.map((s) => {
      const p = pxOf(it, s), q = qtyIn(it, s);
      return `<li><span><b>${esc(s)}${q > 1 ? ` ×${q}` : ''}</b><small>${esc(devTitle(it))}</small></span><span>${p === null ? price() : price(r3(p * q))}</span></li>`;
    })).join('');
    $('[data-wz-sctp]', wz).textContent = cartTotal();
    cbar.hidden = !(side && n && wzSeen);
    document.documentElement.classList.toggle('wz-cbar-on', !cbar.hidden);
    $('[data-wz-cbn]', wz).textContent = String(n);
    $('[data-wz-cbt]', wz).textContent = cartSummary();
    $('[data-wz-cbp]', wz).textContent = cartTotal();
    const next = $<HTMLButtonElement>('[data-wz-next]', wz);
    next.disabled = !canNext();
    next.textContent = wzState.step === 2 && !wzState.model ? (fixFor ? 'Back to cart →' : 'Skip model →')
      : wzState.step === 3 ? (n ? `View cart (${n}) →` : 'Add a repair to continue')
      : wzState.step === 4 ? 'Continue to book →' : 'Continue →';
  }
  $$('[data-wz-viewcart]', wz).forEach((b) => b.addEventListener('click', () => wzGo(4)));
  // the cart changed (here, in the header bag, or in another tab)
  window.addEventListener('danat-cart', () => {
    paintIssues(); paintCart(); paintWzMode();
    if (bookedRef) return;
    if (wzState.step === 4) { if (cartCount()) renderCart(); else wzGo(1); }
    if (wzState.step === LAST) { if (cartCount()) renderEstimate(); else wzGo(1); }
  });

  // step 4 · the cart: grouped by device, − n + / remove, "+ Add model", "+ Add another device"
  const TRASH = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>';
  const catIcon = (it: CartItem) => { const c = catFor(it); return c ? wz.querySelector(`[data-wz-cat="${c.id}"] .wz-di svg`)?.outerHTML ?? '' : ''; };
  function renderCart() {
    const items = cartItems();
    $('[data-wz-cartsub]', wz).textContent = cartSummary();
    $('[data-wz-cnote]', wz).hidden = !items.some((it) => !it.model);
    $('[data-wz-groups]', wz).innerHTML = items.map((it) => {
      const c = catFor(it);
      return `<div class="wz-grp">
        <div class="wz-gh"><span class="wz-gi">${catIcon(it)}</span><span class="wz-gt"><b>${esc(devTitle(it))}</b><small>${esc(c?.name ?? it.device)}</small></span>
          ${!it.model && c ? `<button type="button" class="wz-fix" data-fix="${esc(it.id)}">+ Add model</button>` : ''}</div>
        ${it.issues.map((s) => {
          const p = pxOf(it, s), q = qtyIn(it, s), k = `${esc(it.id)}::${esc(s)}`;
          return `<div class="wz-gl"><b>${esc(s)}</b>
            <span class="wz-qty sm" role="group" aria-label="${esc(s)} quantity"><button type="button" data-gq="${k}::-1" aria-label="One less">−</button><output>${q}</output><button type="button" data-gq="${k}::1" aria-label="One more">+</button></span>
            <span class="wz-gp">${p === null ? price() : price(r3(p * q))}</span>
            <button type="button" class="wz-grm" data-gq="${k}::0" aria-label="Remove ${esc(s)}">${TRASH}</button></div>`;
        }).join('')}
      </div>`;
    }).join('');
  }
  $('[data-wz-groups]', wz).addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('button');
    if (!t) return;
    if (t.dataset.fix) {   // choose the model for repairs added without one
      const it = cartItems().find((x) => x.id === t.dataset.fix);
      const c = it && catFor(it);
      if (!it || !c) return;
      setWzCat(c.id);
      wzState.brand = ''; wzState.model = ''; wzState.modelId = 0; wzState.seriesId = 0;
      $$('[data-wz-brand]', wz).forEach((x) => x.classList.remove('on'));
      showWzModels();
      wzGo(2);
      fixFor = it.id;
      paintCart();
      return;
    }
    if (!t.dataset.gq) return;
    const [id, s, d] = t.dataset.gq.split('::');
    const it = cartItems().find((x) => x.id === id);
    if (!it) return;
    cartApi().set({ device: it.device, model: it.model }, s, d === '0' ? 0 : qtyIn(it, s) + Number(d));
  });
  $('[data-wz-more]', wz).addEventListener('click', () => {
    wzState.cat = ''; wzState.brand = ''; wzState.model = ''; wzState.modelId = 0; wzState.seriesId = 0;
    $$('[data-wz-cat]', wz).forEach((b) => b.classList.remove('on'));
    wzGo(1);
  });
  // coupon: the same code as the header bag's; it goes with the booking
  const cpOk = $('[data-wz-cpok]', wz);
  function paintCoupon() {
    const c = cartApi()?.coupon() || '';
    cpOk.hidden = !c;
    cpOk.innerHTML = c ? `Code <b>${esc(c)}</b> goes with your booking — our team confirms it. <button type="button" data-wz-cpx>Remove</button>` : '';
    $('[data-wz-cpf]', wz).hidden = !!c;
  }
  $<HTMLFormElement>('[data-wz-cpf]', wz).addEventListener('submit', (e) => {
    e.preventDefault();
    const inp = $<HTMLInputElement>('[data-wz-cp]', wz);
    const v = inp.value.trim().toUpperCase().slice(0, 30);
    if (!v) { inp.focus(); return; }
    cartApi()?.setCoupon(v); inp.value = '';
  });
  cpOk.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('[data-wz-cpx]')) cartApi()?.setCoupon(''); });
  window.addEventListener('danat-cart', paintCoupon);

  // step 4 · details: the customer's own words, photos (max 5, shrunk here) and one video
  const MAX_PHOTOS = 5, VIDEO_BYTES = 30 * 1024 * 1024;
  const media: { photos: Blob[]; video: File | null } = { photos: [], video: null };
  const problemIn = $<HTMLTextAreaElement>('[data-wz-problem]', wz);
  const merr = $('[data-wz-merr]', wz);
  const mErr = (m: string) => { merr.textContent = m; merr.hidden = !m; };
  const shrink = (file: File) => new Promise<Blob>((res) => {
    const img = new Image();
    img.onload = () => {
      const k = Math.min(1, 1600 / Math.max(img.width, img.height));
      const cv = document.createElement('canvas');
      cv.width = Math.round(img.width * k); cv.height = Math.round(img.height * k);
      cv.getContext('2d')!.drawImage(img, 0, 0, cv.width, cv.height);
      cv.toBlob((b) => res(b || file), 'image/jpeg', 0.85);
      URL.revokeObjectURL(img.src);
    };
    img.onerror = () => res(file);
    img.src = URL.createObjectURL(file);
  });
  let thumbUrls: string[] = [];
  const drawThumbs = () => {
    const ul = $('[data-wz-thumbs]', wz);
    thumbUrls.forEach((u) => URL.revokeObjectURL(u));
    thumbUrls = media.photos.map((p) => URL.createObjectURL(p));
    ul.innerHTML = media.photos.map((_p, i) => `<li><img src="${thumbUrls[i]}" alt="Photo ${i + 1}" data-open="${i}" title="Tap to view" /><button type="button" data-rm="p${i}" aria-label="Remove photo">×</button></li>`).join('')
      + (media.video ? `<li class="vid"><span data-open="${media.photos.length}" title="Tap to play">🎬 ${esc(media.video.name)}</span><button type="button" data-rm="v" aria-label="Remove video">×</button></li>` : '');
    if (wzReady) saveMedia();
  };
  $('[data-wz-thumbs]', wz).addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const rm = t.closest<HTMLElement>('[data-rm]')?.dataset.rm;
    if (!rm) { const open = t.closest<HTMLElement>('[data-open]')?.dataset.open; if (open !== undefined) lbOpen(Number(open)); return; }
    if (rm === 'v') media.video = null; else media.photos.splice(Number(rm.slice(1)), 1);
    mErr(''); drawThumbs();
  });

  // Preview pop-up: tap a thumbnail; drag/swipe sideways, the arrows or ← → move between the
  // photos (and the video). Built on <body> so the wizard's animated panels can't clip it.
  const lb = document.createElement('div');
  lb.className = 'wz-lb'; lb.hidden = true;
  lb.setAttribute('role', 'dialog'); lb.setAttribute('aria-modal', 'true'); lb.setAttribute('aria-label', 'Preview');
  lb.innerHTML = `<button type="button" class="wz-lb-x" data-lb-x aria-label="Close">×</button>
    <button type="button" class="wz-lb-nav prev" data-lb-prev aria-label="Previous">‹</button>
    <div class="wz-lb-stage" data-lb-stage><div class="wz-lb-track" data-lb-track></div></div>
    <button type="button" class="wz-lb-nav next" data-lb-next aria-label="Next">›</button>
    <p class="wz-lb-count" data-lb-count></p>`;
  document.body.appendChild(lb);
  const lbTrack = lb.querySelector<HTMLElement>('[data-lb-track]')!;
  const lbStage = lb.querySelector<HTMLElement>('[data-lb-stage]')!;
  let lbUrls: string[] = [], lbAt = 0, lbN = 0;
  const lbPause = () => lbTrack.querySelectorAll('video').forEach((v) => v.pause());
  const lbGo = (i: number, animate = true) => {
    lbAt = Math.max(0, Math.min(lbN - 1, i));
    lbTrack.style.transition = animate ? 'transform .3s cubic-bezier(.2,.8,.2,1)' : 'none';
    lbTrack.style.transform = `translateX(${-lbAt * 100}%)`;
    lb.querySelector('[data-lb-count]')!.textContent = lbN > 1 ? `${lbAt + 1} / ${lbN}` : '';
    lb.querySelector<HTMLButtonElement>('[data-lb-prev]')!.hidden = lbAt === 0;
    lb.querySelector<HTMLButtonElement>('[data-lb-next]')!.hidden = lbAt >= lbN - 1;
    lbPause();
  };
  function lbOpen(i: number) {
    const items: Blob[] = [...media.photos, ...(media.video ? [media.video] : [])];
    if (!items.length) return;
    lbUrls = items.map((b) => URL.createObjectURL(b));
    lbN = items.length;
    lbTrack.innerHTML = items.map((b, k) => `<div class="wz-lb-slide">${b === media.video
      ? `<video src="${lbUrls[k]}" controls playsinline preload="metadata"></video>`
      : `<img src="${lbUrls[k]}" alt="Photo ${k + 1}" draggable="false" />`}</div>`).join('');
    lb.hidden = false;
    document.documentElement.style.overflow = 'hidden';
    lbGo(i, false);
    lb.querySelector<HTMLButtonElement>('[data-lb-x]')!.focus();
  }
  const lbClose = () => {
    lbPause(); lb.hidden = true; lbTrack.innerHTML = '';
    lbUrls.forEach((u) => URL.revokeObjectURL(u)); lbUrls = [];
    document.documentElement.style.overflow = '';
  };
  lb.querySelector('[data-lb-x]')!.addEventListener('click', lbClose);
  lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => lbGo(lbAt - 1));
  lb.querySelector('[data-lb-next]')!.addEventListener('click', () => lbGo(lbAt + 1));
  document.addEventListener('keydown', (e) => {
    if (lb.hidden) return;
    if (e.key === 'Escape') lbClose();
    else if (e.key === 'ArrowLeft') lbGo(lbAt - 1);
    else if (e.key === 'ArrowRight') lbGo(lbAt + 1);
  });
  // drag / swipe: the track follows the finger; past 15% of the width it moves to the next one
  let dragX: number | null = null, dragDx = 0, dragId = 0;
  lbStage.addEventListener('pointerdown', (e) => {
    if ((e.target as HTMLElement).closest('video') || lbN < 2) return; // leave the video's own controls alone
    dragX = e.clientX; dragDx = 0; dragId = e.pointerId;
    lbStage.setPointerCapture(e.pointerId);
    lbTrack.style.transition = 'none';
  });
  lbStage.addEventListener('pointermove', (e) => {
    if (dragX === null || e.pointerId !== dragId) return;
    dragDx = e.clientX - dragX;
