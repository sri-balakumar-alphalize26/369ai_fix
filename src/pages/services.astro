  }

  /* step 4 · your details */
  .wz-who { margin-top: 20px; padding: 22px; border: 1px solid var(--line); border-radius: 20px; }
  .wz-who h4 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; font-size: 16px; margin: 0 0 14px; }
  .wz-who h4 small { font-size: 13px; font-weight: 500; color: var(--ink-3); }
  .wz-f { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }
  .wz-fl { display: grid; gap: 6px; min-width: 0; }
  .wz-fl > span { font-size: 13px; font-weight: 700; color: var(--ink-2); }
  .wz-fl select, .wz-fl input { width: 100%; min-width: 0; height: 48px; padding: 0 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); color: var(--ink); font: inherit; font-size: 15px; outline: none; transition: border-color .2s, box-shadow .2s; }
  .wz-fl select:focus, .wz-fl input:focus { border-color: var(--violet); box-shadow: 0 0 0 4px color-mix(in srgb, var(--violet) 14%, transparent); }
  .wz-fl .bad { border-color: #F43F5E !important; box-shadow: 0 0 0 4px rgba(244, 63, 94, .12) !important; }
  .wz-ph { display: flex; gap: 8px; }
  .wz-ph select { flex: none; width: 128px; padding: 0 8px; font-size: 14px; }
  .wz-ph input { flex: 1; }
  .wz-err { display: flex; align-items: flex-start; gap: 9px; margin: 14px 0 0; padding: 10px 12px; border-radius: 12px; background: linear-gradient(90deg, #FFF1F2, #FFF7F7); border: 1px solid #FECDD3; box-shadow: inset 3px 0 0 #E11D48; color: #9F1239; font-size: 13.5px; font-weight: 600; line-height: 1.4; animation: wzErrIn .28s cubic-bezier(.2,.9,.3,1.2); }
  .wz-err[hidden] { display: none; }
  .wz-err svg { width: 18px; height: 18px; flex: none; color: #E11D48; }
  .wz-err.shake { animation: wzErrIn .28s cubic-bezier(.2,.9,.3,1.2), wzShake .42s .05s ease-in-out; }
  @keyframes wzErrIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  @keyframes wzShake { 20% { translate: -6px; } 40% { translate: 5px; } 60% { translate: -3px; } 80% { translate: 2px; } }
  .wz-now { border: 0; font: inherit; font-weight: 700; cursor: pointer; }
  @media (max-width: 640px) { .wz-f, .wz-acts { grid-template-columns: 1fr; } .wz-who { padding: 18px; } }
  /* ===== step 4 details + step 5 account / address (Odoo connected) ===== */
  .wz-det { display: grid; gap: 14px; }
  .wz-dfl textarea { width: 100%; min-height: 110px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); color: var(--ink); font: inherit; font-size: 15px; resize: vertical; }
  .wz-media { display: flex; flex-wrap: wrap; gap: 10px; }
  .wz-mbtn { display: flex; align-items: center; gap: 10px; padding: 12px 16px; border: 1px dashed var(--line); border-radius: 14px; cursor: pointer; }
  .wz-mbtn svg { width: 22px; height: 22px; color: var(--violet); }
  .wz-mbtn span { display: grid; } .wz-mbtn small { color: var(--ink-3); font-size: 12px; }
  .wz-thumbs { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
  /* thumbnails are drawn by the script (innerHTML), so :global; small 76px squares */
  .wz-thumbs :global(li) { position: relative; }
  .wz-thumbs :global(img) { display: block; width: 76px; height: 76px; object-fit: cover; border-radius: 10px; border: 1px solid var(--line); }
  .wz-thumbs :global(.vid span) { display: flex; align-items: center; height: 76px; padding: 0 12px; border: 1px solid var(--line); border-radius: 10px; font-size: 13px; }
  .wz-thumbs :global([data-open]) { cursor: zoom-in; }
  /* preview pop-up (built by the script on <body>, hence :global) */
  :global(.wz-lb) { position: fixed; inset: 0; z-index: 120; display: grid; grid-template-columns: 56px 1fr 56px; align-items: center; background: rgba(10, 14, 20, .92); touch-action: pan-y; }
  :global(.wz-lb[hidden]) { display: none; }
  :global(.wz-lb-stage) { grid-column: 2; height: 100vh; height: 100dvh; overflow: hidden; cursor: grab; user-select: none; }
  :global(.wz-lb-stage:active) { cursor: grabbing; }
  :global(.wz-lb-track) { display: flex; height: 100%; will-change: transform; }
  :global(.wz-lb-slide) { flex: 0 0 100%; min-width: 0; height: 100%; display: flex; align-items: center; justify-content: center; padding: 56px 8px; box-sizing: border-box; }
  /* always fits the screen and stays centred, whatever the photo or video size */
  :global(.wz-lb-slide img), :global(.wz-lb-slide video) { display: block; width: auto; height: auto; max-width: 100%; max-height: calc(100vh - 112px); max-height: calc(100dvh - 112px); object-fit: contain; border-radius: 12px; box-shadow: 0 20px 60px rgba(0,0,0,.5); pointer-events: auto; -webkit-user-drag: none; }
  :global(.wz-lb-x) { position: absolute; top: 14px; right: 14px; z-index: 2; width: 44px; height: 44px; border: 0; border-radius: 50%; background: rgba(255,255,255,.14); color: #fff; font-size: 26px; line-height: 1; cursor: pointer; }
  :global(.wz-lb-nav) { z-index: 2; justify-self: center; width: 44px; height: 44px; border: 0; border-radius: 50%; background: rgba(255,255,255,.14); color: #fff; font-size: 28px; line-height: 1; cursor: pointer; }
  :global(.wz-lb-nav.prev) { grid-column: 1; grid-row: 1; } :global(.wz-lb-nav.next) { grid-column: 3; grid-row: 1; }
  :global(.wz-lb-nav[hidden]) { visibility: hidden; display: block; }
  :global(.wz-lb-x:hover), :global(.wz-lb-nav:hover) { background: rgba(255,255,255,.26); }
  :global(.wz-lb-count) { position: absolute; left: 0; right: 0; bottom: 16px; margin: 0; text-align: center; color: rgba(255,255,255,.8); font-size: 13px; font-weight: 600; }
  @media (max-width: 600px) { :global(.wz-lb) { grid-template-columns: 0 1fr 0; } :global(.wz-lb-nav) { display: none; } }
  .wz-thumbs :global(button) { position: absolute; top: -6px; right: -6px; width: 22px; height: 22px; border-radius: 50%; border: 0; background: #111; color: #fff; cursor: pointer; line-height: 1; }
  .wz-merr, .wz-acc-msg { margin: 0; font-size: 13.5px; font-weight: 600; color: var(--ink-2); }
  .wz-merr, .wz-acc-msg.bad { color: #9F1239; }
  .wz-acct { margin-top: 20px; padding: 22px; border: 1px solid var(--line); border-radius: 20px; display: grid; gap: 14px; }
  .wz-acct h4 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; font-size: 16px; margin: 0 0 6px; }
  .wz-acct h4 small { font-size: 13px; font-weight: 500; color: var(--ink-3); }
  .wz-acc-in, .wz-acc-addr { display: grid; gap: 12px; }
  .wz-acct .linkish { border: 0; background: none; padding: 0; font: inherit; font-size: 13px; font-weight: 600; color: var(--violet); text-decoration: underline; cursor: pointer; }
  .wz-acct .wz-acts, .wz-who .wz-acts { grid-template-columns: 1fr; }
  .wz-acct .wz-now { background: var(--violet); box-shadow: none; }
  .wz-acct .wz-now:disabled { opacity: .5; cursor: not-allowed; }
  .wz-addrs { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
  /* the address cards are drawn by the script (innerHTML), so they need :global to get these styles */
  /* postal code help, as on 369 Mart: a status line and area chips (the chips are drawn by the script) */
  .wz-pinhelp { grid-column: 1 / -1; display: grid; gap: 8px; margin-top: -4px; }
  .wz-pinhelp[hidden] { display: none; }
  .wz-pinhint { font-size: 13px; font-weight: 600; color: var(--ink-3); }
  .wz-pinhint.good { color: #15803D; }
  .wz-pinhint.good::before { content: '✓ '; }
  .wz-pinhint.busy::before { content: ''; display: inline-block; width: 11px; height: 11px; margin-right: 7px; vertical-align: -1px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: pinSpin .8s linear infinite; }
  @keyframes pinSpin { to { transform: rotate(360deg); } }
  .wz-pinareas { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
  .wz-pinareas[hidden] { display: none; }
  .wz-pinareas small { font-size: 12px; color: var(--ink-3); margin-right: 4px; }
  .wz-pinareas span { display: contents; }
  .wz-pinareas :global(button) { padding: 5px 11px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--ink-2); font: inherit; font-size: 12.5px; font-weight: 600; cursor: pointer; }
  .wz-pinareas :global(button[aria-pressed="true"]) { border-color: var(--violet); color: var(--violet); background: color-mix(in srgb, var(--violet) 8%, var(--surface)); }
  .wz-addrs :global(.wz-addr) { display: grid; gap: 3px; text-align: left; padding: 12px 14px; border: 1px solid var(--line); border-radius: 14px; background: var(--surface); cursor: pointer; font: inherit; }
  .wz-addrs :global(.wz-addr[aria-checked="true"]) { border-color: var(--violet); box-shadow: 0 0 0 3px color-mix(in srgb, var(--violet) 18%, transparent); }
  .wz-addrs :global(.wz-addr span) { font-size: 13.5px; } .wz-addrs :global(.wz-addr small) { font-size: 12px; color: var(--ink-3); }
  .wz-newaddr { display: grid; gap: 12px; padding-top: 6px; border-top: 1px dashed var(--line); }
  .wz-done { display: grid; gap: 8px; }
  .wz-done h4 { margin: 0; font-size: 18px; }
  .wz-typed { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 8px; }
  .wz-typed .wz-search { flex: 1 1 200px; }
  /* ===== redesign: step 2 brand & model ===== */
  .wz-brand { position: relative; padding: 12px 14px; border-radius: 18px; box-shadow: 0 1px 2px rgba(16,24,40,.04); transition: border-color .25s, transform .25s cubic-bezier(.3,1.4,.5,1), box-shadow .25s, background .25s; }
  .wz-panel.on .wz-brand:not([hidden]) { animation: wzPop .45s cubic-bezier(.2,.9,.3,1.2) both; animation-delay: calc(var(--i, 0) * 45ms); }
  .wz-brand:hover { transform: translateY(-3px); border-color: hsl(var(--h) 70% 60% / .55); box-shadow: 0 14px 26px -18px hsl(var(--h) 60% 40% / .55); }
  .wz-brand.on { border-color: transparent; background: linear-gradient(var(--surface), var(--surface)) padding-box, linear-gradient(135deg, hsl(var(--h) 85% 62%), hsl(calc(var(--h) + 50) 85% 66%)) border-box; box-shadow: 0 14px 28px -18px hsl(var(--h) 70% 45% / .6); }
  .wz-mono { width: 46px; height: 46px; border-radius: 14px; background: linear-gradient(135deg, hsl(var(--h) 90% 94%), hsl(calc(var(--h) + 40) 90% 90%)); font-size: 18px; transition: transform .3s; }
  .wz-mono.logo { width: 62px; border-radius: 14px; background: #fff; box-shadow: inset 0 0 0 1px var(--line); }
  .wz-mono img { max-width: 52px; max-height: 26px; object-fit: contain; }
  .wz-lmask { display: block; width: 52px; height: 26px; background: var(--c); -webkit-mask: center / contain no-repeat; mask: center / contain no-repeat; }
  .wz-brand:hover .wz-mono { transform: rotate(-6deg) scale(1.06); }
  .wz-bt { flex: 1; min-width: 0; }
  .wz-bck { position: absolute; top: -7px; right: -7px; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: linear-gradient(135deg, hsl(var(--h) 85% 58%), hsl(calc(var(--h) + 50) 85% 62%)); color: #fff; box-shadow: 0 6px 12px -4px hsl(var(--h) 70% 45% / .6); transform: scale(0); transition: transform .35s cubic-bezier(.3,1.8,.5,1); }
  .wz-bck svg { width: 13px; height: 13px; }
