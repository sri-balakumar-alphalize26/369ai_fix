      items.forEach((li, i) => li.classList.toggle('on', i === sugIdx));
      wzArea.setAttribute('aria-activedescendant', items[sugIdx].id);
    } else if (e.key === 'Enter' && sugIdx >= 0) { e.preventDefault(); pick(items[sugIdx].dataset.a!); }
    else if (e.key === 'Escape') closeSug();
  });
  asug.addEventListener('mousedown', (e) => { const li = (e.target as HTMLElement).closest<HTMLElement>('li'); if (li) { e.preventDefault(); pick(li.dataset.a!); } });
  wzArea.addEventListener('blur', () => setTimeout(closeSug, 120));

  // "Use my location": device GPS first, then the internet connection (city level) as a fallback
  const ipGuess = async (): Promise<{ at: [number, number]; place: string } | null> => {
    for (const [url, pickIt] of [
      ['https://get.geojs.io/v1/ip/geo.json', (j: any) => j.latitude != null && { at: [Number(j.latitude), Number(j.longitude)], place: [j.city, j.country].filter(Boolean).join(', ') }],
      ['https://ipwho.is/', (j: any) => j.latitude != null && { at: [j.latitude, j.longitude], place: [j.city, j.country].filter(Boolean).join(', ') }],
    ] as [string, (j: any) => any][]) {
      try { const v = pickIt(await (await fetch(url, { signal: AbortSignal.timeout(4000) })).json()); if (v) return v; } catch {}
    }
    return null;
  };
  const placeName = async (at: [number, number]) => {
    try {
      const j = await (await fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${at[0]}&longitude=${at[1]}&localityLanguage=en`, { signal: AbortSignal.timeout(5000) })).json();
      return [j.locality || j.city, j.countryName].filter(Boolean).filter((v: string, i: number, a: string[]) => a.indexOf(v) === i).join(', ');
    } catch { return ''; }
  };
  const gps = () => new Promise<[number, number] | null>((res) => {
    if (!navigator.geolocation) return res(null);
    navigator.geolocation.getCurrentPosition((p) => res([p.coords.latitude, p.coords.longitude]), () => res(null), { enableHighAccuracy: true, timeout: 9000, maximumAge: 0 });
  });
  const useLocation = async (at: [number, number], place: string, exact: boolean) => {
    const near = Object.entries(areaGeo).map(([n, p]) => ({ n, d: km(at, p) })).sort((a, b) => a.d - b.d)[0];
    const served = near.d <= (exact ? 12 : 40) && listed.some((x) => x.a === near.n);
    wzAt = at;
    if (served) { wzArea.value = near.n; areaStatus(); astat.innerHTML += ` <em>· found from your ${exact ? 'device' : 'internet connection'}</em>`; }
    else {
      const br = branchGeo.map((b) => ({ ...b, d: km(at, b.at) })).sort((a, b) => a.d - b.d)[0];
      wzArea.value = place || `${at[0].toFixed(3)}, ${at[1].toFixed(3)}`;
      areaState = 'far';
      areaStatus(near.d <= 60
        ? `<b>Close to ${esc(near.n)}</b> but just outside our list — send it and we'll confirm.`
        : `<b>Outside our service area</b> — our nearest branch is ${esc(br.name)}, ${Math.round(br.d).toLocaleString()} km away. You can still book for an address in Oman.`);
    }
    wzProgress();
    try { localStorage.setItem('svc-loc', JSON.stringify({ name: served ? near.n : wzArea.value, covered: served })); window.dispatchEvent(new CustomEvent('svc-loc', { detail: { name: served ? near.n : wzArea.value, covered: served } })); } catch {}
  };
  locBtn.addEventListener('click', async () => {
    if (locBtn.classList.contains('busy')) return;
    locBtn.classList.add('busy'); closeSug();
    astat.className = 'wz-astat wait'; astat.hidden = false; astat.innerHTML = '<i class="wz-spin"></i> Finding your location…';
    const at = await gps();
    if (at) await useLocation(at, await placeName(at), true);
    else {
      const ip = await ipGuess();
      if (ip) await useLocation(ip.at, ip.place, false);
      else { astat.className = 'wz-astat soon'; astat.innerHTML = "<b>We couldn't find your location</b> — please type your area instead."; wzArea.focus(); }
    }
    locBtn.classList.remove('busy');
  });
  // Already checked your location in the header? Start with that area.
  try {
    const saved = JSON.parse(localStorage.getItem('svc-loc') || 'null');
    if (saved?.covered && saved.name && !wzArea.value) { wzArea.value = String(saved.name).slice(0, 80); }
  } catch {}
  // live progress: ring + ticks + "ready" button as the three details are filled
  const wzProgress = () => {
    const ok = [wzArea.value.trim().length >= 2, wzName.value.trim().length >= 2, checkPhone(wzCc.value, wzPhone.value).ok];
    [wzArea, wzName, wzPhone].forEach((el, k) => el.closest('.wz-fl')!.classList.toggle('ok', ok[k]));
    // every area we serve is in Oman — a foreign number is allowed (family abroad) but flagged
    const foreign = ok[2] && wzCc.value !== 'om' && areaState === 'listed';
    wzPhone.closest('.wz-fl')!.classList.toggle('warn', foreign);
    wzArea.closest('.wz-fl')!.classList.toggle('warn', ok[0] && (areaState === 'far' || areaState === 'unlisted'));
    $('[data-wz-warn]', wz).hidden = !foreign;
    if (foreign) $('[data-wz-warntx]', wz).textContent = `${wzArea.value} is in Oman, so our technician will call this ${dialFor(wzCc.value).name} number (${dialFor(wzCc.value).code}). If you have an Omani +968 number, please use that — or keep this one if you're booking for family in Oman.`;
    const n = ok.filter(Boolean).length;
    $('[data-wz-pn]', wz).textContent = `${n}/3`;
    ($('[data-wz-ring]', wz) as unknown as SVGCircleElement).style.strokeDashoffset = String(119.4 * (1 - n / 3));
    $('[data-wz-pt]', wz).textContent = n === 3 ? 'All set!' : n === 0 ? '3 quick details' : `${3 - n} more to go`;
    $('[data-wz-ps]', wz).textContent = n === 3 ? 'tap the green button to send' : 'and your booking is ready';
    const was = wz.querySelector('.wz-who')!.classList.contains('ready');
    wz.querySelector('.wz-who')!.classList.toggle('ready', n === 3);
    if (n === 3 && !was) { const b = $('[data-wz-now]', wz); b.classList.remove('wake'); void b.offsetWidth; b.classList.add('wake'); }
  };
  wzCc.addEventListener('change', wzProgress);
  [wzName, wzPhone].forEach((el) => el.addEventListener('input', wzProgress));
  $('[data-wz-now]', wz).addEventListener('click', () => {
    const name = wzName.value.trim().replace(/\s+/g, ' ');
    if (wzArea.value.trim().length < 2) { wzErrFor(wzArea, 'Please type your area or tap “Use my location”.'); wzArea.focus(); return; }
    if (name.length < 2) { wzErrFor(wzName, 'Please enter your name.'); wzName.focus(); return; }
    if (!wzPhone.value.trim()) { wzErrFor(wzPhone, 'Please enter your mobile number.'); wzPhone.focus(); return; }
    const ph = checkPhone(wzCc.value, wzPhone.value);
    if (!ph.ok) { wzErrFor(wzPhone, ph.msg); wzPhone.focus(); return; }
    wzErrFor(null, '');
    // Same booking (every cart line) into Odoo (Online Service), alongside the WhatsApp message - never blocks it.
    const ref = 'W-' + Date.now().toString(36).toUpperCase() + Math.random().toString(36).slice(2, 6).toUpperCase();
    const coupon = cartApi()?.coupon() || '';
    fetch('/api/booking', {
      method: 'POST', keepalive: true, credentials: 'same-origin',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        ref, mode: 'doorstep', source: 'wizard', name, phone: ph.full, area: wzArea.value.trim(),
        ...(wzAt ? { lat: wzAt[0], lng: wzAt[1] } : {}),
        note: areaState === 'listed' ? '' : areaState === 'far' ? 'Area outside the listed areas' : 'Area not on the list - please confirm',
        problem: problemIn.value.trim(), coupon, page: location.pathname,
        lines: odooLines(),
      }),
    }).catch(() => {});
    const msg = [
      `Hi Danat Fix, I'd like to book ${cartCount() === 1 ? 'a repair' : 'these repairs'}.`,
      `Booking ref: ${ref}`,
      `Service: ${titles[mode]}`,
      `Area: ${wzArea.value.trim()}${areaState === 'listed' ? '' : areaState === 'far' ? ' (outside listed areas)' : ' (not on the list — please confirm)'}`,
      ...(wzAt ? [`Location: https://maps.google.com/?q=${wzAt[0].toFixed(5)},${wzAt[1].toFixed(5)}`] : []),
      ...cartItems().map((it) => `• ${it.issues.map((s) => (qtyIn(it, s) > 1 ? `${s} ×${qtyIn(it, s)}` : s)).join(', ')} — ${catFor(it)?.name ?? it.device}${it.model ? ', ' + it.model : ''}`),
      ...(problemIn.value.trim() ? [`Details: ${problemIn.value.trim()}`] : []),
      ...(coupon ? [`Coupon code: ${coupon}`] : []),
      `Name: ${name}`,
      `Phone: ${ph.full}`,
    ].join('\n');
    window.open(waUrl(msg), '_blank', 'noopener');
  });

  // ---------- keep the booking where the customer left it ----------
  // A reload (or the site updating) must not start the booking again from scratch. The choices,
  // the text and the half-typed address are kept for this tab (sessionStorage); the photos and
  // the video, too big for that, in IndexedDB. Both are forgotten once the booking is made.
  const WZ_KEY = 'wz-progress';
  const AF_KEYS = ['label', 'name', 'phone', 'alt', 'building', 'way', 'flat', 'area', 'town', 'state_id', 'pin', 'landmark'];
  function saveWz() {
    if (!wzReady) return;
    try {
      sessionStorage.setItem(WZ_KEY, JSON.stringify({
        step: wzState.step, cat: wzState.cat, brand: wzState.brand, model: wzState.model,
        modelId: wzState.modelId, seriesId: wzState.seriesId,
        problem: problemIn.value, phone: accPhone.value,
        af: Object.fromEntries(AF_KEYS.map((k) => [k, af(k).value])),
      }));
    } catch {}
  }
  const mediaDb = () => new Promise<IDBDatabase | null>((res) => {
    try {
      const r = indexedDB.open('wz-media', 1);
      r.onupgradeneeded = () => r.result.createObjectStore('m');
      r.onsuccess = () => res(r.result); r.onerror = () => res(null);
    } catch { res(null); }
  });
  async function saveMedia() {
    const db = await mediaDb(); if (!db) return;
    try { db.transaction('m', 'readwrite').objectStore('m').put({ photos: media.photos, video: media.video }, 'media'); } catch {}
  }
  async function loadMedia(): Promise<{ photos: Blob[]; video: File | null } | null> {
    const db = await mediaDb(); if (!db) return null;
    return new Promise((res) => {
      try { const g = db.transaction('m').objectStore('m').get('media'); g.onsuccess = () => res(g.result || null); g.onerror = () => res(null); }
      catch { res(null); }
    });
  }
  async function forgetWz() {
    try { sessionStorage.removeItem(WZ_KEY); } catch {}
    const db = await mediaDb(); if (!db) return;
    try { db.transaction('m', 'readwrite').objectStore('m').delete('media'); } catch {}
  }
  // typing anywhere in the wizard (problem text, mobile, address form) is kept, a moment later
  let saveT = 0;
  wz.addEventListener('input', () => { clearTimeout(saveT); saveT = window.setTimeout(saveWz, 300); });
  wz.addEventListener('change', () => saveWz());
  async function restoreWz() {
    let s: any = null;
    try { s = JSON.parse(sessionStorage.getItem(WZ_KEY) || 'null'); } catch {}
    if (!s) return false;
    const hasCat = !!s.cat && data.categories.some((c) => c.id === s.cat);
    // the repairs themselves live in the cart (localStorage); a cart / book step needs only that
    if (!hasCat && !(s.step >= 4 && cartCount())) return false;
    if (hasCat) {
      setWzCat(s.cat);
      if (s.brand) {
        wzState.brand = s.brand;
        const tile = wz.querySelector<HTMLElement>(`[data-wz-brand="${CSS.escape(s.brand)}"]`);
        if (tile) wz.style.setProperty('--mh', tile.style.getPropertyValue('--h'));
        $$('[data-wz-brand]', wz).forEach((x) => x.classList.toggle('on', x.dataset.wzBrand === s.brand));
      }
      wzState.model = s.model || ''; wzState.modelId = s.modelId || 0; wzState.seriesId = s.seriesId || 0;
      showWzModels(); showIssues();
    }
    problemIn.value = s.problem || '';
    if (s.phone) accPhone.value = s.phone;
    for (const k of AF_KEYS) if (s.af?.[k]) af(k).value = s.af[k];
    const m = await loadMedia();
    if (m) { media.photos = m.photos || []; media.video = m.video || null; drawThumbs(); }
    wzGo(s.step || 1);
    if ((s.step || 1) > 1) requestAnimationFrame(() => wz.scrollIntoView({ block: 'start' }));
    // the address form was being filled in: open it again with what was typed
    if (s.step === LAST && (s.af?.building || s.af?.way || s.af?.pin)) setTimeout(() => { if ($('[data-acc-addrbox]', wz).hidden === false) openAddressForm(); }, 1200);
    return true;
  }

  // footer + progress
  $('[data-wz-back]', wz).addEventListener('click', () => wzGo(wzState.step - 1));
  $('[data-wz-next]', wz).addEventListener('click', () => { if (canNext()) wzGo(wzState.step + 1); });
  $$('[data-wz-goto]', wz).forEach((b) => b.addEventListener('click', () => { const n = Number(b.dataset.wzGoto); if (n <= wzState.step || canNext()) wzGo(n); }));

  // deep links: ?cat=printer  ?q=Samsung (brand)  ?q=S24 (model search)
  function wzDeepLink(cat: string | null, q: string | null) {
    if (cat && data.categories.some((c) => c.id === cat)) { setWzCat(cat); wzGo(2); }
    if (!q) return;
    const nq = norm(q);
    const tile = $$('[data-wz-brand]', wz).find((b) => (!wzState.cat || b.dataset.wzBrandCat === wzState.cat) && norm(b.dataset.name!).startsWith(nq));
    if (tile) { setWzCat(tile.dataset.wzBrandCat!); tile.click(); return; }
    const m = $$('.wz-model', wz).find((x) => (!wzState.cat || x.dataset.modelCat === wzState.cat) && x.dataset.q!.includes(nq));
    if (m) { setWzCat(m.dataset.modelCat!); wzSearch.value = q; showWzModels(); wzGo(2); }
  }
  // "Proceed to book" in the header bag, or Book now on Our Services: straight to the Cart step
  const toCart = () => {
    cartApi()?.close();
    wzGo(cartCount() ? 4 : 1);
    requestAnimationFrame(() => wz.scrollIntoView({ behavior: 'smooth', block: 'start' }));
  };
  document.querySelector('[data-cd-proceed]')?.addEventListener('click', (e) => { e.preventDefault(); toCart(); });
  window.addEventListener('danat-checkout', toCart);

  // Deep links from the home page and nav menu: ?mode=pickup, ?cat=printer, ?q=Samsung, ?cart=1
  // (The cart lives in CartDrawer's script; every module script has run by DOMContentLoaded.)
  const q = new URLSearchParams(location.search);
  const wzStart = () => {
    wzGo(1);
    if (q.get('cat') || q.get('q')) { wzReady = true; wzDeepLink(q.get('cat'), q.get('q')); }
    else restoreWz().finally(() => {
      wzReady = true;
      if (q.get('cart') && cartCount() && wzState.step < 4) wzGo(4);
      saveWz();
    });
  };
  if (cartApi()) wzStart(); else document.addEventListener('DOMContentLoaded', wzStart, { once: true });
  const startMode = q.get('mode');
  setMode(startMode && data.coverage[startMode] ? startMode : 'doorstep');
  // ?area= from the home-page location search: pre-check coverage and pre-fill the booking
  // Links from the menu land on a section; re-scroll once the page has laid out.
  if (location.hash) requestAnimationFrame(() => document.querySelector(location.hash)?.scrollIntoView());
  // Home 'Check your area' cards land here with the mode already chosen — put the cursor in the area box
  areaStatus();
  wzProgress();
  if (location.hash === '#coverage') setTimeout(() => areaSearch.focus({ preventScroll: true }), 400);
  const startArea = q.get('area');
  if (startArea) {
    areaSearch.value = startArea;
    filterAreas();
    wzArea.value = startArea; areaStatus(); wzProgress();
  }
</script>

<style>
  .cart-lead { margin: 12px 0 28px; }
  #coverage { scroll-margin-top: 110px; }

  .faq { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 40px; align-items: start; }
  .faq h2 { margin-top: 14px; }
  .faq-list { display: grid; gap: 10px; }
  .faq-item { background: var(--surface); border: 1px solid var(--line); border-radius: 16px; box-shadow: var(--shadow); }
  .faq-item summary { padding: 18px 20px; font-weight: 700; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::after { content: '+'; color: var(--violet); font-size: 20px; line-height: 1; }
  .faq-item[open] summary::after { content: '−'; }
  .faq-item p { padding: 0 20px 18px; color: var(--ink-2); }
  @media (max-width: 860px) { .faq { grid-template-columns: 1fr; } }
  .page-head { padding: clamp(48px, 8vw, 100px) 0 20px; }
  .page-head h1 { margin: 18px 0 20px; max-width: 16ch; }
  .section.tight { padding: clamp(48px, 7vw, 88px) 0; }


  /* step headings */
  .step-head { display: flex; align-items: center; gap: 18px; margin-bottom: 26px; }
  .step-head h2 { margin-top: 6px; font-size: 24px; }
  .sh2 { margin-top: 64px; }
  .step-no { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--grad); color: var(--on-accent); font-family: var(--display); font-size: 18px; font-weight: 800; flex: none; box-shadow: 0 14px 30px -14px rgba(var(--a1), .7); }

  /* mode cards */
  .mode-pick { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .mode-card {
    position: relative; display: flex; flex-direction: column; gap: 18px; text-align: left;
    padding: 28px; background: var(--surface); border: 1.5px solid var(--line); border-radius: 26px; box-shadow: var(--shadow);
    transition: border-color .3s, box-shadow .3s, transform .3s;
  }
  .mode-card:hover { transform: translateY(-3px); }
  .mode-card[aria-checked='true'] { border-color: var(--violet); box-shadow: 0 26px 56px -28px rgba(var(--a1), .6); }
  .mode-card[aria-checked='true']::before { content: ''; position: absolute; inset: 0; border-radius: inherit; background: radial-gradient(420px circle at 0% 0%, var(--accent-soft), transparent 60%); pointer-events: none; }
  .mode-card > * { position: relative; }
  .mode-card > .mode-radio { position: absolute; top: 26px; right: 26px; width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--ink-3); transition: border-color .2s, box-shadow .2s; }
  [aria-checked='true'] > .mode-radio { border-color: var(--violet); box-shadow: inset 0 0 0 4px var(--surface), inset 0 0 0 12px var(--violet); }
  .mc-top { display: flex; align-items: center; gap: 16px; padding-right: 36px; }
  .mode-icon { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 18px; background: var(--tint-2); flex: none; transition: background .3s, color .3s; }
  [aria-checked='true'] .mode-icon { background: var(--grad); color: var(--on-accent); }
  .mode-icon svg { width: 30px; height: 30px; }
  .mc-titles { display: grid; gap: 2px; }
  .mode-title { font-family: var(--display); font-size: 18px; font-weight: 800; }
  .mode-short { color: var(--ink-2); font-size: 15px; }
  .mc-eta { align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px; border-radius: 999px; background: var(--accent-soft); color: var(--violet); font-size: 13px; font-weight: 700; }
  .mc-eta svg { width: 16px; height: 16px; }
  .mc-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); position: relative; }
  .mc-steps::before { content: ''; position: absolute; left: 16%; right: 16%; top: 15px; height: 2px; background: repeating-linear-gradient(90deg, var(--line) 0 6px, transparent 6px 12px); }
  [aria-checked='true'] .mc-steps::before { background: repeating-linear-gradient(90deg, var(--violet) 0 6px, transparent 6px 12px); }
  .mc-steps li { position: relative; display: grid; justify-items: center; gap: 8px; text-align: center; font-size: 13px; color: var(--ink-2); line-height: 1.3; }
  .mc-steps b { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; background: var(--surface); border: 2px solid var(--line); font-size: 13px; color: var(--ink-2); }
  [aria-checked='true'] .mc-steps b { border-color: var(--violet); color: var(--violet); }
  .mc-for { display: flex; align-items: center; gap: 12px; padding-top: 16px; border-top: 1px dashed var(--line); }
  .mc-for small { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-3); flex: none; }
  .mc-icons { display: flex; flex-wrap: wrap; gap: 6px; }
  .mc-ic { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; background: var(--tint); color: var(--ink-2); }
  .mc-ic svg { width: 17px; height: 17px; }
  .mc-foot { display: flex; justify-content: space-between; align-items: center; font-size: 14px; color: var(--ink-3); }
  .mc-choose { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; color: var(--violet); }
  .mc-choose svg { width: 16px; height: 16px; transition: transform .2s; }
  .mode-card:hover .mc-choose svg { transform: translateX(3px); }
  @media (max-width: 820px) { .mode-pick { grid-template-columns: 1fr; } }

  /* coverage: branch tabs · areas · map */
  .coverage { padding: clamp(20px, 3vw, 30px); background: var(--surface); border: 1px solid var(--line); border-radius: 26px; box-shadow: var(--shadow); }
  .cov-head { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
  .cov-eta { color: var(--ink-2); font-weight: 600; }
  .cov-result { margin: 12px 0 0; color: var(--ink-2); font-size: 14px; }
  .cov-result:empty { display: none; }
  .cov-result :global(b) { color: var(--lime); }
  .cov-result :global(.linkish) { border: 0; background: none; padding: 0; color: var(--violet); text-decoration: underline; }
  .zones { display: grid; grid-template-columns: 230px minmax(0, 1fr) minmax(0, 1fr); gap: 22px; margin-top: 22px; animation: fadeUp .5s both; }
  .zones[hidden] { display: none; }
  @keyframes fadeUp { from { opacity: 0; transform: translateY(12px); } }
  .z-tabs { display: grid; gap: 8px; align-content: start; }
  .z-tab { display: flex; align-items: center; gap: 12px; padding: 14px; border-radius: 16px; border: 1px solid var(--line); background: var(--surface); text-align: left; transition: border-color .2s, background .2s; }
  .z-tab b { display: block; font-size: 15px; }
  .z-tab small { font-size: 12px; color: var(--ink-3); }
  .z-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--line); flex: none; transition: background .2s, box-shadow .2s; }
  .z-tab[aria-selected='true'] { border-color: var(--violet); background: var(--accent-soft); }
  .z-tab[aria-selected='true'] .z-dot { background: var(--violet); box-shadow: 0 0 0 4px rgba(var(--a1), .2); }
  .zone { animation: fadeUp .35s both; }
  .zone[hidden] { display: none; }
  .zone h3 { font-family: var(--body); font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 12px; }
  .areas { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 14px; }
  .area { justify-self: stretch; display: flex; align-items: center; gap: 8px; padding: 8px 10px; border: 0; border-radius: 10px; background: none; font-size: 14px; color: var(--ink-2); text-align: left; transition: background .15s, color .15s; }
  .area::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--line); flex: none; }
  .area:hover { background: var(--tint); color: var(--ink); }
  .area.hit { background: rgba(18, 161, 80, .1); color: var(--lime); font-weight: 700; }
  .area.hit::before { background: var(--lime); }
  .area.picked { background: var(--accent-soft); color: var(--violet); font-weight: 700; }
  .area.picked::before { background: var(--violet); }
  .area.dim { opacity: .35; }
  .z-map iframe { display: block; width: 100%; height: 100%; min-height: 300px; border: 0; border-radius: 18px; background: var(--tint); }
  .z-map iframe[hidden] { display: none; }
  .trust { list-style: none; margin: 24px 0 0; padding: 18px 0 0; border-top: 1px solid var(--line); display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .trust li { display: flex; align-items: center; gap: 10px; font-size: 13.5px; color: var(--ink-2); }
  .trust span { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--accent-soft); color: var(--violet); font-size: 12px; font-weight: 800; flex: none; }
  @media (max-width: 1000px) { .zones { grid-template-columns: 1fr; } .z-tabs { grid-template-columns: repeat(3, 1fr); } .trust { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .z-tabs { grid-template-columns: 1fr; } .trust { grid-template-columns: 1fr; } }

  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 16px;
    height: 48px;
    min-width: min(340px, 100%);
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    transition: border-color .2s;
  }
  .search:focus-within { border-color: var(--violet); }
  .search svg { width: 18px; height: 18px; color: var(--ink-3); flex: none; }
  .search input { flex: 1; min-width: 0; border: 0; background: none; outline: none; color: var(--ink); font: inherit; }

  /* booking wizard */
  .cat-head { display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; margin-bottom: 26px; }
  .cat-head h2 { margin-top: 14px; }
  .wz { background: var(--surface); border: 1px solid var(--line); border-radius: 28px; box-shadow: var(--shadow); overflow: hidden; overflow: clip; } /* clip, not a scroll box: the side cart can stick */
  .wz-steps { position: relative; list-style: none; margin: 0; padding: 26px 40px 22px; display: grid; grid-template-columns: repeat(5, 1fr); border-bottom: 1px solid var(--line); background: var(--tint); }
  /* rail runs from the first dot to the last: half a column (of 5) in from each side */
  .wz-rail { position: absolute; left: calc(40px + (100% - 80px) / 10); right: calc(40px + (100% - 80px) / 10); top: 45px; height: 3px; border-radius: 3px; background: var(--line); z-index: 0; }
  .wz-rail i { display: block; height: 100%; width: 0; border-radius: 3px; background: var(--violet); transition: width .5s cubic-bezier(.2,.8,.2,1); }
  .wz-step { position: relative; z-index: 1; display: grid; justify-items: center; }
  .wz-step button { display: grid; justify-items: center; gap: 8px; border: 0; background: none; padding: 0; font-size: 13.5px; font-weight: 600; color: var(--ink-3); }
  .wz-step b { position: relative; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--surface); border: 2px solid var(--line); font-size: 15px; color: var(--ink-3); transition: all .3s; }
  .wz-tick { position: absolute; inset: 0; display: grid; place-items: center; opacity: 0; }
  .wz-tick svg { width: 18px; height: 18px; }
  .wz-step.on b { border-color: var(--violet); color: var(--violet); box-shadow: 0 0 0 5px rgba(var(--a1), .15); }
  .wz-step.on button { color: var(--ink); }
  .wz-step.done b { background: var(--violet); border-color: var(--violet); color: transparent; }
  .wz-step.done .wz-tick { opacity: 1; color: var(--on-accent); }
  .wz-step.done button { color: var(--ink-2); }

  .wz-panel { padding: 28px 32px; min-height: 380px; animation: wzIn .4s cubic-bezier(.2,.8,.2,1); }
  .wz-panel[hidden] { display: none; }
  @keyframes wzIn { from { opacity: 0; transform: translateX(16px); } }
  .wz-q { font-size: 18px; margin-bottom: 18px; }
  .wz-q small { font-size: 14px; font-weight: 500; color: var(--ink-3); margin-left: 6px; }

  .wz-devs { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px; }
  .wz-dev { display: grid; justify-items: center; gap: 8px; padding: 22px 14px; border: 1.5px solid var(--line); border-radius: 20px; background: var(--surface); text-align: center; transition: transform .25s, border-color .25s, box-shadow .25s; }
  .wz-dev:hover { transform: translateY(-4px); border-color: hsl(var(--h) 60% 50% / .5); box-shadow: 0 18px 30px -20px rgba(0,0,0,.35); }
  .wz-dev.on { border-color: var(--violet); background: var(--accent-soft); }
  .wz-di { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 18px; background: hsl(var(--h) 70% var(--chip-l, 94%)); color: hsl(var(--h) 60% var(--chip-ink-l, 40%)); }
  .wz-di svg { width: 30px; height: 30px; }
  .wz-di.sm { width: 46px; height: 46px; border-radius: 14px; background: var(--accent-soft); color: var(--violet); }
  .wz-di.sm :global(svg) { width: 24px; height: 24px; }
  /* a picture from Odoo fills its tile and hides the drawing / logo / icon under it */
  .has-pic { position: relative; overflow: hidden; }
  .has-pic > :not(.wz-pic) { visibility: hidden; }
  .wz-pic { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .wz-mono .wz-pic { inset: 6px; width: calc(100% - 12px); height: calc(100% - 12px); max-width: none; max-height: none; object-fit: contain; }
  .wz-dev b { font-size: 15px; }
  .wz-dev small { font-size: 12.5px; color: var(--ink-3); }

  .wz-bm { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 22px; }
  .wz-brands { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px; align-content: start; }
  .wz-brand { display: flex; align-items: center; gap: 10px; padding: 12px; border: 1.5px solid var(--line); border-radius: 16px; background: var(--surface); text-align: left; transition: border-color .2s, transform .2s; }
  .wz-brand:hover { transform: translateY(-2px); }
  .wz-brand.on { border-color: var(--violet); background: var(--accent-soft); }
  .wz-brand b { display: block; font-size: 14px; line-height: 1.2; }
  .wz-brand small { font-size: 12px; color: var(--ink-3); }
  .wz-mono { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 50%; background: hsl(var(--h) 70% var(--chip-l, 94%)); color: hsl(var(--h) 60% var(--chip-ink-l, 40%)); font-weight: 800; flex: none; }
  .wz-models { display: flex; flex-direction: column; gap: 10px; min-width: 0; padding: 14px; border-radius: 20px; background: var(--tint); }
  .wz-search { display: flex; align-items: center; gap: 10px; height: 46px; padding: 0 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); }
  .wz-search:focus-within { border-color: var(--violet); }
  .wz-search svg { width: 18px; height: 18px; color: var(--ink-3); }
  .wz-search input { flex: 1; min-width: 0; border: 0; outline: none; background: none; font: inherit; color: var(--ink); }
  .wz-mhint { font-size: 12.5px; color: var(--ink-3); padding: 0 4px; }
  .wz-mlist { list-style: none; margin: 0; padding: 0; max-height: 300px; overflow-y: auto; display: grid; gap: 4px; }
  .wz-mlist li[hidden] { display: none; }
  .wz-model { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 12px; border: 0; border-radius: 10px; background: var(--surface); text-align: left; transition: background .15s; }
  .wz-model span { font-weight: 600; font-size: 14px; }
  .wz-model small { display: block; font-weight: 500; font-size: 12px; color: var(--ink-3); }
  .wz-model i { font-style: normal; color: var(--violet); opacity: 0; transition: opacity .15s, transform .15s; }
  .wz-model:hover i, .wz-model.on i { opacity: 1; transform: translateX(2px); }
  .wz-model.on { background: var(--accent-soft); box-shadow: inset 3px 0 0 var(--violet); }
  .wz-skip { align-self: flex-start; border: 0; background: none; padding: 4px; font-size: 13px; font-weight: 700; color: var(--violet); }

  /* step 3 · repairs as an Urban Company list: one row each, Add → − n + */
  .wz-issues { display: grid; border: 1px solid var(--line); border-radius: 18px; overflow: hidden; }
  .wz-issues[hidden] { display: none; }
  .wz-iss { display: flex; align-items: center; gap: 14px; padding: 14px 16px; background: var(--surface); text-align: left; transition: background .2s; }
  .wz-iss + .wz-iss { border-top: 1px solid var(--line); }
  .wz-iss[hidden] + .wz-iss, .wz-iss:first-child { border-top: 0; }
  .wz-iss.in { background: var(--accent-soft); }
  .wz-ii { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px; background: hsl(var(--h) 70% var(--chip-l, 94%)); color: hsl(var(--h) 60% var(--chip-ink-l, 40%)); flex: none; }
  .wz-ii :global(svg) { width: 22px; height: 22px; }
  .wz-in { flex: 1; min-width: 0; display: grid; gap: 1px; }
  .wz-in b { font-size: 15px; }
  .wz-in small { font-size: 12.5px; color: var(--ink-3); }
  .wz-in em { margin-top: 3px; font-style: normal; font-size: 13.5px; font-weight: 700; color: var(--ink); }
  .wz-act { flex: none; }
  .wz-addb { min-width: 88px; height: 38px; border: 1.5px solid var(--violet); border-radius: 10px; background: var(--surface); color: var(--violet); font: inherit; font-size: 13.5px; font-weight: 800; letter-spacing: .04em; text-transform: uppercase; cursor: pointer; transition: background .2s; }
  .wz-addb:hover { background: var(--accent-soft); }
  .wz-addb[hidden], .wz-qty[hidden] { display: none; }
  .wz-qty { display: inline-grid; grid-template-columns: 30px 28px 30px; align-items: center; min-width: 88px; height: 38px; border-radius: 10px; background: var(--violet); color: var(--on-accent); overflow: hidden; }
  .wz-qty button { height: 100%; border: 0; background: none; color: inherit; font: inherit; font-size: 18px; font-weight: 700; cursor: pointer; }
  .wz-qty output { text-align: center; font-weight: 800; font-variant-numeric: tabular-nums; }
  /* the cart step's steppers are drawn by the script (innerHTML), hence :global */
  .wz-groups :global(.wz-qty) { display: inline-grid; grid-template-columns: 28px 28px 28px; align-items: center; min-width: 84px; height: 34px; border-radius: 10px; background: var(--accent-soft); color: var(--violet); overflow: hidden; }
  .wz-groups :global(.wz-qty button) { height: 100%; border: 0; background: none; color: inherit; font: inherit; font-size: 17px; font-weight: 700; cursor: pointer; }
  .wz-groups :global(.wz-qty output) { text-align: center; font-weight: 800; font-variant-numeric: tabular-nums; }

  /* steps 1-3: the live cart beside the panel (wide screens) */
  .wz-body { display: grid; grid-template-columns: minmax(0, 1fr) 300px; align-items: start; }
  .wz-body.full { grid-template-columns: minmax(0, 1fr); }
  .wz-side { position: sticky; top: 90px; display: grid; gap: 12px; padding: 28px 32px 28px 0; }
  .wz-side[hidden] { display: none; }
  .wz-sc { display: grid; gap: 12px; padding: 18px; border: 1px solid var(--line); border-radius: 18px; background: var(--surface); }
  .wz-sc h4 { display: flex; justify-content: space-between; align-items: baseline; margin: 0; font-size: 17px; }
  .wz-sc h4 small { font-size: 13px; font-weight: 600; color: var(--ink-3); }
  .wz-sce { display: grid; justify-items: center; gap: 6px; padding: 16px 0 6px; font-size: 13.5px; color: var(--ink-3); text-align: center; }
  .wz-sce[hidden] { display: none; }
  .wz-sce svg { width: 40px; height: 40px; opacity: .6; }
  .wz-sc ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; max-height: 320px; overflow-y: auto; }
  .wz-sc ul:empty { display: none; }
  .wz-sc ul :global(li) { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px; font-size: 13.5px; }
  .wz-sc ul :global(li small) { display: block; font-size: 12px; color: var(--ink-3); }
  .wz-sct { display: flex; justify-content: space-between; padding-top: 12px; border-top: 1px dashed var(--line); font-weight: 800; }
  .wz-sct[hidden] { display: none; }
  .wz-scgo { height: 46px; border: 0; border-radius: 12px; background: var(--violet); color: var(--on-accent); font: inherit; font-weight: 800; font-size: 14.5px; cursor: pointer; }
  .wz-scgo[hidden] { display: none; }
  .wz-promise { padding: 16px 18px; border-radius: 18px; background: var(--accent-soft); font-size: 13px; color: var(--ink-2); }
  .wz-promise b { display: block; margin-bottom: 6px; font-size: 14px; color: var(--ink); }
  .wz-promise ul { margin: 0; padding-left: 18px; display: grid; gap: 3px; }

  /* phones: the cart bar at the bottom of the screen */
  .wz-cbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; display: none; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 12px; padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px)); background: var(--surface); border-top: 1px solid var(--line); box-shadow: 0 -12px 30px -18px rgba(0, 0, 0, .35); }
  .wz-cbt { display: grid; min-width: 0; }
  .wz-cbt b { font-size: 14.5px; }
  .wz-cbt small { font-size: 12.5px; color: var(--ink-3); }
  .wz-cbar .wz-cgo { border: 0; background: var(--violet); color: var(--on-accent); font: inherit; font-weight: 800; cursor: pointer; }
  .wz-cbar .wz-cico { background: var(--accent-soft); }

  /* step 4 · the cart */
  .wz-cnote { margin: -8px 0 14px; font-size: 13.5px; color: var(--ink-2); }
  .wz-cnote[hidden] { display: none; }
  .wz-groups { display: grid; gap: 14px; }
  .wz-groups :global(.wz-grp) { border: 1px solid var(--line); border-radius: 18px; overflow: hidden; }
  .wz-groups :global(.wz-gh) { display: flex; align-items: center; gap: 12px; padding: 12px 16px; background: var(--tint); border-bottom: 1px solid var(--line); }
  .wz-groups :global(.wz-gi) { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 11px; background: var(--surface); color: var(--violet); flex: none; }
  .wz-groups :global(.wz-gi svg) { width: 20px; height: 20px; }
  .wz-groups :global(.wz-gt) { flex: 1; min-width: 0; display: grid; }
  .wz-groups :global(.wz-gt small) { font-size: 12.5px; color: var(--ink-3); }
  .wz-groups :global(.wz-fix) { padding: 6px 12px; border: 0; border-radius: 999px; background: #FFF4E5; color: #B45309; font: inherit; font-size: 12.5px; font-weight: 800; cursor: pointer; white-space: nowrap; }
  .wz-groups :global(.wz-fix:hover) { text-decoration: underline; }
  .wz-groups :global(.wz-gl) { display: grid; grid-template-columns: minmax(0, 1fr) auto auto 34px; align-items: center; gap: 12px; padding: 12px 16px; }
  .wz-groups :global(.wz-gl + .wz-gl) { border-top: 1px solid var(--line); }
  .wz-groups :global(.wz-gl b) { font-size: 14.5px; }
  .wz-groups :global(.wz-gp) { min-width: 84px; text-align: right; font-weight: 700; font-variant-numeric: tabular-nums; }
  .wz-groups :global(.wz-grm) { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid var(--line); border-radius: 10px; background: none; color: var(--ink-3); cursor: pointer; }
  .wz-groups :global(.wz-grm svg) { width: 17px; height: 17px; }
  .wz-groups :global(.wz-grm:hover) { color: #be123c; border-color: currentColor; }
  .wz-more { display: flex; align-items: center; justify-content: center; width: 100%; margin-top: 14px; padding: 14px; border: 1.5px dashed var(--line); border-radius: 18px; background: none; color: var(--violet); font: inherit; font-weight: 800; cursor: pointer; transition: background .2s, border-color .2s; }
  .wz-more:hover { border-color: var(--violet); background: var(--accent-soft); }
  .wz-extras { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 14px; margin-top: 20px; }
  .wz-xbox { display: grid; gap: 12px; align-content: start; padding: 18px; border: 1px solid var(--line); border-radius: 18px; }
  .wz-xbox h4 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; margin: 0; font-size: 16px; }
  .wz-xbox h4 small { font-size: 12.5px; font-weight: 500; color: var(--ink-3); }
  .wz-cpf { display: flex; gap: 8px; }
  .wz-cpf[hidden] { display: none; }
  .wz-cpf input { flex: 1; min-width: 0; height: 44px; padding: 0 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); color: var(--ink); font: inherit; font-size: 14.5px; outline: none; }
  .wz-cpf input:focus { border-color: var(--violet); }
  .wz-cpf button { padding: 0 18px; border: 0; border-radius: 12px; background: var(--violet); color: var(--on-accent); font: inherit; font-weight: 700; cursor: pointer; }
  .wz-cpok { margin: 0; padding: 9px 12px; border-radius: 10px; background: #E7F6EC; color: #166534; font-size: 13px; }
  .wz-cpok[hidden] { display: none; }
  .wz-cpok :global(button) { border: 0; background: none; padding: 0 0 0 4px; color: #be123c; font: inherit; text-decoration: underline; cursor: pointer; }
  .wz-cpnote { margin: 0; font-size: 12.5px; color: var(--ink-3); }

  /* step 5 · receipt with more than one device */
  .wz-sum ul :global(li.wz-sdev) { display: grid; gap: 0; margin-top: 4px; font-weight: 800; color: var(--ink); animation: none; }
  .wz-sum ul :global(li.wz-sdev small) { font-weight: 500; font-size: 12px; color: var(--ink-3); }

  @media (max-width: 900px) {
    .wz-body { grid-template-columns: minmax(0, 1fr); }
    .wz-side { display: none; }
    .wz-cbar:not([hidden]) { display: grid; }
    .wz-extras { grid-template-columns: minmax(0, 1fr); }
    /* while the cart bar shows, the chat / WhatsApp buttons and Spin & Win sit above it */
    :global(html.wz-cbar-on .fab), :global(html.wz-cbar-on .gift) { bottom: 88px; }
  }
  @media (max-width: 560px) {
    .wz-iss { display: grid; grid-template-columns: 42px minmax(0, 1fr); gap: 4px 12px; }
    .wz-ii { width: 42px; height: 42px; }
    .wz-act { grid-column: 2; justify-self: start; margin-top: 6px; }
    .wz-groups :global(.wz-gl) { grid-template-columns: minmax(0, 1fr) auto 34px; }
    .wz-groups :global(.wz-gp) { grid-column: 1; grid-row: 2; text-align: left; }
  }
  .wz-est { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr); gap: 20px; }
  .wz-sum, .wz-time { padding: 22px; border: 1px solid var(--line); border-radius: 20px; }
  .wz-dev-line { display: flex; align-items: center; gap: 12px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .wz-dev-line b { display: block; font-size: 16px; }
  .wz-dev-line small { font-size: 13px; color: var(--ink-3); }
  .wz-sum ul { list-style: none; margin: 12px 0; padding: 0; display: grid; gap: 8px; }
  .wz-sum ul :global(li) { display: flex; justify-content: space-between; font-size: 14.5px; }
  .wz-sum ul :global(b) { color: var(--lime); }
  .wz-total { display: flex; justify-content: space-between; align-items: baseline; padding-top: 12px; border-top: 1px dashed var(--line); font-weight: 700; }
  .wz-total b { font-family: var(--display); font-size: 24px; color: var(--lime); }
  .wz-note { margin-top: 10px; font-size: 12.5px; color: var(--ink-3); }
  .wz-time h4 { font-size: 16px; margin-bottom: 12px; }
  .wz-t { display: flex; align-items: center; gap: 12px; padding: 10px 0; }
  .wz-t[hidden] { display: none; }
  .wz-t b { display: block; font-size: 14.5px; }
  .wz-t small { font-size: 13px; color: var(--ink-2); }
  .wz-ti { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--accent-soft); color: var(--violet); flex: none; }
  .wz-ti svg { width: 20px; height: 20px; }
  .wz-onsite { font-size: 12.5px; color: var(--ink-3); }
  .wz-how { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .wz-how li { display: flex; align-items: flex-start; gap: 12px; }
  .wz-how li[hidden] { display: none; }
  .wz-how .wz-tt { display: grid; gap: 2px; }
  .wz-how .wz-tt b { font-size: 14.5px; }
  .wz-how .wz-tt small { font-size: 13px; color: var(--ink-3); line-height: 1.45; }
  .wz-next-steps { margin-top: 16px; padding-top: 14px; border-top: 1px dashed var(--line); }
  .wz-next-steps h5 { margin: 0 0 10px; font-size: 13px; letter-spacing: .04em; text-transform: uppercase; color: var(--ink-3); }
  .wz-next-steps ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; counter-reset: nx; }
  .wz-next-steps li { position: relative; display: grid; gap: 2px; padding-left: 34px; counter-increment: nx; }
  .wz-next-steps li::before { content: counter(nx); position: absolute; left: 0; top: 0; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--accent-soft, #eef2ff); color: var(--violet); font-size: 12.5px; font-weight: 800; }
  .wz-next-steps b { font-size: 14px; }
  .wz-next-steps small { font-size: 12.5px; color: var(--ink-3); line-height: 1.45; }
  .wz-acts { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 16px; }
  .wz-add, .wz-now { display: flex; align-items: center; justify-content: center; gap: 8px; height: 52px; border-radius: 14px; font-weight: 700; font-size: 14.5px; transition: transform .2s; }
  .wz-add { border: 1.5px solid var(--violet); background: var(--surface); color: var(--violet); }
  .wz-now { background: #25d366; color: #fff; box-shadow: 0 12px 24px -12px rgba(37,211,102,.9); }
