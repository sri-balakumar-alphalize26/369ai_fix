  .wz-next[hidden] { visibility: hidden; display: block; }

  .wz-cart { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 16px; padding: 14px 32px; border-top: 1px solid var(--line); background: var(--accent-soft); }
  .wz-cart[hidden] { display: none; }
  .wz-cico { position: relative; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 12px; background: var(--surface); color: var(--violet); }
  .wz-cico svg { width: 21px; height: 21px; }
  .wz-cico b { position: absolute; right: -6px; top: -6px; display: grid; place-items: center; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px; background: var(--violet); color: var(--on-accent); font-size: 11px; }
  .wz-citems { display: flex; gap: 8px; overflow-x: auto; }
  .wz-citems :global(.wz-chip) { display: inline-flex; align-items: center; gap: 8px; padding: 6px 6px 6px 12px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); font-size: 12.5px; color: var(--ink-2); white-space: nowrap; }
  .wz-citems :global(.wz-chip b) { color: var(--ink); }
  .wz-citems :global(.wz-chip button) { width: 20px; height: 20px; border: 0; border-radius: 50%; background: var(--tint-2); line-height: 1; }
  .wz-cgo { display: inline-flex; align-items: center; gap: 8px; padding: 12px 20px; border-radius: 999px; background: #25d366; color: #fff; font-weight: 700; font-size: 14px; white-space: nowrap; }
  .wz-cgo svg { width: 18px; height: 18px; }

  @media (max-width: 900px) {
    .wz-steps { padding: 20px 12px 16px; }
    .wz-rail { left: 12.5%; right: 12.5%; top: 39px; }
    .wz-step button span:last-child { font-size: 11.5px; }
    .wz-panel { padding: 22px 18px; }
    .wz-bm, .wz-est { grid-template-columns: 1fr; }
    .wz-foot, .wz-cart { padding: 14px 18px; }
    .wz-cart { grid-template-columns: auto 1fr; }
    .wz-cgo { grid-column: 1 / -1; justify-content: center; }
    .wz-crumb { display: none; }
  }

  /* step 4 · your details */
  .wz-who { margin-top: 20px; padding: 22px; border: 1px solid var(--line); border-radius: 20px; }
  .wz-who h4 { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 10px; font-size: 16px; margin: 0 0 14px; }
  .wz-who h4 small { font-size: 13px; font-weight: 500; color: var(--ink-3); }
  .wz-f { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }
  .wz-fl { display: grid; gap: 6px; min-width: 0; }
  .wz-fl > span { font-size: 13px; font-weight: 700; color: var(--ink-2); }
  .wz-fl select, .wz-fl input { width: 100%; min-width: 0; height: 48px; padding: 0 14px; border: 1px solid var(--line); border-radius: 12px; background: var(--surface); color: var(--ink); font: inherit; font-size: 15px; outline: none; transition: border-color .2s, box-shadow .2s; }
  .wz-fl select:focus, .wz-fl input:focus { border-color: var(--violet); box-shadow: 0 0 0 4px color-mix(in srgb, var(--violet) 14%, transparent); }
  .wz-fl .bad { border-color: #F43F5E !important; box-shadow: 0 0 0 4px rgba(244, 63, 94, .12) !important; }
  .wz-ph { display: flex; gap: 8px; }
  .wz-ph select { flex: none; width: 128px; padding: 0 8px; font-size: 14px; }
  .wz-ph input { flex: 1; }
  .wz-err { display: flex; align-items: flex-start; gap: 9px; margin: 14px 0 0; padding: 10px 12px; border-radius: 12px; background: linear-gradient(90deg, #FFF1F2, #FFF7F7); border: 1px solid #FECDD3; box-shadow: inset 3px 0 0 #E11D48; color: #9F1239; font-size: 13.5px; font-weight: 600; line-height: 1.4; animation: wzErrIn .28s cubic-bezier(.2,.9,.3,1.2); }
  .wz-err[hidden] { display: none; }
  .wz-err svg { width: 18px; height: 18px; flex: none; color: #E11D48; }
  .wz-err.shake { animation: wzErrIn .28s cubic-bezier(.2,.9,.3,1.2), wzShake .42s .05s ease-in-out; }
  @keyframes wzErrIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: none; } }
  @keyframes wzShake { 20% { translate: -6px; } 40% { translate: 5px; } 60% { translate: -3px; } 80% { translate: 2px; } }
  .wz-now { border: 0; font: inherit; font-weight: 700; cursor: pointer; }
  @media (max-width: 640px) { .wz-f, .wz-acts { grid-template-columns: 1fr; } .wz-who { padding: 18px; } }
  /* ===== redesign: step 2 brand & model ===== */
  .wz-brand { position: relative; padding: 12px 14px; border-radius: 18px; box-shadow: 0 1px 2px rgba(16,24,40,.04); transition: border-color .25s, transform .25s cubic-bezier(.3,1.4,.5,1), box-shadow .25s, background .25s; }
  .wz-panel.on .wz-brand:not([hidden]) { animation: wzPop .45s cubic-bezier(.2,.9,.3,1.2) both; animation-delay: calc(var(--i, 0) * 45ms); }
  .wz-brand:hover { transform: translateY(-3px); border-color: hsl(var(--h) 70% 60% / .55); box-shadow: 0 14px 26px -18px hsl(var(--h) 60% 40% / .55); }
  .wz-brand.on { border-color: transparent; background: linear-gradient(var(--surface), var(--surface)) padding-box, linear-gradient(135deg, hsl(var(--h) 85% 62%), hsl(calc(var(--h) + 50) 85% 66%)) border-box; box-shadow: 0 14px 28px -18px hsl(var(--h) 70% 45% / .6); }
  .wz-mono { width: 46px; height: 46px; border-radius: 14px; background: linear-gradient(135deg, hsl(var(--h) 90% 94%), hsl(calc(var(--h) + 40) 90% 90%)); font-size: 18px; transition: transform .3s; }
  .wz-mono.logo { width: 62px; border-radius: 14px; background: #fff; box-shadow: inset 0 0 0 1px var(--line); }
  .wz-mono img { max-width: 52px; max-height: 26px; object-fit: contain; }
  .wz-lmask { display: block; width: 52px; height: 26px; background: var(--c); -webkit-mask: center / contain no-repeat; mask: center / contain no-repeat; }
  .wz-brand:hover .wz-mono { transform: rotate(-6deg) scale(1.06); }
  .wz-bt { flex: 1; min-width: 0; }
  .wz-bck { position: absolute; top: -7px; right: -7px; display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: linear-gradient(135deg, hsl(var(--h) 85% 58%), hsl(calc(var(--h) + 50) 85% 62%)); color: #fff; box-shadow: 0 6px 12px -4px hsl(var(--h) 70% 45% / .6); transform: scale(0); transition: transform .35s cubic-bezier(.3,1.8,.5,1); }
  .wz-bck svg { width: 13px; height: 13px; }
  .wz-brand.on .wz-bck { transform: scale(1); }
  .wz-models { position: relative; padding: 16px; border-radius: 22px; background: linear-gradient(160deg, hsl(var(--mh, 210) 90% 97%), hsl(calc(var(--mh, 210) + 40) 85% 95%)); border: 1px solid hsl(var(--mh, 210) 60% 88%); transition: background .4s, border-color .4s; }
  .wz-models.empty .wz-mhint, .wz-models.empty .wz-mlist { display: none; }
  .wz-mempty { display: none; }
  .wz-models.empty .wz-mempty { display: grid; justify-items: center; gap: 4px; padding: 30px 10px 18px; text-align: center; }
  .wz-mempty b { font-size: 15.5px; color: var(--ink-2); }
  .wz-mempty small { font-size: 13px; color: var(--ink-3); }
  .wz-mpoint { display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: 8px; border-radius: 16px; background: #fff; color: hsl(var(--mh, 210) 70% 52%); box-shadow: 0 10px 22px -14px rgba(30,60,110,.45); animation: wzNudge 1.6s ease-in-out infinite; }
  .wz-mpoint svg { width: 24px; height: 24px; }
  @keyframes wzNudge { 50% { transform: translateX(-8px); } }
  .wz-mlist li:not([hidden]) { animation: wzSlide .35s ease both; }
  .wz-model { border: 1px solid transparent; border-radius: 12px; background: rgba(255,255,255,.85); }
  .wz-model:hover { border-color: hsl(var(--mh, 210) 70% 80%); background: #fff; }
  .wz-model.on { background: #fff; border-color: hsl(var(--mh, 210) 75% 60%); box-shadow: 0 8px 18px -14px hsl(var(--mh, 210) 70% 40% / .6); }
  .wz-skip { margin-top: auto; padding: 8px 12px; border-radius: 999px; background: rgba(255,255,255,.7); }
  .wz-skip:hover { background: #fff; }
  @keyframes wzPop { from { opacity: 0; transform: translateY(10px) scale(.96); } to { opacity: 1; transform: none; } }
  @keyframes wzSlide { from { opacity: 0; transform: translateX(10px); } to { opacity: 1; transform: none; } }

  /* ===== redesign: step 4 receipt, service cards, details ===== */
  .wz-panel[data-wz-panel="4"].on .wz-sum, .wz-panel[data-wz-panel="4"].on .wz-time, .wz-panel[data-wz-panel="4"].on .wz-who { animation: wzPop .5s cubic-bezier(.2,.9,.3,1.1) both; }
  .wz-panel[data-wz-panel="4"].on .wz-time { animation-delay: .08s; }
  .wz-panel[data-wz-panel="4"].on .wz-who { animation-delay: .16s; }
  .wz-sum { position: relative; padding: 0; overflow: hidden; border-radius: 22px; background: var(--surface); box-shadow: 0 18px 40px -30px rgba(30,60,110,.4); }
  .wz-rhead { display: flex; align-items: center; gap: 14px; padding: 20px 22px; background: linear-gradient(135deg, hsl(var(--eh, 210) 90% 95%), hsl(calc(var(--eh, 210) + 45) 90% 93%)); }
  .wz-rhead .wz-di.sm { width: 54px; height: 54px; border-radius: 16px; background: #fff; color: hsl(var(--eh, 210) 65% 48%); box-shadow: 0 10px 22px -14px hsl(var(--eh, 210) 60% 40% / .6); animation: wzFloat 3.2s ease-in-out infinite; }
  @keyframes wzFloat { 50% { transform: translateY(-4px) rotate(-3deg); } }
  .wz-rhead b { display: block; font-size: 17px; color: var(--ink); }
  .wz-rhead small { font-size: 13px; color: var(--ink-2); }
  .wz-rk { display: block; font-size: 11px !important; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: hsl(var(--eh, 210) 55% 45%) !important; }
  .wz-sum ul { margin: 0; padding: 16px 22px 6px; gap: 10px; }
  .wz-sum ul :global(li) { align-items: center; animation: wzSlide .35s ease both; animation-delay: calc(var(--i, 0) * 70ms + .2s); }
  .wz-sum ul :global(li > span) { display: flex; align-items: center; gap: 10px; color: var(--ink-2); }
  .wz-sum ul :global(.wz-ok) { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: #DCFCE7; color: #16A34A; flex: none; }
  .wz-sum ul :global(.wz-ok svg) { width: 11px; height: 11px; }
  .wz-tear { position: relative; height: 18px; margin: 8px 0 0; }
  .wz-tear::before { content: ''; position: absolute; left: 22px; right: 22px; top: 50%; border-top: 2px dashed var(--line); }
  .wz-tear::after { content: ''; position: absolute; inset: 0 -9px; background: radial-gradient(circle at 0 50%, var(--tint) 9px, transparent 10px), radial-gradient(circle at 100% 50%, var(--tint) 9px, transparent 10px); }
  .wz-total { margin: 0; padding: 8px 22px 0; border: 0; }
  .wz-total b { background: linear-gradient(90deg, var(--violet), hsl(var(--eh, 210) 80% 60%), var(--violet)); background-size: 200% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: wzShine 3s linear infinite; }
  @keyframes wzShine { to { background-position: -200% 0; } }
  .wz-note { display: flex; align-items: center; gap: 8px; margin: 10px 22px 20px; padding: 9px 12px; border-radius: 12px; background: var(--tint); }
  .wz-note svg { width: 16px; height: 16px; flex: none; color: #16A34A; }
  .wz-time { border-radius: 22px; background: var(--surface); }
  .wz-tcards { display: grid; gap: 12px; }
  .wz-t { position: relative; width: 100%; padding: 14px; border: 1.5px solid var(--line); border-radius: 16px; background: var(--surface); text-align: left; font: inherit; cursor: pointer; transition: border-color .25s, background .25s, transform .25s, opacity .25s, box-shadow .25s; }
  .wz-t:hover:not(:disabled) { transform: translateY(-2px); }
  .wz-t[aria-checked='false'] { opacity: .72; }
  .wz-t[aria-checked='true'] { opacity: 1; border-color: color-mix(in srgb, var(--violet) 55%, white); background: color-mix(in srgb, var(--violet) 6%, var(--surface)); box-shadow: 0 14px 28px -22px var(--violet); }
  .wz-t:disabled { cursor: not-allowed; }
  .wz-tt { flex: 1; min-width: 0; }
  .wz-t[aria-checked='true'] .wz-ti { background: linear-gradient(135deg, #7CC4FA, #4A9BEF); color: #fff; box-shadow: 0 8px 16px -10px #4A9BEF; }
  .wz-ti { transition: background .25s, color .25s; }
  .wz-tpick { position: absolute; top: -9px; right: 12px; display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px; background: #DCFCE7; color: #15803D; font-size: 11.5px; font-weight: 800; transform: scale(0); transition: transform .35s cubic-bezier(.3,1.8,.5,1); }
  .wz-tpick i { width: 7px; height: 7px; border-radius: 50%; background: #22C55E; animation: wzLive 1.4s ease-in-out infinite; }
  @keyframes wzLive { 50% { box-shadow: 0 0 0 5px rgba(34,197,94,.18); } }
  .wz-t[aria-checked='true'] .wz-tpick { transform: scale(1); }
  .wz-who { border-radius: 22px; background: linear-gradient(180deg, var(--surface), color-mix(in srgb, var(--violet) 3%, var(--surface))); }
  .wz-who h4 { align-items: center; }
  .wz-hico { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; background: color-mix(in srgb, var(--violet) 12%, var(--surface)); color: var(--violet); }
  .wz-hico svg { width: 17px; height: 17px; }
  .wz-f { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .wz-ic { position: relative; display: block; }
  .wz-ic > svg { position: absolute; z-index: 2; left: 13px; top: 50%; width: 17px; height: 17px; translate: 0 -50%; color: var(--ink-3); pointer-events: none; transition: color .2s; }
  .wz-ic select, .wz-ic input { padding-left: 38px !important; }
  .wz-ic:focus-within > svg { color: var(--violet); }
  .wz-now { position: relative; overflow: hidden; }
  .wz-now::after { content: ''; position: absolute; top: 0; left: -60%; width: 40%; height: 100%; background: linear-gradient(100deg, transparent, rgba(255,255,255,.45), transparent); transform: skewX(-20deg); animation: igShineWz 3.2s ease-in-out infinite; }
  @keyframes igShineWz { 0%, 55% { left: -60%; } 100% { left: 140%; } }
  @media (max-width: 900px) { .wz-f { grid-template-columns: 1fr 1fr; } .wz-f > :last-child { grid-column: 1 / -1; } }
  @media (max-width: 640px) { .wz-f { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) { .wz-brand, .wz-mlist li, .wz-sum, .wz-time, .wz-who, .wz-sum ul :global(li), .wz-mpoint, .wz-rhead .wz-di.sm, .wz-total b, .wz-now::after, .wz-tpick i { animation: none !important; } }
