        <!-- phones: the cart rides along at the bottom of the screen while the wizard is in view -->
        <div class="wz-cbar" data-wz-cbar hidden>
          <span class="wz-cico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 3.5h2.2l2.4 11.2a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.1l1.8-7.3H6"/><circle cx="9.5" cy="19.8" r="1.4"/><circle cx="17" cy="19.8" r="1.4"/></svg><b data-wz-cbn>0</b></span>
          <span class="wz-cbt"><b data-wz-cbt></b><small data-wz-cbp></small></span>
