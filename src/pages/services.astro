              <label class="wz-fl"><span>Your name</span><span class="wz-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg><input data-wz-name autocomplete="name" placeholder="Full name" maxlength="60" /></span></label>
              <div class="wz-fl"><span>Mobile number</span>
                <div class="wz-ph">
                  <select data-wz-cc aria-label="Country code">{DIAL.map((d) => <option value={d.cc} selected={d.cc === 'om'}>{d.code} {d.name}</option>)}</select>
                  <input data-wz-phone inputmode="tel" maxlength="16" autocomplete="tel-national" placeholder="9123 4567" aria-label="Mobile number" />
