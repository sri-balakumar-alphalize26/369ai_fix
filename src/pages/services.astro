  .wz-mpoint { display: grid; place-items: center; width: 52px; height: 52px; margin-bottom: 8px; border-radius: 16px; background: #fff; color: hsl(var(--mh, 210) 70% 52%); box-shadow: 0 10px 22px -14px rgba(30,60,110,.45); animation: wzNudge 1.6s ease-in-out infinite; }
  .wz-mpoint svg { width: 24px; height: 24px; }
  @keyframes wzNudge { 50% { transform: translateX(-8px); } }
  .wz-mlist li:not([hidden]) { animation: wzSlide .35s ease both; }
  .wz-model { border: 1px solid transparent; border-radius: 12px; background: rgba(255,255,255,.85); }
  .wz-model:hover { border-color: hsl(var(--mh, 210) 70% 80%); background: #fff; }
  .wz-model.on { background: #fff; border-color: hsl(var(--mh, 210) 75% 60%); box-shadow: 0 8px 18px -14px hsl(var(--mh, 210) 70% 40% / .6); }
  .wz-skip { margin-top: auto; padding: 8px 12px; border-radius: 999px; background: rgba(255,255,255,.7); }
  .wz-skip:hover { background: #fff; }
  @keyframes wzPop { from { opacity: 0; transform: translateY(10px) scale(.96); } to { opacity: 1; transform: none; } }
  @keyframes wzSlide { from { opacity: 0; transform: translateX(10px); } to { opacity: 1; transform: none; } }

  /* ===== redesign: step 4 receipt, service cards, details ===== */
  .wz-panel[data-wz-panel="5"].on .wz-sum, .wz-panel[data-wz-panel="5"].on .wz-time, .wz-panel[data-wz-panel="5"].on .wz-who { animation: wzPop .5s cubic-bezier(.2,.9,.3,1.1) both; }
  .wz-panel[data-wz-panel="5"].on .wz-time { animation-delay: .08s; }
  .wz-panel[data-wz-panel="5"].on .wz-who { animation-delay: .16s; }
  .wz-sum { position: relative; padding: 0; overflow: hidden; border-radius: 22px; background: var(--surface); box-shadow: 0 18px 40px -30px rgba(30,60,110,.4); }
  .wz-rhead { display: flex; align-items: center; gap: 14px; padding: 20px 22px; background: linear-gradient(135deg, hsl(var(--eh, 210) 90% 95%), hsl(calc(var(--eh, 210) + 45) 90% 93%)); }
  .wz-rhead .wz-di.sm { width: 54px; height: 54px; border-radius: 16px; background: #fff; color: hsl(var(--eh, 210) 65% 48%); box-shadow: 0 10px 22px -14px hsl(var(--eh, 210) 60% 40% / .6); animation: wzFloat 3.2s ease-in-out infinite; }
  @keyframes wzFloat { 50% { transform: translateY(-4px) rotate(-3deg); } }
  .wz-rhead b { display: block; font-size: 17px; color: var(--ink); }
  .wz-rhead small { font-size: 13px; color: var(--ink-2); }
  .wz-rk { display: block; font-size: 11px !important; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: hsl(var(--eh, 210) 55% 45%) !important; }
  .wz-sum ul { margin: 0; padding: 16px 22px 6px; gap: 10px; }
  .wz-sum ul :global(li) { align-items: center; animation: wzSlide .35s ease both; animation-delay: calc(var(--i, 0) * 70ms + .2s); }
  .wz-sum ul :global(li > span) { display: flex; align-items: center; gap: 10px; color: var(--ink-2); }
  .wz-sum ul :global(.wz-ok) { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: #DCFCE7; color: #16A34A; flex: none; }
  .wz-sum ul :global(.wz-ok svg) { width: 11px; height: 11px; }
  .wz-tear { position: relative; height: 18px; margin: 8px 0 0; }
  .wz-tear::before { content: ''; position: absolute; left: 22px; right: 22px; top: 50%; border-top: 2px dashed var(--line); }
  .wz-tear::after { content: ''; position: absolute; inset: 0 -9px; background: radial-gradient(circle at 0 50%, var(--tint) 9px, transparent 10px), radial-gradient(circle at 100% 50%, var(--tint) 9px, transparent 10px); }
  .wz-total { margin: 0; padding: 8px 22px 0; border: 0; }
  .wz-total b { background: linear-gradient(90deg, var(--violet), hsl(var(--eh, 210) 80% 60%), var(--violet)); background-size: 200% 100%; -webkit-background-clip: text; background-clip: text; color: transparent; animation: wzShine 3s linear infinite; }
  @keyframes wzShine { to { background-position: -200% 0; } }
  .wz-note { display: flex; align-items: center; gap: 8px; margin: 10px 22px 20px; padding: 9px 12px; border-radius: 12px; background: var(--tint); }
  .wz-note svg { width: 16px; height: 16px; flex: none; color: #16A34A; }
  .wz-time { border-radius: 22px; background: var(--surface); }
  .wz-tcards { display: grid; gap: 12px; }
  .wz-t { position: relative; width: 100%; padding: 14px; border: 1.5px solid var(--line); border-radius: 16px; background: var(--surface); text-align: left; font: inherit; cursor: pointer; transition: border-color .25s, background .25s, transform .25s, opacity .25s, box-shadow .25s; }
  .wz-t:hover:not(:disabled) { transform: translateY(-2px); }
  .wz-t[aria-checked='false'] { opacity: .72; }
  .wz-t[aria-checked='true'] { opacity: 1; border-color: color-mix(in srgb, var(--violet) 55%, white); background: color-mix(in srgb, var(--violet) 6%, var(--surface)); box-shadow: 0 14px 28px -22px var(--violet); }
