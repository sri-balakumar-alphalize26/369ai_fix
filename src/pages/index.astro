---
import Base from '../layouts/Base.astro';
import MediaFrame from '../components/MediaFrame.astro';
import HeroSearch from '../components/HeroSearch.astro';
import AdminGate from '../components/AdminGate.astro';
import DeviceArt from '../components/DeviceArt.astro';
import { artFor, note } from '../data/menu';

import { photo } from '../data/photos';
const WA = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg>';
// Tiles: printer and CCTV left out on request
const tiles = categories.filter((c) => c.id !== 'printer' && c.id !== 'cctv');
const short = (n: string) => n.replace(' & MacBooks', '').replace(' & All-in-ones', '').replace(' & iPads', '').replace(' Installation', '').replace(' & Wi-Fi', '');
const rowsOf = <T,>(a: T[]) => { const n = Math.floor(a.length / 2); return [a.filter((_, i) => i % 2 === 0).slice(0, n), a.filter((_, i) => i % 2 === 1).slice(0, n).reverse()]; };
const mostBooked = Object.entries(photo).map(([k, ph]) => {
  const [cid, iss] = k.split(':');
  const cat = categories.find((x) => x.id === cid)!;
  const short = cat.name.replace(' & MacBooks', '').replace(' & All-in-ones', '').replace(' & iPads', '').replace(/s$/, '');
  return { photo: ph, iss, dev: short, devFull: cat.name, note: note(iss), wa: wa(`Hi Danat Fix, I want to book a ${iss} service for my ${short.toLowerCase()}.`) };
});const heroCopy: Record<string, [string, string]> = {
  mobile: ['Keep Your Phone Working Like New', 'Screen, battery, charging, camera and more – quick and reliable service.'],
  tablet: ['Your Tablet, Good as New', 'Cracked glass, batteries and charging faults fixed fast.'],
  laptop: ['Laptop Trouble? Sorted.', 'Screens, keyboards, hinges, batteries and board-level repair.'],
  desktop: ['Desktops Back to Full Speed', 'Power, boards, upgrades and clean OS installs.'],
  printer: ['Printers That Just Work', 'Jams, print quality, toner and setup – serviced on-site.'],
  cctv: ['Security You Can See', 'Survey, install and remote viewing for homes and shops.'],
  network: ['Wi-Fi in Every Room', 'Mesh, routers, cabling and office networks.'],
  data: ['Get Your Files Back', 'Deleted files, dead drives and formatted disks recovered.'],
  itsupport: ['IT Help When You Need It', 'Software, email, tune-ups and maintenance plans.'],
};
const issueIcon = (s: string) => {
  const t = s.toLowerCase();
  const I: [RegExp, string][] = [
    [/back glass/, '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><circle cx="10" cy="7" r="1.6"/><circle cx="14" cy="7" r="1.6"/>'],
    [/screen|glass|display/, '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M9 6l6 6M9 11l3 3"/>'],
    [/battery/, '<rect x="7" y="4" width="10" height="17" rx="2"/><path d="M10 2h4M12 9l-2 4h4l-2 4"/>'],
    [/charg|power/, '<path d="M9 3v5M15 3v5M6 8h12v3a6 6 0 0 1-12 0zM12 17v4"/>'],
    [/camera|cctv|viewing|dvr/, '<path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>'],
    [/water|fire/, '<path d="M12 3s6 7 6 11a6 6 0 0 1-12 0c0-4 6-11 6-11z"/>'],
    [/speaker|micro/, '<path d="M4 9h4l5-4v14l-5-4H4zM17 9a4 4 0 0 1 0 6"/>'],
    [/wi-?fi|router|mesh|lan|network|switch/, '<path d="M2 9a15 15 0 0 1 20 0M5.5 12.5a10 10 0 0 1 13 0M9 16a5 5 0 0 1 6 0"/><circle cx="12" cy="19.5" r="1"/>'],
    [/drive|ssd|ram|disk|deleted|format|recover/, '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3 14h18"/>'],
    [/paper|toner|cartridge|roller|print/, '<path d="M7 9V3.5h10V9"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v6.5H7z"/>'],
  ];
  return I.find(([re]) => re.test(t))?.[1] ?? '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-.5-.5-2.5z"/>';
};
import { reviews, sample } from '../data/reviews';
import Testimonials from '../components/Testimonials.astro';
import { serviceModes, price, site } from '../data/site';
import { categories, totals, iconPaths } from '../data/devices';
import { coverage } from '../data/coverage';
import { homeServices, milestones, awards, awardsSample, wa } from '../data/home';
import { statSync } from 'node:fs';

const stamp = (f: string) => { try { return `/media/${f}?v=${Math.floor(statSync(`public/media/${f}`).mtimeMs / 1000)}`; } catch { return `/media/${f}`; } };
const heroVideo = stamp('kling.mp4');
const heroPoster = stamp('kling.jpg');
const coverageCount = new Set(Object.values(coverage).flatMap((m) => m.zones.flatMap((z) => z.areas))).size;

const allBrands = [...new Set(categories.flatMap((c) => c.brands.map((b) => b.name)))];
// Brand logo strip. Logos self-hosted in public/brand/makers (Simple Icons, CC0; others from
// Wikimedia Commons). `c` = brand colour for single-colour marks (CSS mask); none = full-colour image.
const makers: { n: string; f?: string; c?: string; w?: number; what: string }[] = [
  { n: 'Apple', f: 'apple', c: '#000000', w: 34, what: 'iPhone · iPad · Mac' },
  { n: 'Samsung', f: 'samsung', c: '#1428A0', w: 124, what: 'Galaxy phones & tabs' },
  { n: 'Google', f: 'google', c: '#4285F4', w: 32, what: 'Pixel phones' },
  { n: 'Xiaomi', f: 'xiaomi', c: '#FF6900', w: 34, what: 'Xiaomi & Redmi' },
  { n: 'OnePlus', f: 'oneplus', c: '#F5010C', w: 34, what: 'Phones & tablets' },
  { n: 'vivo', f: 'vivo', c: '#415FFF', w: 100, what: 'Smartphones' },
  { n: 'OPPO', f: 'oppo', c: '#2D683D', w: 108, what: 'Smartphones' },
  { n: 'realme', f: 'realme', w: 1.7, what: 'Smartphones' },
  { n: 'iQOO', f: 'iqoo', w: 1.6, what: 'Smartphones' },
  { n: 'Motorola', f: 'motorola', c: '#E1140A', w: 36, what: 'Smartphones' },
  { n: 'Nothing', f: 'nothing', w: 2.2, what: 'Phones' },
  { n: 'Lenovo', f: 'lenovo', c: '#E2231A', w: 112, what: 'Laptops & tablets' },
  { n: 'Dell', f: 'dell', c: '#007DB8', w: 38, what: 'Laptops & desktops' },
  { n: 'HP', f: 'hp', c: '#0096D6', w: 36, what: 'Laptops & printers' },
  { n: 'ASUS', f: 'asus', c: '#000000', w: 108, what: 'Laptops' },
  { n: 'Acer', f: 'acer', c: '#83B81A', w: 100, what: 'Laptops' },
  { n: 'MSI', f: 'msi', c: '#FF0000', w: 40, what: 'Gaming laptops' },
  { n: 'Microsoft', f: 'windows', c: '#0078D4', w: 32, what: 'Windows PCs' },
  { n: 'Canon', f: 'canon', w: 2, what: 'Printers' },
  { n: 'Epson', f: 'epson', c: '#003399', w: 108, what: 'Printers' },
  { n: 'Brother', f: 'brother', w: 2, what: 'Printers' },
  { n: 'Hikvision', f: 'hikvision', w: 2.2, what: 'CCTV' },
  { n: 'Dahua', f: 'dahua', w: 2, what: 'CCTV' },
  { n: 'CP PLUS', what: 'CCTV' },
  { n: 'TP-Link', f: 'tplink', c: '#4ACBD6', w: 36, what: 'Wi-Fi & routers' },
  { n: 'Ubiquiti', f: 'ubiquiti', c: '#0559C9', w: 34, what: 'Networks' },
  { n: 'Cisco', f: 'cisco', c: '#1BA0D7', w: 68, what: 'Networks' },
  { n: 'NETGEAR', f: 'netgear', c: '#2C262D', w: 128, what: 'Wi-Fi & routers' },
  { n: 'D-Link', f: 'dlink', w: 2, what: 'Wi-Fi & routers' },
];
const brandRows = [makers.filter((_, i) => i % 2 === 0), makers.filter((_, i) => i % 2 === 1)];
const formats = [
  { id: 'image', label: 'Image' },
  { id: 'post', label: 'Post' },
  { id: 'video', label: 'Video' },
] as const;
const angles = [
  { id: 'flat', label: '0° Flat' },
  { id: 'tilt', label: '15° Tilt' },
  { id: 'iso', label: '3D Isometric' },
] as const;
// Home shows a small mix; the full list lives on /services
const homePicks = ['screen', 'battery', 'tab-screen', 'lap-screen', 'lap-keyboard', 'desk-power-on', 'desk-ssd', 'water'].map((ph) => mostBooked.find((m) => m.photo === ph)).filter((m): m is (typeof mostBooked)[number] => !!m);
// Two equal-length lines so their cards stay in the same columns while moving
const [rowA, rowB] = rowsOf(mostBooked);
---

<Base>
  <!-- ============ HERO: background video + Book Your Slot ============ -->
  <section class="vhero">
    <video class="vhero-video" src={heroVideo} poster={heroPoster} autoplay muted loop playsinline preload="metadata" aria-hidden="true"></video>
    <div class="vhero-shade" aria-hidden="true"></div>
    <div class="wrap vhero-in">
      <span class="eyebrow" data-reveal>Doorstep electronics repair · {site.country}</span>
      <h1 class="h-xl" data-reveal style="--d:.08s">Your Technology. <span class="grad-text">Fixed Right.</span></h1>
      <p class="devices-line" data-reveal style="--d:.12s">Phone &bull; Laptop &bull; Computer &bull; Printer &bull; CCTV &bull; Networking</p>
      <div class="vhero-cta" data-reveal style="--d:.18s">
        <a href="#book-services" class="btn btn-primary btn-xl" data-scroll>
          Book Your Slot
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M6 13l6 6 6-6"/></svg>
        </a>
        <a href={wa('Hi Danat Fix, I want to book a repair.')} target="_blank" rel="noopener" class="btn btn-wa"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg> WhatsApp us</a>
      </div>
      <div class="vhero-search" data-reveal style="--d:.24s"><HeroSearch /></div>
      <ul class="hero-facts" data-reveal style="--d:.3s">
        <li><b data-count={homeServices.length} data-suffix="+">{homeServices.length}+</b> services</li>
        <li><b data-count={site.branches.length}>{site.branches.length}</b> branches</li>
        <li><b data-count={site.since} data-from="1990">{site.since}</b> since</li>
      </ul>
    </div>
    <a href="#book-services" class="vhero-down" data-scroll aria-label="Scroll to services"><span></span></a>
  </section>

  <!-- ============ WHAT CAN WE FIX (Urban Company style) ============ -->
  <section class="section" id="book-services">
    <div class="wrap uc">
      <div class="uc-head" data-reveal>
        <div>
          <span class="uc-badge"><i></i>{tiles.length} services · doorstep &amp; pickup</span>
          <h2>What can we fix for you?</h2>
        </div>
      </div>
      <div class="uc-cats" data-reveal>
        {tiles.map((c, i) => (
          <a class="uc-cat" href={`/services?cat=${c.id}#catalog`} style={`--h:${c.hue}; --i:${i}`}>
            <span class="uc-ci"><DeviceArt kind={artFor[c.id]} /></span>
            <span>{short(c.name)}</span>
          </a>
        ))}
      </div>

      <div class="uc-most" data-reveal style="--d:.08s">
        <div class="uc-mh">
          <div><h3>Most booked repairs</h3><p>Doorstep or pickup · estimate {price()}</p></div>
          <div class="uc-nav">
            <button type="button" data-uc-prev aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
            <button type="button" data-uc-next aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
          </div>
        </div>
        <div class="uc-rows">
          {[0].map((r) => (
            <div class="uc-rail" data-uc-rail data-dir="1">
              {[false, true].flatMap((copy) => homePicks.map((m) => (
                <article class="uc-card" aria-hidden={copy ? 'true' : undefined}>
                  <div class="uc-img">
                    <img src={`/media/repairs/${m.photo}.jpg`} alt={m.iss} loading="lazy" width="360" height="240" />
                    <span class="uc-tag">{m.dev}</span>
                  </div>
                  <div class="uc-body">
                    <b>{m.iss}</b>
                    <small>{m.note}</small>
                    <div class="uc-foot">
                      <span><em>{price()}</em></span>
                      <a class="uc-wa" target="_blank" rel="noopener" href={m.wa} aria-label={`Book ${m.iss} on WhatsApp`} set:html={WA} />
                      <button type="button" class="uc-add" data-uc-add data-dev={m.devFull} data-iss={m.iss}><span class="p">+</span><span class="t">Add</span></button>
                    </div>
                  </div>
                </article>
              )))}
            </div>
          ))}
        </div>
        <div class="uc-more"><a class="uc-all" href="/services#all">View all services <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a></div>
      </div>
    </div>
  </section>
  <!-- ============ SERVICE MODES (short) ============ -->
  <section class="section tight-sec">
    <div class="wrap">
      <div class="modes">
        {serviceModes.map((m, i) => (
          <a href={`/services?mode=${m.id}#coverage`} class="mode glass" data-reveal style={`--d:${.1 + i * .1}s`}>
            <span class="mode-icon" aria-hidden="true">
              {m.id === 'doorstep' ? (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
              ) : (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="17" r="3"/><circle cx="18" cy="17" r="3"/><path d="M6 17h5l3-7h4M14 10l-2-3H9"/></svg>
              )}
            </span>
            <h3 class="h-md">{m.title}</h3>
            <ol class="mode-steps">
              {m.steps.map((s, n) => <li><span>{n + 1}</span>{s}</li>)}
            </ol>
            <span class="mode-foot">Check your area <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ BRAND MARQUEE ============ -->
  <section class="brands-band" aria-label="Brands we repair">
    <div class="wrap bb-head" data-reveal>
      <div>
        <span class="bb-kick"><i></i>Brands we repair</span>
        <h2 class="bb-title">All the big names, <span>one trusted fix.</span></h2>
      </div>
      <ul class="bb-stats">
        <li><b data-count={makers.length} data-suffix="+">{makers.length}+</b><small>brands</small></li>
        <li><b data-count="9">9</b><small>device types</small></li>
      </ul>
    </div>
    <div class="bb-rows">
      {brandRows.map((row, r) => (
        <div class:list={['bb-row', { rev: r === 1 }]}>
          <div class="bb-track">
            {[...row, ...row].map((b, i) => (
              <figure class="bb-card" style={`--i:${i % row.length}; --bc:${b.c ?? '#0757B8'}`} aria-hidden={i >= row.length ? 'true' : undefined} title={`${b.n} — ${b.what}`}>
                <span class="bb-logo" style={`--s:${b.w ?? 34}px`}>
                  {b.f && b.c ? <i class="bb-mask" style={`--c:${b.c}; -webkit-mask-image:url(/brand/makers/${b.f}.svg); mask-image:url(/brand/makers/${b.f}.svg)`} role="img" aria-label={b.n}></i>
                    : b.f ? <img src={`/brand/makers/${b.f}.svg`} alt={b.n} loading="lazy" />
                    : <em class="bb-word">{b.n}</em>}
                </span>
                <figcaption><b>{b.n}</b><small>{b.what}</small></figcaption>
              </figure>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
  <!-- ============ WHAT OUR CLIENTS SAY ============ -->
  <section class="section" id="reviews">
    <Testimonials />
    <div class="wrap rv4">
      <div class="tst" data-tst>
        <div class="tst-intro">
          <span class="tst-eyebrow">Testimonials</span>
          <h2>What our clients say</h2>
          <p>Doorstep visits, pickups and installs across {site.country} — in our customers’ words.</p>
          {sample && <span class="tst-sample">Sample reviews — real ones coming soon</span>}
          <div class="tst-ctrl">
            <button type="button" data-tst-prev aria-label="Previous review"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
            <button type="button" data-tst-next aria-label="Next review"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
            <span class="tst-count"><b data-tst-n>01</b> / {String(reviews.length).padStart(2, '0')}</span>
          </div>
          <div class="tst-bar"><i data-tst-bar></i></div>
        </div>

        <div class="tst-stage">
          <div class="tst-deck" aria-live="polite">
            {reviews.map((r, i) => (
              <figure class="tq" data-tq={i}>
                <svg class="tq-mark" viewBox="0 0 48 48" aria-hidden="true"><path d="M20 10C11 13 6 20 6 29v9h14V24h-8c0-6 3-9 9-11zM42 10c-9 3-14 10-14 19v9h14V24h-8c0-6 3-9 9-11z" /></svg>
                <span class="tq-tag">{r.service}</span>
                <blockquote>{r.text}</blockquote>
                <figcaption>
                  <span class="tq-av">{r.area[0]}</span>
                  <span class="tq-who"><b>{r.name}</b><small>{r.area}</small></span>
                  <span class="tq-stars" aria-label={`${r.rating} out of 5`}>
                    {[1, 2, 3, 4, 5].map((n) => <svg viewBox="0 0 24 24" class:list={[{ off: n > r.rating }]}><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z" /></svg>)}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
          <div class="tst-tabs" role="tablist" aria-label="Choose a review">
            {reviews.map((r, i) => <button type="button" role="tab" data-tst-go={i}>{r.service}</button>)}
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- ============ ROADMAP ============ -->
  <section class="section" id="roadmap">
    <div class="wrap">
      <div class="center-head">
        <span class="eyebrow" data-reveal>Our journey</span>
        <h2 class="h-lg" data-reveal style="--d:.06s">From one shop to doorstep repair</h2>
      </div>
      <ol class="road">
        {milestones.map((m, i) => (
          <li class:list={['rm', { tbc: !m.verified || m.year === 'Year TBC' }]} data-reveal style={`--d:${i * .1}s`}>
            <span class="rm-dot" aria-hidden="true"></span>
            <span class="rm-year">{m.year}</span>
            <b>{m.title}</b>
            <small>{m.text}</small>
          </li>
        ))}
      </ol>
      <p class="rm-note">Years marked “TBC” are waiting for confirmation from {site.name}.</p>
    </div>
  </section>

  <!-- ============ TRUSTED PARTNERS ============ -->
  <section class="section pt-sec" id="partners">
    <div class="wrap">
      <div class="pt-head" data-reveal>
        <span class="pt-eyebrow">Trusted partners</span>
        <h2 class="pt-title"><em>Leading brands,</em> in safe hands</h2>
        <p>Companies that trust {site.name} with their devices, networks and IT support.</p>
      </div>
      <ul class="pt-logos" data-reveal style="--d:.1s">
        <li><img class="wide" src="/brand/partners/alphalize.png" alt="Alphalize" width="432" height="120" loading="lazy" /></li>
        <li><img src="/brand/partners/369aibiz.png" alt="369 ai.Biz" width="477" height="379" loading="lazy" /></li>
        <li><img class="wide" src="/brand/partners/nexgenpos.png" alt="Nex Genn POS" width="559" height="120" loading="lazy" /></li>
      </ul>
    </div>
  </section>

  <!-- ============ CTA ============ -->
  <section class="section">
    <div class="wrap">
      <div class="cta2" data-reveal>
        <i class="cta2-blob a" aria-hidden="true"></i><i class="cta2-blob b" aria-hidden="true"></i>
        <i class="cta2-dots a" aria-hidden="true"></i><i class="cta2-dots b" aria-hidden="true"></i>
        <span class="pt-eyebrow">Let's get started</span>
        <h2>Need a <em>repair or service?</em></h2>
        <p>From phones to laptops, printers to networking — our team is ready to help you get back to what matters.</p>
        <div class="cta2-go">
          <a href="/services#catalog" class="cta2-btn">
