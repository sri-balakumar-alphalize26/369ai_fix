  .bb-track { display: flex; gap: 14px; width: max-content; padding: 6px 0; animation: bbSlide 45s linear infinite; }
  /* track holds the row twice; sliding half its width (+ half a gap) loops seamlessly */
  @keyframes bbSlide { to { transform: translateX(calc(-50% - 7px)); } }
