---
// The link from WhatsApp when the price changed after the technician checked the device:
// /quote?o=<order>&t=<token>. Shows the old estimate and the new lines; Approve / Decline.
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="Approve the new price" description="The price for your repair changed after checking the device." quiet>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Your repair</span>
      <h1 class="h-xl">New <span class="grad-text">price</span></h1>
      <p class="lead" data-q-lead>Loading…</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap qs">
      <div class="qs-card" data-q-card hidden>
        <h3>After checking your device <small data-q-ref></small></h3>
        <ul data-q-lines></ul>
        <p class="qs-old">Estimate you agreed before: <b data-q-old></b></p>
        <p class="qs-parts" data-q-parts hidden></p>
        <p class="qs-office" data-q-office hidden>Your device is at our office.</p>
        <div class="qs-acts" data-q-acts>
          <button type="button" class="qs-btn" data-q-yes>Approve</button>
          <button type="button" class="qs-btn ghost" data-q-no>Decline</button>
        </div>
        <p class="qs-done" data-q-done hidden></p>
      </div>
      <p class="qs-msg" data-q-msg role="alert" hidden></p>
    </div>
  </section>
</Base>

<script>
  import { site } from '../data/site';
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const q = new URLSearchParams(location.search);
  const o = q.get('o') || '', t = q.get('t') || '';
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const msg = (m: string) => { const el = $('[data-q-msg]'); el.textContent = m; el.hidden = !m; };
  const ERR: Record<string, string> = {
    expired: `This link has expired — please call us on ${site.phone.display}.`,
    unknown: `This link doesn't work — please call us on ${site.phone.display}.`,
    cancelled: 'This booking is closed.',
  };
  const done = (text: string) => { $('[data-q-acts]').hidden = true; const d = $('[data-q-done]'); d.textContent = text; d.hidden = false; };

  async function load() {
    const r = await fetch(`/api/visit?page=quote&o=${encodeURIComponent(o)}&t=${encodeURIComponent(t)}`).then((x) => x.json()).catch(() => ({ ok: false }));
    if (!r.ok) { $('[data-q-lead]').textContent = ''; msg(ERR[r.error] || "We can't load this right now. Please try again in a minute."); return; }
    $('[data-q-card]').hidden = false;
    $('[data-q-lead]').textContent = `Hi ${r.customer || 'there'} — booking ${r.ref}.`;
    $('[data-q-ref]').textContent = r.ref;
    $('[data-q-lines]').innerHTML = r.lines.map((l: string) => `<li>${esc(l.replace(/^•\s*/, ''))}</li>`).join('');
    $('[data-q-old]').textContent = `${r.currency} ${Number(r.old_total || 0).toFixed(3)}`;
    const parts = $('[data-q-parts]');
    parts.hidden = !r.parts.length;
    parts.innerHTML = r.parts.length ? `<b>${esc(r.parts.join(', '))}</b> must be ordered first — approving lets us order it, and you pick a new visit time when it arrives.` : '';
    $('[data-q-office]').hidden = !r.at_office;
    if (r.state === 'accepted') done('Approved — thank you. We will go ahead with the repair.');
    else if (r.state === 'declined') done('You declined the new price. We will be in touch.');
    else if (r.state !== 'waiting') {
      // Opened before any new price was sent (or an old link): nothing to answer yet.
      $('[data-q-old]').closest('p')!.hidden = true;
      done('There is no new price waiting for you. If anything changes after checking your device, we will send you a link here.');
    }
  }

  async function answer(yes: boolean) {
    const r = await fetch('/api/visit', { method: 'POST', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ o, t, action: 'quote', yes }) }).then((x) => x.json()).catch(() => ({ ok: false }));
    if (!r.ok) { msg(ERR[r.error] || 'That did not work — please try again.'); return; }
    done(yes ? 'Approved — thank you. We will go ahead with the repair.' : 'You declined the new price. We will be in touch.');
  }
  $('[data-q-yes]').addEventListener('click', () => answer(true));
  $('[data-q-no]').addEventListener('click', () => answer(false));

  if (!o || !t) msg(ERR.unknown); else load();
</script>

<style>
  .qs { max-width: 680px; display: grid; gap: 14px; }
  .qs-card { padding: 22px; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); display: grid; gap: 10px; }
  .qs-card[hidden] { display: none; }
  .qs-card h3 { margin: 0; font-size: 18px; display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
  .qs-card h3 small { font-size: 13px; color: var(--ink-3); font-weight: 600; }
  .qs-card ul { margin: 0; padding-left: 18px; display: grid; gap: 4px; }
  /* the lines are drawn by the script (innerHTML), so :global; the last one is the total */
  .qs-card ul :global(li:last-child) { font-weight: 700; list-style: none; margin-left: -18px; padding-top: 6px; border-top: 1px dashed var(--line); }
  .qs-old, .qs-parts, .qs-office, .qs-done { margin: 0; }
  .qs-old { color: var(--ink-3); }
  .qs-acts { display: flex; flex-wrap: wrap; gap: 10px; }
  .qs-acts[hidden] { display: none; }
  .qs-btn { height: 48px; padding: 0 22px; border: 0; border-radius: 14px; background: var(--violet); color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  .qs-btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--line); }
  .qs-done { font-weight: 700; }
  .qs-msg { margin: 0; color: #9F1239; font-weight: 600; }
  .qs-msg[hidden] { display: none; }
</style>
