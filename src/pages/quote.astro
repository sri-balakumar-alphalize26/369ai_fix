---
// The link from WhatsApp when the price changed after the technician checked the device:
// /quote?o=<order>&t=<token>. Shows the old estimate and the new lines; Approve / Decline.
import Base from '../layouts/Base.astro';
import { getContent, contactOf } from '../lib/content';
import { hostOf } from '../lib/odoo';
// Per request, so the header, footer, chatbot and the phone number show what is in Odoo now.
export const prerender = false;
const content = await getContent(hostOf(Astro.request));
const phone = contactOf(content.site).display;
---

<Base title="Approve the new price" description="The price for your repair changed after checking the device." quiet content={content}>
  <section class="page-head">
    <div class="wrap">
      <span class="eyebrow">Your repair</span>
      <h1 class="h-xl">New <span class="grad-text">price</span></h1>
      <p class="lead" data-q-lead>Loading…</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap qs" data-qs data-no-fx data-phone={phone}>
      <div class="qs-card" data-q-card hidden>
        <h3>After checking your device <small data-q-ref></small></h3>
        <p class="qs-found" data-q-found hidden></p>
        <ul data-q-lines></ul>
        <!-- a part offered in two grades (original / compatible): the customer keeps one -->
        <div class="qs-choices" data-q-choices hidden></div>
        <p class="qs-old">Estimate you agreed before: <b data-q-old></b></p>
        <p class="qs-parts" data-q-parts hidden></p>
        <p class="qs-office" data-q-office hidden>Your device is at our office.</p>
        <div class="qs-acts" data-q-acts>
          <button type="button" class="qs-btn" data-q-yes>Approve</button>
          <button type="button" class="qs-btn ghost" data-q-no>Decline</button>
        </div>
        <p class="qs-done" data-q-done hidden></p>
      </div>
      <p class="qs-msg" data-q-msg role="alert" hidden></p>
    </div>
  </section>
</Base>

<script>
  const $ = <T extends Element = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const phone = $('[data-qs]').dataset.phone!;   // the phone number in Odoo's Website Details
  const q = new URLSearchParams(location.search);
  const o = q.get('o') || '', t = q.get('t') || '';
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const msg = (m: string) => { const el = $('[data-q-msg]'); el.textContent = m; el.hidden = !m; };
  const ERR: Record<string, string> = {
    expired: `This link has expired — please call us on ${phone}.`,
    unknown: `This link doesn't work — please call us on ${phone}.`,
    cancelled: 'This booking is closed.',
  };
  const done = (text: string) => { $('[data-q-acts]').hidden = true; const d = $('[data-q-done]'); d.textContent = text; d.hidden = false; };

  async function load() {
    const r = await fetch(`/api/visit?page=quote&o=${encodeURIComponent(o)}&t=${encodeURIComponent(t)}`).then((x) => x.json()).catch(() => ({ ok: false }));
    if (!r.ok) { $('[data-q-lead]').textContent = ''; msg(ERR[r.error] || "We can't load this right now. Please try again in a minute."); return; }
    $('[data-q-card]').hidden = false;
    $('[data-q-lead]').textContent = `Hi ${r.customer || 'there'} — booking ${r.ref}.`;
    $('[data-q-ref]').textContent = r.ref;
    if (r.lab && r.state === 'waiting') {
      // the technician asks to take the device for a lab check: the reason and the date, no price yet
      lab = true;
      document.querySelector('h1')!.innerHTML = 'A lab <span class="grad-text">check</span>';
      $('[data-q-card] h3').firstChild!.textContent = 'May we take your device to our lab? ';
      $('[data-q-lines]').innerHTML = `<li>Our technician needs a closer check of your <b>${esc(r.lab.device || 'device')}</b> at our lab.</li>`
        + (r.lab.date ? `<li>You'll get the price by <b>${esc(r.lab.date)}</b>${r.lab.within ? ` (within ${esc(r.lab.within)})` : ''}.</li>` : '')
        + '<li>Nothing is repaired before you approve the price.</li>';
      $('[data-q-old]').closest('p')!.hidden = true;
      $('[data-q-yes]').textContent = 'Yes, take it';
      $('[data-q-no]').textContent = 'No thanks';
      return;
    }
    const found = $('[data-q-found]');
    found.hidden = !(r.found || []).length;
    found.innerHTML = found.hidden ? '' : `What we found: <b>${esc(r.found.join(', '))}</b>`;
    $('[data-q-lines]').innerHTML = r.lines.map((l: string) => `<li>${esc(l.replace(/^•\s*/, ''))}</li>`).join('');
    drawChoices(r);
    $('[data-q-old]').textContent = `${r.currency} ${Number(r.old_total || 0).toFixed(3)}`;
    const parts = $('[data-q-parts]');
    parts.hidden = !r.parts.length;
    parts.innerHTML = r.parts.length ? `<b>${esc(r.parts.join(', '))}</b> must be ordered first — approving lets us order it, and you pick a new visit time when it arrives.` : '';
    $('[data-q-office]').hidden = !r.at_office;
    if (r.state === 'accepted') done('Approved — thank you. We will go ahead with the repair.');
    else if (r.state === 'declined') done('You declined the new price. We will be in touch.');
    else if (r.state !== 'waiting') {
      // Opened before any new price was sent (or an old link): nothing to answer yet.
      $('[data-q-old]').closest('p')!.hidden = true;
      done('There is no new price waiting for you. If anything changes after checking your device, we will send you a link here.');
    }
  }

  // A part offered in two grades: one radio group each; the total follows the choice.
  let quote: any = null;
  let lab = false;   // the OK to take the device for a lab check, not a price
  const money = (v: number) => `${quote.currency} ${Number(v || 0).toFixed(quote.decimals ?? 3)}`;
  const picked = () => [...document.querySelectorAll<HTMLInputElement>('[data-q-choices] input:checked')].map((x) => Number(x.value));
  function drawChoices(r: any) {
    quote = r;
    const box = $('[data-q-choices]');
    const groups: any[] = r.choices || [];
    box.hidden = !groups.length || r.state !== 'waiting';
    box.innerHTML = groups.map((g: any, i: number) => `<fieldset><legend>Choose one</legend>${g.options.map((op: any) => `
      <label><input type="radio" name="qc${i}" value="${op.line_id}" ${op.chosen ? 'checked' : ''} />
        <span><b>${esc(op.name)}</b>${op.grade ? ` <small>${esc(op.grade)}</small>` : ''}</span><em>${esc(money(op.amount))}</em></label>`).join('')}</fieldset>`).join('');
    total();
  }
  function total() {
    const groups: any[] = quote?.choices || [];
    if (!groups.length) return;
    const ids = new Set(picked());
    let sum = Number(quote.total || 0);
    for (const g of groups) for (const op of g.options) {
      if (op.chosen) sum -= op.amount;
      if (ids.has(op.line_id)) sum += op.amount;
    }
    const last = $('[data-q-lines]').lastElementChild;
    if (last) last.textContent = `Total: ${money(sum)}`;
  }
  $('[data-q-choices]').addEventListener('change', total);

  async function answer(yes: boolean) {
    const r = await fetch('/api/visit', { method: 'POST', headers: { 'content-type': 'application/json' },
      body: JSON.stringify({ o, t, action: 'quote', yes, choice: picked() }) }).then((x) => x.json()).catch(() => ({ ok: false }));
    if (!r.ok) { msg(ERR[r.error] || 'That did not work — please try again.'); return; }
    done(lab ? (yes ? 'Thank you! Our technician takes your device to our lab; we send you the price before any repair.'
                    : 'Fine, your device stays with you. Nothing is taken or repaired.')
      : yes ? 'Approved — thank you. We will go ahead with the repair.' : 'You declined the new price. We will be in touch.');
  }
  $('[data-q-yes]').addEventListener('click', () => answer(true));
  $('[data-q-no]').addEventListener('click', () => answer(false));

  if (!o || !t) msg(ERR.unknown); else load();
</script>

<style>
  .qs { max-width: 680px; display: grid; gap: 14px; }
  .qs-card { padding: 22px; border: 1px solid var(--line); border-radius: 20px; background: var(--surface); display: grid; gap: 10px; }
  .qs-card[hidden] { display: none; }
  .qs-card h3 { margin: 0; font-size: 18px; display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
  .qs-card h3 small { font-size: 13px; color: var(--ink-3); font-weight: 600; }
  .qs-card ul { margin: 0; padding-left: 18px; display: grid; gap: 4px; }
  /* the lines are drawn by the script (innerHTML), so :global; the last one is the total */
  .qs-card ul :global(li:last-child) { font-weight: 700; list-style: none; margin-left: -18px; padding-top: 6px; border-top: 1px dashed var(--line); }
  .qs-old, .qs-parts, .qs-office, .qs-done, .qs-found { margin: 0; }
  .qs-old { color: var(--ink-3); }
  .qs-acts { display: flex; flex-wrap: wrap; gap: 10px; }
  .qs-acts[hidden] { display: none; }
  .qs-btn { height: 48px; padding: 0 22px; border: 0; border-radius: 14px; background: var(--violet); color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  .qs-btn.ghost { background: transparent; color: var(--ink); border: 1px solid var(--line); }
  .qs-done { font-weight: 700; }
  .qs-msg { margin: 0; color: #9F1239; font-weight: 600; }
  .qs-choices[hidden] { display: none; }
  .qs-choices :global(fieldset) { margin: 0; padding: 12px 14px; border: 1px solid var(--line); border-radius: 14px; display: grid; gap: 8px; }
  .qs-choices :global(legend) { padding: 0 6px; font-weight: 700; color: var(--ink); }
  .qs-choices :global(label) { display: flex; align-items: center; gap: 10px; min-height: 44px; cursor: pointer; }
  .qs-choices :global(label span) { flex: 1; color: var(--ink); }
  .qs-choices :global(label small) { margin-left: 6px; padding: 2px 8px; border-radius: 999px; background: var(--tint); color: var(--ink-2); font-size: 12px; font-weight: 700; }
  .qs-choices :global(label em) { font-style: normal; font-weight: 700; color: var(--ink); }
  .qs-choices :global(input) { width: 20px; height: 20px; accent-color: var(--violet); }
  .qs-msg[hidden] { display: none; }
</style>
