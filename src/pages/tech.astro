---
// The technician's link from WhatsApp: /tech?v=<visit>&t=<token>. Shows the customer and
// address, moves the visit along (Start trip, Arrived with the customer's code, Start work,
// Done) and, while the visit is open, sends the phone's location to Odoo every ~20 s so the
// customer sees the technician coming on My orders. Everything goes through /api/tech.
import Base from '../layouts/Base.astro';
export const prerender = false;
---

<Base title="Your visit" description="The technician's visit page." quiet>
  <section class="section">
    <div class="wrap tv" data-tv>
      <p class="tv-load" data-tv-load>Loading your visit…</p>

      <div data-tv-main hidden>
        <div class="tv-top">
          <span class="eyebrow" data-tv-ref></span>
          <h1 class="h-lg" data-tv-state></h1>
        </div>

        <div class="tv-card">
          <h3 data-tv-name></h3>
          <p class="tv-sum" data-tv-sum></p>
          <p class="tv-addr" data-tv-addr></p>
          <p class="tv-slot" data-tv-slot hidden></p>
          <div class="tv-acts">
            <a class="tv-btn ghost" data-tv-call href="#" hidden>Call customer</a>
            <a class="tv-btn ghost" data-tv-dir href="#" target="_blank" rel="noopener" hidden>Directions</a>
          </div>
        </div>

        <!-- after arriving: the safety check and the device photos; Start work waits for them -->
        <div class="tv-card tv-ck" data-vc hidden>
          <h3>Before you start</h3>
          <p class="tv-hint">Do these at the door, before you touch the device.</p>

          <h4>1. Safety check</h4>
          <div class="vc-list" data-vc-safety></div>

          <h4>2. Photo of you ready to work <small>(1 to 3)</small></h4>
          <div class="vc-row">
            <span class="vc-st" data-vc-sp></span>
            <label class="tv-btn ghost sm">Take photo<input type="file" accept="image/*" capture="user" data-vc-spin hidden /></label>
            <button type="button" class="vc-link" data-vc-spclear hidden>Take again</button>
          </div>

          <h4>3. Device photos</h4>
          <div class="vc-list" data-vc-sides></div>

          <h4>4. Short video of the device <small>(under a minute)</small></h4>
          <div class="vc-row">
            <span class="vc-st" data-vc-vid></span>
            <label class="tv-btn ghost sm">Record video<input type="file" accept="video/*" capture="environment" data-vc-vin hidden /></label>
          </div>
          <p class="vc-busy" data-vc-busy hidden>Sending…</p>
        </div>

        <!-- while working: what was found -> the quotation first -> the customer's OK -> the plan -->
        <div class="tv-card tv-ck" data-vr hidden>
          <div data-vr-find>
            <h3>What did you find?</h3>
            <textarea class="vr-note" data-vr-note rows="2" maxlength="2000" placeholder="e.g. Screen cracked, battery swollen"></textarea>
            <label class="vr-field" data-vr-device hidden>Device brand (no job card yet)
              <select data-vr-brand><option value="">Choose…</option></select>
            </label>

            <h4>Parts needed <small>(skip when no part is needed)</small></h4>
            <div class="vc-list" data-vr-lines></div>
            <form class="vr-search" data-vr-search>
              <input data-vr-q type="search" placeholder="Search a part, e.g. iPhone 13 screen" />
              <button type="submit" class="tv-btn ghost sm">Search</button>
            </form>
            <div class="vc-list" data-vr-found></div>

            <div data-vr-plan hidden>
              <h4>After the customer approves</h4>
              <div class="vr-choice" data-vr-plans></div>
              <label class="vr-field" data-vr-partbox>When does the part arrive? (days)
                <input data-vr-partdays type="number" inputmode="numeric" min="1" max="120" value="7" />
              </label>
              <div class="vr-field" data-vr-daysbox>
                <span data-vr-dayslabel>Fixed within</span>
                <div class="vr-span">
                  <input data-vr-days type="number" inputmode="numeric" min="1" max="60" value="3" />
                  <select data-vr-unit><option value="days">days</option><option value="weeks">weeks</option></select>
                </div>
              </div>
              <p class="tv-hint">The customer gets the parts and the price to approve first. Nothing is repaired, taken or ordered before.</p>
              <button type="button" class="tv-btn big" data-vr-quote>Send the quotation</button>
            </div>
            <button type="button" class="tv-btn big" data-vr-fixed>Fixed on the spot</button>
          </div>

          <div data-vr-waiting hidden>
            <h3>Waiting for the customer's OK</h3>
            <p class="tv-hint">The quotation is on their WhatsApp. If they tell you, tap their answer.</p>
            <p class="vr-plan" data-vr-planlabel></p>
            <button type="button" class="tv-btn big" data-vr-yes>Customer approved</button>
            <button type="button" class="tv-btn big ghost" data-vr-no>Customer declined</button>
            <button type="button" class="vc-link" data-vr-later>Customer decides later (close the visit)</button>
          </div>

          <div data-vr-repairing hidden>
            <h3>Approved: repair it now</h3>
            <button type="button" class="tv-btn big" data-vr-done>Repair done</button>
          </div>

          <div data-vr-totake hidden>
            <h3>Approved: take the device to the office</h3>
            <p class="tv-hint" data-vr-backby></p>
            <p class="tv-hint">Tick what you take with the device:</p>
            <label class="vc-item"><input type="checkbox" data-vr-noacc /> <span>Device only (no accessories)</span></label>
            <div class="vr-acc" data-vr-acc></div>
            <button type="button" class="tv-btn big" data-vr-take>Take the device</button>
          </div>
        </div>
        <div class="tv-card" data-tv-step hidden>
          <div class="tv-code" data-tv-codebox hidden>
            <label for="tv-code">Ask the customer for their 4-digit arrival code</label>
            <input id="tv-code" data-tv-code inputmode="numeric" maxlength="4" autocomplete="off" placeholder="••••" />
          </div>
          <button type="button" class="tv-btn big" data-tv-go></button>
          <p class="tv-hint" data-tv-hint></p>
        </div>

        <div class="tv-card tv-end" data-tv-end hidden></div>

        <div class="tv-gps" data-tv-gps hidden>
          <i data-tv-dot></i><span data-tv-gpstext></span>
        </div>
      </div>

      <p class="tv-msg" data-tv-msg role="alert" hidden></p>
    </div>
  </section>
</Base>

<script>
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const q = new URLSearchParams(location.search);
  const v = q.get('v') || '', t = q.get('t') || '';
  const msg = (m: string) => { const el = $('[data-tv-msg]'); el.textContent = m; el.hidden = !m; };
  const ERR: Record<string, string> = {
    unknown: 'This link does not work. Ask the office to send you a new one.',
    expired: 'This link has expired. Ask the office to send you a new one.',
    unavailable: 'Cannot reach the office system right now. Keep this page open; it tries again.',
  };
  // The one button per step: [label, action, hint]
  const STEP: Record<string, [string, string, string]> = {
    assigned: ['Start trip', 'on_the_way', 'Tap when you leave. The customer is told you are on the way.'],
    on_the_way: ['I have arrived', 'arrive', 'Tap at the door.'],
    arrived: ['Start work', 'start', 'Tap when you start checking the device.'],
  };

  let view: any = null;
  let fix: GeolocationPosition | null = null;
  let sentAt = 0, sentFixAt = 0, watchId: number | null = null, pingTimer: ReturnType<typeof setInterval> | null = null;
  let lock: any = null, battery: any = null;

  const api = (body?: unknown) => fetch(body ? '/api/tech' : `/api/tech?v=${encodeURIComponent(v)}&t=${encodeURIComponent(t)}`, body
    ? { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ v, t, ...(body as object) }) }
    : { cache: 'no-store' }).then((r) => r.json()).catch(() => ({ ok: false, error: 'unavailable' }));

  const where = () => fix ? {
    lat: fix.coords.latitude, lng: fix.coords.longitude, accuracy: fix.coords.accuracy,
    heading: fix.coords.heading ?? null, speed: fix.coords.speed ?? null,
    battery: battery ? battery.level : null,
  } : {};

  function render(d: any) {
    view = d;
    $('[data-tv-load]').hidden = true; $('[data-tv-main]').hidden = false;
    $('[data-tv-ref]').textContent = `Visit ${d.ref}${d.order ? ' · order ' + d.order : ''}`;
    $('[data-tv-state]').textContent = d.state_label;
    const c = d.customer || {};
    $('[data-tv-name]').textContent = c.name || 'Customer';
    $('[data-tv-sum]').textContent = d.summary || '';
    $('[data-tv-addr]').textContent = [c.building, c.floor_flat, c.address, c.area, c.landmark && `near ${c.landmark}`].filter(Boolean).join(', ');
    const slot = $('[data-tv-slot]');
    slot.hidden = !d.slot;
    if (d.slot) slot.textContent = 'Visit time: ' + new Date(d.slot.start).toLocaleString([], { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' })
      + (d.slot.end ? ' to ' + new Date(d.slot.end).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '');
    const call = $<HTMLAnchorElement>('[data-tv-call]'), dir = $<HTMLAnchorElement>('[data-tv-dir]');
    call.hidden = !c.phone; if (c.phone) call.href = 'tel:+' + String(c.phone).replace(/\D/g, '');
    dir.hidden = !d.directions_url; if (d.directions_url) dir.href = d.directions_url;

    const step = STEP[d.state];
    $('[data-tv-step]').hidden = !step;
    renderChecks(d.checks);
    if (step) {
      const waiting = step[1] === 'start' && d.checks?.missing?.length;
      $('[data-tv-go]').textContent = step[0];
      $<HTMLButtonElement>('[data-tv-go]').disabled = !!waiting;
      $('[data-tv-hint]').textContent = waiting ? `Still to do: ${d.checks.missing.join(', ')}.` : step[2];
      $('[data-tv-codebox]').hidden = !(step[1] === 'arrive' && d.need_code);
    }
    renderResult(d.result);
    const end = $('[data-tv-end]');
    end.hidden = !!step || !!d.result;
    if (!step) end.textContent = d.state === 'done' ? `Visit completed${d.result_label ? ' · ' + d.result_label : ''}. Thank you! You can close this page.`
      : d.state === 'cancelled' ? 'This visit was cancelled. Ask the office if you have questions.'
      : 'The office has not assigned this visit yet.';
    if (d.share) startGps(); else stopGps();
  }

  // ---- before work: safety ticks, photos and the video ----
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const OK = '<b class="vc-ok">✓</b>';
  function renderChecks(c: any) {
    const box = $('[data-vc]');
    box.hidden = !c;
    if (!c) return;
    $('[data-vc-safety]').innerHTML = c.safety.map((i: any) => `<label class="vc-item">
      <input type="checkbox" data-vc-tick="${i.id}" ${i.done ? 'checked' : ''} />
      <span>${esc(i.name)}${i.required ? '' : ' <small>(optional)</small>'}</span></label>`).join('');
    const n = c.safety_photos;
    $('[data-vc-sp]').innerHTML = n ? `${OK} ${n} photo${n > 1 ? 's' : ''}` : '<span class="vc-no">No photo yet</span>';
    $('[data-vc-spin]').closest('label')!.hidden = n >= c.safety_photos_max;
    $('[data-vc-spclear]').hidden = !n;
    $('[data-vc-sides]').innerHTML = c.sides.map((s: any) => `<div class="vc-row">
      <span class="vc-st">${s.done ? OK : '<span class="vc-no">●</span>'} ${esc(s.name)}</span>
      <label class="tv-btn ghost sm">${s.done ? 'Retake' : 'Take photo'}<input type="file" accept="image/*" capture="environment" data-vc-side="${s.id}" hidden /></label></div>`).join('');
    $('[data-vc-vid]').innerHTML = c.video ? `${OK} Video saved` : '<span class="vc-no">No video yet</span>';
  }

  // A phone photo is shrunk to 1600 px JPEG before it is sent (quicker on mobile data).
  async function photoData(file: File): Promise<string> {
    try {
      const img = await createImageBitmap(file);
      const k = Math.min(1, 1600 / Math.max(img.width, img.height));
      const cv = document.createElement('canvas');
      cv.width = Math.round(img.width * k); cv.height = Math.round(img.height * k);
      cv.getContext('2d')!.drawImage(img, 0, 0, cv.width, cv.height);
      return cv.toDataURL('image/jpeg', 0.82).split(',')[1];
    } catch {
      return fileData(file);
    }
  }
  const fileData = (file: File) => new Promise<string>((res, rej) => {
    const r = new FileReader();
    r.onload = () => res(String(r.result).split(',')[1] || '');
    r.onerror = () => rej(r.error);
    r.readAsDataURL(file);
  });

  async function check(body: Record<string, unknown>) {
    $('[data-vc-busy]').hidden = false; msg('');
    const d = await api(body);
    $('[data-vc-busy]').hidden = true;
    if (d.ref) render(d);
    if (!d.ok) msg(d.message || ERR[d.error] || 'That did not work. Try again.');
  }

  $('[data-vc]').addEventListener('change', async (e) => {
    const el = e.target as HTMLInputElement;
    if (el.dataset.vcTick) return check({ action: 'check_tick', item_id: Number(el.dataset.vcTick), done: el.checked });
    const file = el.files?.[0];
    el.value = '';
    if (!file) return;
    if (el.hasAttribute('data-vc-spin')) return check({ action: 'check_safety_photo', data: await photoData(file) });
    if (el.dataset.vcSide) return check({ action: 'check_side_photo', photo_id: Number(el.dataset.vcSide), data: await photoData(file) });
    if (el.hasAttribute('data-vc-vin')) {
      if (file.size > 30 * 1024 * 1024) { msg('The video is too large. Record a shorter one (under a minute).'); return; }
      return check({ action: 'check_video', name: file.name, data: await fileData(file) });
    }
  });
  $('[data-vc-spclear]').addEventListener('click', () => check({ action: 'check_clear_safety' }));

  // ---- while working: what was found -> the quotation first -> the customer's OK -> the plan ----
  const WHERE: Record<string, (p: any) => string> = {
    in_stock: (p) => `<span class="vc-ok">✓ In the office (${p.office})</span>`,
    other_branch: (p) => `<span class="vr-warn">At ${esc((p.branches || []).map((b: any) => `${b.name} (${b.qty})`).join(', '))}</span>`,
    order: () => '<span class="vc-no">Must be ordered</span>',
  };
  const PLANS_HERE: [string, string][] = [['now', 'Fix now (I have the part)'], ['take', 'Take the device to the office'], ['come_back', 'Customer keeps it, we come back']];
  const PLANS_ORDER: [string, string][] = [['keep', 'Customer keeps it until the part arrives'], ['order_take', 'Take the device to the office until the part arrives']];
  let brandsDrawn = false, plansFor = '';
  const show = (sel: string, on: boolean) => { $(sel).hidden = !on; };
  const plan = () => document.querySelector<HTMLInputElement>('input[name="vr-plan"]:checked')?.value || '';

  function renderResult(r: any) {
    show('[data-vr]', !!r);
    if (!r) return;
    show('[data-vr-find]', r.stage === 'find');
    show('[data-vr-waiting]', r.stage === 'waiting');
    show('[data-vr-repairing]', r.stage === 'repairing');
    show('[data-vr-totake]', r.stage === 'to_take');
    $('[data-vr-planlabel]').textContent = r.plan_label ? `Proposed: ${r.plan_label}` : '';
    $('[data-vr-backby]').textContent = r.timeline_date ? `Back by ${r.timeline_date}.` : '';
    const note = $<HTMLTextAreaElement>('[data-vr-note]');
    if (document.activeElement !== note) note.value = r.found || '';
    show('[data-vr-device]', !!r.need_device);
    if (r.need_device && !brandsDrawn && r.brands) {
      $('[data-vr-brand]').innerHTML = '<option value="">Choose…</option>' + r.brands.map((b: any) => `<option value="${b.id}">${esc(b.name)}</option>`).join('');
      brandsDrawn = true;
    }
    $('[data-vr-lines]').innerHTML = r.lines.map((l: any) => `<div class="vc-row">
      <span class="vc-st">${esc(l.name)}${l.qty > 1 ? ` ×${l.qty}` : ''}<br /><small>${WHERE[l.status](l)}</small></span>
      <button type="button" class="vc-link" data-vr-del="${l.line_id}">Remove</button></div>`).join('')
      || '<p class="tv-hint">No parts added.</p>';
    const hasParts = r.lines.length > 0;
    show('[data-vr-plan]', hasParts);
    show('[data-vr-fixed]', !hasParts);
    const kind = r.to_order ? 'order' : 'here';
    if (hasParts && plansFor !== kind) {
      const list = r.to_order ? PLANS_ORDER : PLANS_HERE;
      $('[data-vr-plans]').innerHTML = list.map(([k, label], i) => `<label><input type="radio" name="vr-plan" value="${k}" ${i === 0 ? 'checked' : ''} /> ${esc(label)}</label>`).join('');
      plansFor = kind;
    }
    const partDays = $<HTMLInputElement>('[data-vr-partdays]');
    if (r.to_order && document.activeElement !== partDays && !partDays.dataset.set) partDays.value = String(r.part_days || 7);
    const ticked = new Set([...document.querySelectorAll<HTMLInputElement>('[data-vr-accid]:checked')].map((x) => x.value));
    $('[data-vr-acc]').innerHTML = r.accessories.map((a: any) => `<label class="vc-item"><input type="checkbox" value="${a.id}" data-vr-accid ${ticked.has(String(a.id)) ? 'checked' : ''} /> <span>${esc(a.name)}</span></label>`).join('');
    syncPlan();
  }
  // the days: "fixed within" for take / come back, "repair after the part arrives" for an
  // ordered part going to the office; the part's days only when it must be ordered
  function syncPlan() {
    const r = view?.result || {};
    const p = plan();
    show('[data-vr-partbox]', !!r.to_order);
    show('[data-vr-daysbox]', ['take', 'come_back', 'order_take'].includes(p));
    $('[data-vr-dayslabel]').textContent = p === 'order_take' ? 'Repair after the part arrives' : 'Fixed within';
    $('[data-vr-acc]').hidden = $<HTMLInputElement>('[data-vr-noacc]').checked;
  }
  const noteArg = () => ({ note: $<HTMLTextAreaElement>('[data-vr-note]').value });

  async function result(body: Record<string, unknown>) {
    $('[data-vc-busy]').hidden = false; msg('');
    const d = await api(body);
    $('[data-vc-busy]').hidden = true;
    if (d.ref) render(d);
    if (!d.ok) msg(d.message || ERR[d.error] || 'That did not work. Try again.');
    return d;
  }

  $('[data-vr-search]').addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = await result({ action: 'result_parts', query: $<HTMLInputElement>('[data-vr-q]').value });
    $('[data-vr-found]').innerHTML = (d.parts || []).map((p: any) => `<div class="vc-row">
      <span class="vc-st">${esc(p.name)}<br /><small>${WHERE[p.status](p)}</small></span>
      <button type="button" class="tv-btn ghost sm" data-vr-add="${p.product_id}">Add</button></div>`).join('')
      || (d.ok ? '<p class="tv-hint">No part found. Try another word.</p>' : '');
  });
  $('[data-vr]').addEventListener('click', async (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-vr-add],[data-vr-del]');
    if (!el) return;
    if (el.dataset.vrAdd) {
      const brand = Number($<HTMLSelectElement>('[data-vr-brand]').value) || null;
      if (view?.result?.need_device && !brand) { msg('Choose the device brand first.'); return; }
      const d = await result({ action: 'result_add_part', product_id: Number(el.dataset.vrAdd), brand_id: brand });
      if (d.ok) { $('[data-vr-found]').innerHTML = ''; $<HTMLInputElement>('[data-vr-q]').value = ''; }
    } else {
      await result({ action: 'result_remove_part', line_id: Number(el.dataset.vrDel) });
    }
  });
  $('[data-vr]').addEventListener('change', (e) => {
    const el = e.target as HTMLInputElement;
    if (el.name === 'vr-plan' || el.hasAttribute('data-vr-noacc')) syncPlan();
    if (el.hasAttribute('data-vr-partdays')) el.dataset.set = '1';
  });
  $('[data-vr-note]').addEventListener('blur', () => { if (view?.result?.stage === 'find') result({ action: 'result_note', ...noteArg() }); });
  $('[data-vr-fixed]').addEventListener('click', () => {
    if (confirm('Fixed on the spot? The visit will be closed.')) result({ action: 'result_fixed', ...noteArg() });
  });
  $('[data-vr-quote]').addEventListener('click', () => {
    const p = plan();
    if (!p) { msg('Choose what happens after the customer approves.'); return; }
    const days = Number($<HTMLInputElement>('[data-vr-days]').value);
    const unit = $<HTMLSelectElement>('[data-vr-unit]').value;
    const partDays = Number($<HTMLInputElement>('[data-vr-partdays]').value);
    if (['take', 'come_back', 'order_take'].includes(p) && !(unit === 'weeks' ? days >= 1 && days <= 8 : days >= 1 && days <= 60)) {
      msg('How long to fix? 1 to 60 days, or 1 to 8 weeks.'); return;
    }
    if (view?.result?.to_order && !(partDays >= 1 && partDays <= 120)) { msg('When does the part arrive? Give the days (1 to 120).'); return; }
    if (confirm('Send the quotation to the customer?')) {
      result({ action: 'result_quote', plan: p, days, unit, part_days: partDays, ...noteArg() });
    }
  });
  $('[data-vr-yes]').addEventListener('click', () => { if (confirm('The customer approved the price?')) result({ action: 'result_approved_here' }); });
  $('[data-vr-no]').addEventListener('click', () => { if (confirm('The customer declined? Nothing is repaired or ordered.')) result({ action: 'result_declined_here' }); });
  $('[data-vr-later]').addEventListener('click', () => { if (confirm('Close the visit? The customer answers the quotation later.')) result({ action: 'result_later' }); });
  $('[data-vr-done]').addEventListener('click', () => { if (confirm('Repair done? The visit will be closed.')) result({ action: 'result_fixed' }); });
  $('[data-vr-take]').addEventListener('click', () => {
    const only = $<HTMLInputElement>('[data-vr-noacc]').checked;
    const ids = [...document.querySelectorAll<HTMLInputElement>('[data-vr-accid]:checked')].map((x) => Number(x.value));
    if (!only && !ids.length) { msg('Tick what you take with the device, or "Device only".'); return; }
    result({ action: 'result_take', no_accessories: only, accessory_ids: only ? [] : ids });
  });

  async function load() {
    const d = await api();
    if (!d.ok && !view) { $('[data-tv-load]').hidden = true; msg(ERR[d.error] || ERR.unavailable); return; }
    if (d.ok) { msg(''); render(d); }
  }

  $('[data-tv-go]').addEventListener('click', async () => {
    const step = view && STEP[view.state];
    if (!step) return;
    const btn = $<HTMLButtonElement>('[data-tv-go]');
    const code = $<HTMLInputElement>('[data-tv-code]').value.replace(/\D/g, '');
    if (step[1] === 'arrive' && view.need_code && code.length !== 4) { msg('Enter the 4-digit code from the customer.'); return; }
    btn.disabled = true; msg('');
    const d = await api({ action: step[1], code, ...where() });
    btn.disabled = false;
    if (d.ref) render(d);
    if (!d.ok) msg(d.message || ERR[d.error] || 'That did not work. Try again.');
    else $<HTMLInputElement>('[data-tv-code]').value = '';
  });

  // ---- location: sent while the visit is open and this page is on screen ----
  function gpsText(text: string, ok: boolean) {
    $('[data-tv-gps]').hidden = false;
    $('[data-tv-gpstext]').textContent = text;
    $('[data-tv-dot]').className = ok ? 'ok' : 'bad';
  }

  async function ping() {
    if (!fix || document.hidden) return;
    const every = (view?.ping_every || 20) * 1000;
    // A new fix every ping_every, or the same one once a minute so the office sees the signal.
    if (fix.timestamp === sentFixAt && Date.now() - sentAt < 60000) return;
    if (Date.now() - sentAt < every - 1000) return;
    sentAt = Date.now(); sentFixAt = fix.timestamp;
    const d = await api({ action: 'ping', ...where() });
    if (!d.ok) { gpsText('Location not sent. Trying again…', false); return; }
    gpsText(`Sharing your location with the customer · sent ${new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`, true);
    if (view && d.state !== view.state) load();
  }

  function startGps() {
    if (watchId !== null) return;
    if (!('geolocation' in navigator) || !window.isSecureContext) {
      gpsText('This phone cannot share its location here. Open the link in Chrome or Safari.', false);
      return;
    }
    gpsText('Turning on location…', true);
    watchId = navigator.geolocation.watchPosition((p) => { fix = p; ping(); }, (e) => {
      gpsText(e.code === e.PERMISSION_DENIED
        ? 'Location is blocked. Allow location for this site in the browser settings, then reload.'
        : 'Waiting for GPS signal…', false);
    }, { enableHighAccuracy: true, maximumAge: 10000, timeout: 30000 });
    pingTimer = setInterval(ping, 5000);
    keepAwake();
  }

  function stopGps() {
    if (watchId !== null) navigator.geolocation.clearWatch(watchId);
    if (pingTimer) clearInterval(pingTimer);
    watchId = null; pingTimer = null;
    $('[data-tv-gps]').hidden = true;
    lock?.release?.().catch(() => {}); lock = null;
  }

  // Keep the screen on while sharing, so the phone does not stop the location.
  async function keepAwake() {
    try { lock = await (navigator as any).wakeLock?.request('screen'); } catch { lock = null; }
  }
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden && watchId !== null) { keepAwake(); ping(); load(); }
  });
  (navigator as any).getBattery?.().then((b: any) => { battery = b; }).catch(() => {});

  if (!v || !t) { $('[data-tv-load]').hidden = true; msg(ERR.unknown); }
  else { load(); setInterval(() => { if (!document.hidden) load(); }, 60000); }
</script>

