---
// "Our Services" booking panel (restored design): category sidebar, device banner, then
// the same order as the booking wizard — brand → model → repair cards with Add / − n + —
// into the site cart; the bar opens the wizard's Cart step to book everything together.
import DeviceArt from './DeviceArt.astro';
import { price } from '../data/site';
import { iconPaths } from '../data/devices';
import { artFor, note } from '../data/menu';
import { staticCatalog, type WzCategory } from '../lib/catalog';
interface Props { categories?: WzCategory[]; odoo?: boolean }
// The wizard's catalogue (Odoo's when connected), so brands, models and repairs carry Odoo's ids.
const { categories = staticCatalog().categories, odoo = false } = Astro.props;
// brands and models for the script (models are drawn there - some brands have hundreds)
const bkData = JSON.stringify(categories.map((c) => ({ id: c.id, odooId: c.odooId, name: c.name,
  brands: c.brands.map((b) => ({ id: b.id, odooId: b.odooId, name: b.name, logo: b.logo ?? null, items: b.items })) })));
// Pictures chosen in Odoo sit over the site's own art (has-pic hides it); one that fails to load
// removes itself and the art shows again.
const PIC_FAIL = "this.parentElement.classList.remove('has-pic');this.remove()";
const picOf = (c: WzCategory, name: string, image?: string | null) => image || (photo[`${c.id}:${name}`] ? `/media/repairs/${photo[`${c.id}:${name}`]}.jpg` : '');

// Real repair photos (public/media/repairs) — one shared list; others fall back to the illustration.
import { photo } from '../data/photos';
const heroCopy: Record<string, [string, string]> = {
  mobile: ['Keep Your Phone Working Like New', 'Screen, battery, charging, camera and more – quick and reliable service.'],
  tablet: ['Your Tablet, Good as New', 'Cracked glass, batteries and charging faults fixed fast.'],
  laptop: ['Laptop Trouble? Sorted.', 'Screens, keyboards, hinges, batteries and board-level repair.'],
  desktop: ['Desktops Back to Full Speed', 'Power, boards, upgrades and clean OS installs.'],
  printer: ['Printers That Just Work', 'Jams, print quality, toner and setup – serviced on-site.'],
  cctv: ['Security You Can See', 'Survey, install and remote viewing for homes and shops.'],
  network: ['Wi-Fi in Every Room', 'Mesh, routers, cabling and office networks.'],
  data: ['Get Your Files Back', 'Deleted files, dead drives and formatted disks recovered.'],
  itsupport: ['IT Help When You Need It', 'Software, email, tune-ups and maintenance plans.'],
};
const issueIcon = (s: string) => {
  const t = s.toLowerCase();
  const I: [RegExp, string][] = [
    [/back glass/, '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><circle cx="10" cy="7" r="1.6"/><circle cx="14" cy="7" r="1.6"/>'],
    [/screen|glass|display/, '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M9 6l6 6M9 11l3 3"/>'],
    [/battery/, '<rect x="7" y="4" width="10" height="17" rx="2"/><path d="M10 2h4M12 9l-2 4h4l-2 4"/>'],
    [/charg|power/, '<path d="M9 3v5M15 3v5M6 8h12v3a6 6 0 0 1-12 0zM12 17v4"/>'],
    [/camera|cctv|viewing|dvr/, '<path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>'],
    [/water|fire/, '<path d="M12 3s6 7 6 11a6 6 0 0 1-12 0c0-4 6-11 6-11z"/>'],
    [/speaker|micro/, '<path d="M4 9h4l5-4v14l-5-4H4zM17 9a4 4 0 0 1 0 6"/>'],
    [/wi-?fi|router|mesh|lan|network|switch/, '<path d="M2 9a15 15 0 0 1 20 0M5.5 12.5a10 10 0 0 1 13 0M9 16a5 5 0 0 1 6 0"/><circle cx="12" cy="19.5" r="1"/>'],
    [/drive|ssd|ram|disk|deleted|format|recover/, '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3 14h18"/>'],
    [/paper|toner|cartridge|roller|print/, '<path d="M7 9V3.5h10V9"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v6.5H7z"/>'],
  ];
  return I.find(([re]) => re.test(t))?.[1] ?? '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-.5-.5-2.5z"/>';
};
---

      <div class="bk" data-bk data-odoo={odoo ? '1' : ''} data-cats={bkData}>
        <aside class="bk-side">
          <h3>Our Services</h3>
          <p>Choose a category, then your brand and model.</p>
          <div class="bk-cats" role="tablist" aria-label="Service category">
            {categories.map((c, k) => (
              <button type="button" role="tab" class="bk-cat" data-bk-tab={c.id} aria-selected={k === 0 ? 'true' : 'false'} style={`--h:${c.hue}`}>
                <span class="bk-ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[c.icon]} /></span>
                <span class="bk-cn"><b>{c.name}</b><small>{c.brands.length} brands · {c.issues.length} services</small></span>
                <span class="bk-cc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></span>
              </button>
            ))}
          </div>
        </aside>

        <div class="bk-main">
          {categories.map((c, k) => (
            <div class="bk-panel" data-bk-panel={c.id} hidden={k !== 0} style={`--h:${c.hue}`}>
              <div class="bk-hero">
                <div class="bk-hero-copy">
                  <span class="bk-eye">{c.name} services</span>
                  <h3>{(heroCopy[c.id] ?? [c.name, c.short])[0]}</h3>
                  <p>{(heroCopy[c.id] ?? [c.name, c.short])[1]}</p>
                  <ul class="bk-feats">
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg><span><b>Fast Service</b><small>In most areas</small></span></li>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg><span><b>Genuine Parts</b><small>Trusted repairs</small></span></li>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg><span><b>Affordable Price</b><small>Transparent pricing</small></span></li>
                  </ul>
                </div>
                <div class="bk-hero-art">
                  <span class="bk-orb"></span>
                  <span class:list={['bk-dev', { 'has-pic': !!c.image }]}>{c.image && <img class="bk-devpic" src={c.image} alt="" onerror={PIC_FAIL} />}<DeviceArt kind={artFor[c.id] ?? 'phone'} /></span>
                  <span class="bk-from"><small>From</small><b>{price()}</b><i></i></span>
                </div>
              </div>
              <!-- 1 brand · 2 model (drawn by the script), then 3 repairs -->
              <div class="bk-pick" data-bk-pick></div>
              <div class="bk-repairs" data-bk-repairs hidden>
                <div class="bk-sel-head">
                  <h4><span>3.</span> Add repairs</h4>
                  <small>Tap Add — use + for more than one</small>
                </div>
                <div class="bk-grid" aria-label={`Repairs for ${c.name}`}>
                  {c.services.map((sv) => (
                    <div class="bk-card" data-name={sv.name} data-pid={sv.id ?? ''} data-price={sv.price ?? ''} data-b={sv.b ?? ''} data-s={sv.s ?? ''} data-m={sv.m ?? ''}>
                      <span class:list={['bk-pic', { photo: !!picOf(c, sv.name, sv.image) }]}>{picOf(c, sv.name, sv.image) ? <img src={picOf(c, sv.name, sv.image)} alt={sv.name} loading="lazy" width="360" height="200" onerror="this.parentElement.classList.remove('photo');this.remove()" /> : null}<span class="bk-pic-art"><DeviceArt kind={artFor[c.id] ?? 'phone'} /></span><span class="bk-badge" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">${issueIcon(sv.name)}</svg>`} /></span>
                      <b>{sv.name}</b>
                      <small>{note(sv.name)}</small>
                      <span class="bk-foot">
                        <span>{odoo && sv.price ? <>from <em>{price(sv.price)}</em></> : <>From <em>{price()}</em></>}</span>
                        <button type="button" class="bk-add" data-bk-inc aria-label={`Add ${sv.name}`}>Add</button>
                        <span class="bk-qty" role="group" aria-label={`${sv.name} quantity`} hidden><button type="button" data-bk-dec aria-label="One less">−</button><output>1</output><button type="button" data-bk-inc aria-label="One more">+</button></span>
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          ))}
          <div class="bk-bar">
            <div class="bk-bar-t"><h4><span>4.</span> Book them together</h4><small data-bk-sum>Your repairs go into one cart — add more devices any time.</small></div>
            <button type="button" class="bk-cta" data-bk-checkout disabled><span data-bk-go>View cart &amp; book</span> <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
          </div>
        </div>
      </div>
<script>
  // Our Services: category → brand → model → repairs (Add / − n +) into the site cart, keyed
  // exactly like the booking wizard's lines; "View cart & book" opens the wizard's Cart step.
  type Model = { id: number | null; name: string; series: string; seriesId: number | null };
  type Cat = { id: string; odooId: number | null; name: string; brands: { id: string; odooId: number | null; name: string; logo: string | null; items: Model[] }[] };
  const bk = document.querySelector<HTMLElement>('[data-bk]');
  if (bk) {
    const cats: Cat[] = JSON.parse(bk.dataset.cats!);
    const odoo = !!bk.dataset.odoo;
    const cart = () => (window as any).danatCart;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const norm = (s: string) => s.toLowerCase().replace(/\s+/g, ' ').trim();
    const st = { cat: cats[0]?.id ?? '', brand: '', model: '', modelId: 0, seriesId: 0, picked: false, q: '' };
    const cat = () => cats.find((c) => c.id === st.cat)!;
    const brand = () => cat()?.brands.find((b) => b.id === st.brand);
    const panel = () => bk.querySelector<HTMLElement>(`[data-bk-panel="${st.cat}"]`)!;
    /** The device as the cart keys it - the same as the wizard's (category name + "Brand Model"). */
    const dev = () => ({
      device: cat().name, model: [brand()?.name, st.model].filter(Boolean).join(' '), cat: st.cat, brand: st.brand,
      ids: { category_id: cat().odooId || undefined, brand_id: brand()?.odooId || undefined, series_id: st.seriesId || undefined, model_id: st.modelId || undefined },
    });
    const MAX = 60;   // models listed before asking to search

    function drawPick() {
      const c = cat(), b = brand();
      const box = panel().querySelector<HTMLElement>('[data-bk-pick]')!;
      const crumb = b ? `<div class="bk-crumb"><span>${esc(c.name)} › <b>${esc(b.name)}</b>${st.picked ? ` › <b>${esc(st.model || 'Model not chosen')}</b>` : ''}</span>
        <button type="button" data-bk-reset="${st.picked ? 'model' : 'brand'}">Change</button></div>` : '';
      if (!b) {
        box.innerHTML = `<div class="bk-sel-head"><h4><span>1.</span> Choose the brand</h4><small>${c.brands.length} brands</small></div>
          <div class="bk-brands">${c.brands.map((x) => `<button type="button" class="bk-brand" data-bk-brand="${esc(x.id)}"><span${x.logo ? ' class="has-logo"' : ''}>${x.logo ? `<img src="${esc(x.logo)}" alt="" loading="lazy" onerror="this.parentElement.className='';this.remove()" />` : ''}<i>${esc(x.name[0])}</i></span><b>${esc(x.name)}</b><small>${x.items.length} models</small></button>`).join('')}</div>`;
      } else if (!st.picked) {
        const q = norm(st.q);
        const all = b.items.filter((m) => !q || norm(`${m.series} ${m.name}`).includes(q));
        const shown = all.slice(0, MAX);
        box.innerHTML = `${crumb}<div class="bk-sel-head"><h4><span>2.</span> Choose the model</h4><small>${all.length} model${all.length === 1 ? '' : 's'}</small></div>
          <div class="bk-mbox">
            <label class="bk-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg><input type="search" data-bk-q value="${esc(st.q)}" placeholder="Search ${esc(b.name)} models" aria-label="Search models" autocomplete="off" /></label>
            <div class="bk-models">${shown.map((m) => `<button type="button" class="bk-model" data-bk-model="${esc(m.name)}" data-id="${m.id ?? ''}" data-sid="${m.seriesId ?? ''}">${esc(m.name)}${m.series && m.series !== m.name ? `<small>${esc(m.series)}</small>` : ''}</button>`).join('')}</div>
            ${all.length > MAX ? `<p class="bk-mmore">Showing ${MAX} of ${all.length} — search to find yours.</p>` : ''}
            ${!all.length ? '<p class="bk-mmore">No match — type your model below, or skip.</p>' : ''}
            <div class="bk-mrow">
              ${odoo ? `<label class="bk-search sm"><input data-bk-typed maxlength="60" placeholder="Not in the list? Type your model" aria-label="Type your model" /></label><button type="button" class="bk-link" data-bk-typed-go>Use this model →</button>` : ''}
              <button type="button" class="bk-link" data-bk-skip>I don't know my model — skip →</button>
            </div>
          </div>`;
      } else {
        box.innerHTML = crumb;
      }
      panel().querySelector<HTMLElement>('[data-bk-repairs]')!.hidden = !st.picked;
      if (st.picked) paintCards();
    }

    // repairs for one brand / series / model only show once that device is chosen (as in the wizard)
    function paintCards() {
      const fits = (v: string | undefined, have: number) => !v || (have > 0 && Number(v) === have);
      const d = dev();
      panel().querySelectorAll<HTMLElement>('.bk-card').forEach((card) => {
        card.hidden = !(fits(card.dataset.b, brand()?.odooId || 0) && fits(card.dataset.s, st.seriesId) && fits(card.dataset.m, st.modelId));
        const n = cart()?.qty(d, card.dataset.name!) ?? 0;
        card.classList.toggle('in', n > 0);
        card.querySelector<HTMLElement>('.bk-add')!.hidden = n > 0;
        card.querySelector<HTMLElement>('.bk-qty')!.hidden = !n;
        card.querySelector('.bk-qty output')!.textContent = String(n || 1);
      });
    }
    function paintBar() {
      const n: number = cart()?.count() ?? 0;
      const devices: number = cart()?.items().length ?? 0;
      bk.querySelector<HTMLButtonElement>('[data-bk-checkout]')!.disabled = !n;
      bk.querySelector('.bk-bar')!.classList.toggle('empty', !n);
      document.documentElement.classList.toggle('bk-bar-on', !!n && bkSeen);
      bk.querySelector('[data-bk-go]')!.textContent = n ? `View cart (${n}) & book` : 'View cart & book';
      bk.querySelector('[data-bk-sum]')!.textContent = n
        ? `${n} repair${n === 1 ? '' : 's'} on ${devices} device${devices === 1 ? '' : 's'} in your cart.`
        : 'Your repairs go into one cart — add more devices any time.';
    }
    const choose = (model: string, modelId = 0, seriesId = 0) => { st.model = model; st.modelId = modelId; st.seriesId = seriesId; st.picked = true; st.q = ''; drawPick(); };

    bk.addEventListener('click', (e) => {
      const t = (e.target as HTMLElement).closest<HTMLElement>('button');
      if (!t || !bk.contains(t)) return;
      if (t.dataset.bkBrand) { st.brand = t.dataset.bkBrand; st.picked = false; st.model = ''; st.modelId = 0; st.seriesId = 0; st.q = ''; drawPick(); return; }
      if (t.dataset.bkModel) { choose(t.dataset.bkModel, Number(t.dataset.id) || 0, Number(t.dataset.sid) || 0); return; }
      if (t.matches('[data-bk-skip]')) { choose(''); return; }
      if (t.matches('[data-bk-typed-go]')) {
        const inp = panel().querySelector<HTMLInputElement>('[data-bk-typed]')!;
        if (inp.value.trim().length < 2) { inp.focus(); return; }
        choose(inp.value.trim()); return;
      }
      if (t.dataset.bkReset) {
        if (t.dataset.bkReset === 'brand') st.brand = '';
        st.picked = false; st.model = ''; st.modelId = 0; st.seriesId = 0; st.q = '';
        drawPick(); return;
      }
      const card = t.closest<HTMLElement>('.bk-card');
      if (card && cart() && (t.matches('[data-bk-inc]') || t.matches('[data-bk-dec]'))) {
        const d = dev(), name = card.dataset.name!;
        cart().set(d, name, cart().qty(d, name) + (t.matches('[data-bk-dec]') ? -1 : 1),
          { pid: Number(card.dataset.pid) || undefined, px: card.dataset.price ? Number(card.dataset.price) : null });
        return;
      }
      if (t.matches('[data-bk-checkout]')) window.dispatchEvent(new CustomEvent('danat-checkout'));
    });
    bk.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      if (!t.matches('[data-bk-q]')) return;
      st.q = t.value; drawPick();
      const q = panel().querySelector<HTMLInputElement>('[data-bk-q]')!;
      q.focus(); q.setSelectionRange(q.value.length, q.value.length);
    });
    bk.querySelectorAll<HTMLElement>('[data-bk-tab]').forEach((tab) => tab.addEventListener('click', () => {
      bk.querySelectorAll('[data-bk-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === tab)));
      bk.querySelectorAll<HTMLElement>('[data-bk-panel]').forEach((p) => (p.hidden = p.dataset.bkPanel !== tab.dataset.bkTab));
      if (st.cat !== tab.dataset.bkTab) { st.cat = tab.dataset.bkTab!; st.brand = ''; st.picked = false; st.model = ''; st.modelId = 0; st.seriesId = 0; st.q = ''; }
      drawPick();
      if (bk.getBoundingClientRect().top < 0) bk.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }));
    let bkSeen = false;   // while the panel is on screen its bar sticks to the bottom: lift the floating buttons
    new IntersectionObserver(([en]) => { bkSeen = en.isIntersecting; paintBar(); }).observe(bk);
    window.addEventListener('danat-cart', () => { if (st.picked) paintCards(); paintBar(); });
    const start = () => { drawPick(); paintBar(); };
    if (cart()) start(); else document.addEventListener('DOMContentLoaded', start, { once: true });
  }
</script>

<style>
  #all { scroll-margin-top: 90px; }
  .bk { display: grid; grid-template-columns: 318px minmax(0, 1fr); gap: 22px; align-items: start; --g: var(--violet); --g2: var(--deep, #0f6b37); }
  .bk-side { position: sticky; top: 96px; padding: 22px 16px; background: var(--surface); border: 1px solid var(--line); border-radius: 26px; box-shadow: var(--shadow); }
  .bk-side h3 { font-size: 18px; padding: 0 8px; }
  .bk-side > p { font-size: 13px; color: var(--ink-3); padding: 2px 8px 14px; }
  .bk-cats { display: grid; gap: 6px; }
  .bk-cat { display: flex; align-items: center; gap: 14px; padding: 10px 12px; border: 0; border-radius: 16px; background: none; text-align: left; transition: background .2s; }
  .bk-cat:hover { background: var(--tint); }
  .bk-ci { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px; background: hsl(var(--h) 70% 94%); color: hsl(var(--h) 60% 40%); flex: none; }
  .bk-ci svg { width: 23px; height: 23px; }
  .bk-cn { flex: 1; display: grid; }
  .bk-cn b { font-size: 14.5px; color: var(--ink); white-space: nowrap; }
  .bk-cn small { font-size: 12.5px; color: var(--ink-3); }
  .bk-cc { width: 16px; height: 16px; color: var(--ink-3); }
  .bk-cc svg { width: 100%; height: 100%; }
  .bk-cat[aria-selected='true'] { background: linear-gradient(135deg, var(--violet), var(--deep, #0f6b37)); box-shadow: 0 12px 24px -14px rgba(var(--a1),.9); }
  .bk-cat[aria-selected='true'] .bk-ci { background: rgba(255,255,255,.18); color: #fff; }
  .bk-cat[aria-selected='true'] b, .bk-cat[aria-selected='true'] .bk-cc { color: #fff; }
  .bk-cat[aria-selected='true'] small { color: rgba(255,255,255,.8); }

  .bk-main { display: grid; gap: 18px; min-width: 0; }
  .bk-panel { display: grid; gap: 18px; animation: bkIn .45s cubic-bezier(.2,.8,.2,1); }
  .bk-panel[hidden] { display: none; }
  @keyframes bkIn { from { opacity: 0; transform: translateY(12px); } }
  .bk-hero { position: relative; display: grid; grid-template-columns: 1.3fr 1fr; align-items: center; min-height: 290px; padding: 30px 34px; border-radius: 28px; overflow: hidden; background: linear-gradient(120deg, #f4faf5 0%, #e3f3e7 55%, #c9ead3 100%); }
  .bk-eye { display: inline-flex; align-items: center; gap: 12px; font-size: 13px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; color: #3e4c45; }
  .bk-eye::before { content: ''; width: 26px; height: 2px; background: var(--g); }
  .bk-hero h3 { font-family: var(--display); font-size: 28px; font-weight: 800; line-height: 1.1; letter-spacing: -.02em; color: var(--ink); margin: 10px 0 12px; max-width: 14ch; }
  .bk-hero p { font-size: 16px; color: #45524b; max-width: 40ch; }
  .bk-feats { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px 18px; }
  .bk-feats li { white-space: nowrap; }
  .bk-feats li { display: flex; align-items: center; gap: 10px; }
  .bk-feats svg { width: 26px; height: 26px; color: var(--g); flex: none; }
  .bk-feats b { display: block; font-size: 14px; color: #16211b; }
  .bk-feats small { font-size: 12.5px; color: #6a7770; }
  .bk-hero-art { position: relative; height: 100%; min-height: 230px; display: grid; place-items: center; }
  .bk-orb { position: absolute; width: 330px; height: 330px; right: -40px; border-radius: 50%; background: radial-gradient(circle, rgba(47,160,90,.35), rgba(47,160,90,.08) 60%, transparent 70%); }
  .bk-dev { position: relative; width: 250px; height: 250px; filter: drop-shadow(0 24px 24px rgba(10,50,25,.3)); animation: bkFloat 4s ease-in-out infinite; }
  @keyframes bkFloat { 50% { transform: translateY(-8px) rotate(-2deg); } }
