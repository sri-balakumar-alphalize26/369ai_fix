---
// "Our Services" booking panel (restored design): category sidebar, device
// banner, repair photo cards, sticky Book on WhatsApp / Add to cart bar.
import DeviceArt from './DeviceArt.astro';
import { price, site } from '../data/site';
import { categories, iconPaths } from '../data/devices';
import { artFor, note } from '../data/menu';
const wa = (m: string) => `https://wa.me/${site.phone.tel.replace('+', '')}?text=${encodeURIComponent(m)}`;

// Real repair photos (public/media/repairs) — one shared list; others fall back to the illustration.
import { photo } from '../data/photos';
const heroCopy: Record<string, [string, string]> = {
  mobile: ['Keep Your Phone Working Like New', 'Screen, battery, charging, camera and more – quick and reliable service.'],
  tablet: ['Your Tablet, Good as New', 'Cracked glass, batteries and charging faults fixed fast.'],
  laptop: ['Laptop Trouble? Sorted.', 'Screens, keyboards, hinges, batteries and board-level repair.'],
  desktop: ['Desktops Back to Full Speed', 'Power, boards, upgrades and clean OS installs.'],
  printer: ['Printers That Just Work', 'Jams, print quality, toner and setup – serviced on-site.'],
  cctv: ['Security You Can See', 'Survey, install and remote viewing for homes and shops.'],
  network: ['Wi-Fi in Every Room', 'Mesh, routers, cabling and office networks.'],
  data: ['Get Your Files Back', 'Deleted files, dead drives and formatted disks recovered.'],
  itsupport: ['IT Help When You Need It', 'Software, email, tune-ups and maintenance plans.'],
};
const issueIcon = (s: string) => {
  const t = s.toLowerCase();
  const I: [RegExp, string][] = [
    [/back glass/, '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><circle cx="10" cy="7" r="1.6"/><circle cx="14" cy="7" r="1.6"/>'],
    [/screen|glass|display/, '<rect x="6" y="2.5" width="12" height="19" rx="2.5"/><path d="M9 6l6 6M9 11l3 3"/>'],
    [/battery/, '<rect x="7" y="4" width="10" height="17" rx="2"/><path d="M10 2h4M12 9l-2 4h4l-2 4"/>'],
    [/charg|power/, '<path d="M9 3v5M15 3v5M6 8h12v3a6 6 0 0 1-12 0zM12 17v4"/>'],
    [/camera|cctv|viewing|dvr/, '<path d="M4 8h3l2-3h6l2 3h3v11H4z"/><circle cx="12" cy="13" r="3.5"/>'],
    [/water|fire/, '<path d="M12 3s6 7 6 11a6 6 0 0 1-12 0c0-4 6-11 6-11z"/>'],
    [/speaker|micro/, '<path d="M4 9h4l5-4v14l-5-4H4zM17 9a4 4 0 0 1 0 6"/>'],
    [/wi-?fi|router|mesh|lan|network|switch/, '<path d="M2 9a15 15 0 0 1 20 0M5.5 12.5a10 10 0 0 1 13 0M9 16a5 5 0 0 1 6 0"/><circle cx="12" cy="19.5" r="1"/>'],
    [/drive|ssd|ram|disk|deleted|format|recover/, '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3 14h18"/>'],
    [/paper|toner|cartridge|roller|print/, '<path d="M7 9V3.5h10V9"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v6.5H7z"/>'],
  ];
  return I.find(([re]) => re.test(t))?.[1] ?? '<path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.5 2.5-2.5-.5-.5-2.5z"/>';
};
import { reviews, sample } from '../data/reviews';
import Testimonials from '../components/Testimonials.astro';
import { serviceModes, price, site } from '../data/site';
import { categories, totals, iconPaths } from '../data/devices';
import { coverage } from '../data/coverage';
import { homeServices, milestones, awards, awardsSample, wa } from '../data/home';
import { statSync } from 'node:fs';

const stamp = (f: string) => { try { return `/media/${f}?v=${Math.floor(statSync(`public/media/${f}`).mtimeMs / 1000)}`; } catch { return `/media/${f}`; } };
const heroVideo = stamp('kling.mp4');
const heroPoster = stamp('kling.jpg');
const coverageCount = new Set(Object.values(coverage).flatMap((m) => m.zones.flatMap((z) => z.areas))).size;

const allBrands = [...new Set(categories.flatMap((c) => c.brands.map((b) => b.name)))];

const formats = [
  { id: 'image', label: 'Image' },
  { id: 'post', label: 'Post' },
  { id: 'video', label: 'Video' },
] as const;
const angles = [
  { id: 'flat', label: '0° Flat' },
  { id: 'tilt', label: '15° Tilt' },
  { id: 'iso', label: '3D Isometric' },
] as const;
---

      <div class="bk" data-bk>
        <aside class="bk-side">
          <h3>Our Services</h3>
          <p>Choose a category to find the service you need.</p>
          <div class="bk-cats" role="tablist" aria-label="Service category">
            {categories.map((c, k) => (
              <button type="button" role="tab" class="bk-cat" data-bk-tab={c.id} aria-selected={k === 0 ? 'true' : 'false'} style={`--h:${c.hue}`}>
                <span class="bk-ci"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[c.icon]} /></span>
                <span class="bk-cn"><b>{c.name}</b><small>{c.issues.length} services</small></span>
                <span class="bk-cc"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></span>
              </button>
            ))}
          </div>
        </aside>

        <div class="bk-main">
          {categories.map((c, k) => (
            <div class="bk-panel" data-bk-panel={c.id} hidden={k !== 0} style={`--h:${c.hue}`}>
              <div class="bk-hero">
                <div class="bk-hero-copy">
                  <span class="bk-eye">{c.name} services</span>
                  <h3>{heroCopy[c.id][0]}</h3>
                  <p>{heroCopy[c.id][1]}</p>
                  <ul class="bk-feats">
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L4 14h7l-1 8 9-12h-7z"/></svg><span><b>Fast Service</b><small>In most areas</small></span></li>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg><span><b>Genuine Parts</b><small>Trusted repairs</small></span></li>
                    <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg><span><b>Affordable Price</b><small>Transparent pricing</small></span></li>
                  </ul>
                </div>
                <div class="bk-hero-art">
                  <span class="bk-orb"></span>
                  <span class="bk-dev"><DeviceArt kind={artFor[c.id]} /></span>
                  <span class="bk-from"><small>From</small><b>{price()}</b><i></i></span>
                </div>
              </div>
              <div class="bk-sel-head">
                <h4><span>1.</span> Select the repair service</h4>
                <small>Showing <b data-count={c.issues.length}>{c.issues.length}</b> services</small>
              </div>
              <div class="bk-grid" role="radiogroup" aria-label={`Services for ${c.name}`}>
                {c.issues.map((iss, i) => (
                  <button type="button" role="radio" class="bk-card" aria-checked={i === 0 ? 'true' : 'false'} data-name={iss} data-wa={wa(`Hi Danat Fix, I want to book a ${iss} service for my ${c.name.replace(/ &.*$/, '').replace(/s$/, '').toLowerCase()}.`)}>
                    <span class:list={['bk-pic', { photo: photo[`${c.id}:${iss}`] }]}>{photo[`${c.id}:${iss}`] ? <img src={`/media/repairs/${photo[`${c.id}:${iss}`]}.jpg`} alt={iss} loading="lazy" width="360" height="200" /> : <span class="bk-pic-art"><DeviceArt kind={artFor[c.id]} /></span>}<span class="bk-badge" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">${issueIcon(iss)}</svg>`} /></span>
                    <b>{iss}</b>
                    <small>{note(iss)}</small>
                    <span class="bk-foot"><span>From <em>{price()}</em></span><span class="bk-go"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span></span>
                  </button>
                ))}
              </div>
            </div>
          ))}
          <div class="bk-bar">
            <div class="bk-bar-t"><h4><span>2.</span> Book on WhatsApp</h4><small>Click the button and send your request.</small></div>
            <button type="button" class="bk-addcart" data-bk-add><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 3.5h2.2l2.4 11.2a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.1l1.8-7.3H6"/><circle cx="9.5" cy="19.8" r="1.4"/><circle cx="17" cy="19.8" r="1.4"/></svg>Add to cart</button>
            <a class="bk-cta" data-bk-cta target="_blank" rel="noopener" href={wa(`Hi Danat Fix, I want to book a ${categories[0].issues[0]} service for my mobile phone.`)}><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg> <span>Book <b data-bk-name>{categories[0].issues[0]}</b> on WhatsApp</span> <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
            <p class="bk-info"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/></svg>Your message is pre-filled.<br />Just press send.</p>
          </div>
        </div>
      </div>
<script>
  // Booking: category sidebar → service cards → one WhatsApp button
  const bk = document.querySelector<HTMLElement>('[data-bk]');
  if (bk) {
    const cta = bk.querySelector<HTMLAnchorElement>('[data-bk-cta]')!;
    bk.querySelector('[data-bk-add]')!.addEventListener('click', () => {
      const card = bk.querySelector<HTMLElement>('.bk-panel:not([hidden]) .bk-card[aria-checked="true"]')!;
      const dev = bk.querySelector<HTMLElement>('[data-bk-tab][aria-selected="true"] b')!.textContent!;
      (window as any).danatCart?.add({ device: dev, model: '', issues: [card.dataset.name!] });
    });
    const setCta = (card: HTMLElement) => { cta.href = card.dataset.wa!; bk.querySelector('[data-bk-name]')!.textContent = card.dataset.name!; };
    bk.querySelectorAll<HTMLElement>('.bk-card').forEach((card) => card.addEventListener('click', () => {
      card.parentElement!.querySelectorAll('.bk-card').forEach((o) => o.setAttribute('aria-checked', String(o === card)));
      setCta(card);
    }));
    bk.querySelectorAll<HTMLElement>('[data-bk-tab]').forEach((t) => t.addEventListener('click', () => {
      bk.querySelectorAll('[data-bk-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      bk.querySelectorAll<HTMLElement>('[data-bk-panel]').forEach((p) => (p.hidden = p.dataset.bkPanel !== t.dataset.bkTab));
      const panel = bk.querySelector<HTMLElement>(`[data-bk-panel="${t.dataset.bkTab}"]`)!;
      setCta(panel.querySelector<HTMLElement>('.bk-card[aria-checked="true"]')!);
      panel.querySelectorAll<HTMLElement>('[data-count]').forEach((n) => (window as any).__countUp?.(n));
      if (bk.getBoundingClientRect().top < 0) bk.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }));
  }
</script>

<style>
  #all { scroll-margin-top: 90px; }
  .bk { display: grid; grid-template-columns: 318px minmax(0, 1fr); gap: 22px; align-items: start; --g: var(--violet); --g2: var(--deep, #0f6b37); }
  .bk-side { position: sticky; top: 96px; padding: 22px 16px; background: var(--surface); border: 1px solid var(--line); border-radius: 26px; box-shadow: var(--shadow); }
  .bk-side h3 { font-size: 22px; padding: 0 8px; }
  .bk-side > p { font-size: 13px; color: var(--ink-3); padding: 2px 8px 14px; }
  .bk-cats { display: grid; gap: 6px; }
  .bk-cat { display: flex; align-items: center; gap: 14px; padding: 10px 12px; border: 0; border-radius: 16px; background: none; text-align: left; transition: background .2s; }
  .bk-cat:hover { background: var(--tint); }
  .bk-ci { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px; background: hsl(var(--h) 70% 94%); color: hsl(var(--h) 60% 40%); flex: none; }
  .bk-ci svg { width: 23px; height: 23px; }
  .bk-cn { flex: 1; display: grid; }
  .bk-cn b { font-size: 14.5px; color: var(--ink); white-space: nowrap; }
  .bk-cn small { font-size: 12.5px; color: var(--ink-3); }
  .bk-cc { width: 16px; height: 16px; color: var(--ink-3); }
  .bk-cc svg { width: 100%; height: 100%; }
  .bk-cat[aria-selected='true'] { background: linear-gradient(135deg, var(--violet), var(--deep, #0f6b37)); box-shadow: 0 12px 24px -14px rgba(var(--a1),.9); }
  .bk-cat[aria-selected='true'] .bk-ci { background: rgba(255,255,255,.18); color: #fff; }
  .bk-cat[aria-selected='true'] b, .bk-cat[aria-selected='true'] .bk-cc { color: #fff; }
  .bk-cat[aria-selected='true'] small { color: rgba(255,255,255,.8); }

  .bk-main { display: grid; gap: 18px; min-width: 0; }
  .bk-panel { display: grid; gap: 18px; animation: bkIn .45s cubic-bezier(.2,.8,.2,1); }
  .bk-panel[hidden] { display: none; }
  @keyframes bkIn { from { opacity: 0; transform: translateY(12px); } }
  .bk-hero { position: relative; display: grid; grid-template-columns: 1.3fr 1fr; align-items: center; min-height: 290px; padding: 30px 34px; border-radius: 28px; overflow: hidden; background: linear-gradient(120deg, #f4faf5 0%, #e3f3e7 55%, #c9ead3 100%); }
  .bk-eye { display: inline-flex; align-items: center; gap: 12px; font-size: 13px; font-weight: 700; letter-spacing: .24em; text-transform: uppercase; color: #3e4c45; }
  .bk-eye::before { content: ''; width: 26px; height: 2px; background: var(--g); }
  .bk-hero h3 { font-family: var(--display); font-size: clamp(30px, 3.2vw, 46px); font-weight: 800; line-height: 1.02; letter-spacing: -.02em; color: var(--ink); margin: 10px 0 12px; max-width: 14ch; }
  .bk-hero p { font-size: 16px; color: #45524b; max-width: 40ch; }
  .bk-feats { list-style: none; margin: 18px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px 18px; }
  .bk-feats li { white-space: nowrap; }
  .bk-feats li { display: flex; align-items: center; gap: 10px; }
  .bk-feats svg { width: 26px; height: 26px; color: var(--g); flex: none; }
  .bk-feats b { display: block; font-size: 14px; color: #16211b; }
  .bk-feats small { font-size: 12.5px; color: #6a7770; }
  .bk-hero-art { position: relative; height: 100%; min-height: 230px; display: grid; place-items: center; }
  .bk-orb { position: absolute; width: 330px; height: 330px; right: -40px; border-radius: 50%; background: radial-gradient(circle, rgba(47,160,90,.35), rgba(47,160,90,.08) 60%, transparent 70%); }
  .bk-dev { position: relative; width: 250px; height: 250px; filter: drop-shadow(0 24px 24px rgba(10,50,25,.3)); animation: bkFloat 4s ease-in-out infinite; }
  @keyframes bkFloat { 50% { transform: translateY(-8px) rotate(-2deg); } }
  .bk-from { position: absolute; right: 0; bottom: 34px; display: grid; justify-items: center; padding: 12px 22px; border-radius: 18px; background: #fff; box-shadow: 0 16px 30px -14px rgba(0,0,0,.3); transform: rotate(-6deg); }
  .bk-from small { font-size: 14px; font-weight: 600; color: #16211b; }
  .bk-from b { font-family: var(--display); font-size: 30px; font-weight: 800; color: var(--g2); line-height: 1; }
  .bk-from i { position: absolute; right: -14px; top: -16px; width: 22px; height: 22px; background: radial-gradient(circle, var(--g) 30%, transparent 32%) 0 0 / 8px 8px; opacity: .6; }

  .bk-sel-head { display: flex; justify-content: space-between; align-items: center; padding: 0 4px; }
  .bk-sel-head h4, .bk-bar h4 { font-size: 20px; }
  .bk-sel-head h4 span, .bk-bar h4 span { color: var(--g2); }
  .bk-sel-head small { font-size: 13px; color: var(--ink-3); }
  .bk-sel-head b { color: var(--g2); }
  .bk-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .bk-card { display: flex; flex-direction: column; gap: 4px; padding: 10px 10px 14px; border: 1.5px solid var(--line); border-radius: 18px; background: var(--surface); text-align: left; transition: border-color .2s, transform .25s, box-shadow .25s; }
  .bk-card:hover { transform: translateY(-4px); box-shadow: 0 18px 30px -20px rgba(0,0,0,.4); }
  .bk-card[aria-checked='true'] { border-color: var(--g); box-shadow: 0 0 0 3px rgba(31,138,76,.12); }
  .bk-pic { position: relative; display: grid; place-items: center; height: 118px; margin-bottom: 8px; border-radius: 12px; background: linear-gradient(160deg, hsl(var(--h) 60% 96%), hsl(var(--h) 55% 90%)); overflow: hidden; }
  .bk-card[aria-checked='true'] .bk-pic { background: linear-gradient(160deg, #eef8f0, #d7efdd); }
  .bk-pic.photo { background: #111; }
  .bk-pic img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .45s cubic-bezier(.2,.8,.2,1); }
  .bk-card:hover .bk-pic img { transform: scale(1.08); }
  .bk-pic-art { width: 110px; height: 110px; margin-top: 18px; transition: transform .35s; }
  .bk-card:hover .bk-pic-art { transform: scale(1.08) rotate(-3deg); }
  .bk-badge { position: absolute; z-index: 1; left: 8px; top: 8px; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 10px; background: #fff; color: hsl(var(--h) 60% 40%); box-shadow: 0 4px 10px -4px rgba(0,0,0,.25); }
  .bk-badge :global(svg) { width: 18px; height: 18px; }
  .bk-card > b { font-size: 15.5px; color: var(--ink); padding: 0 4px; }
  .bk-card > small { font-size: 12.5px; color: var(--ink-3); padding: 0 4px; }
  .bk-foot { display: flex; align-items: center; justify-content: space-between; margin-top: auto; padding: 10px 4px 0; font-size: 13px; color: var(--ink-2); }
  .bk-foot em { font-style: normal; font-family: var(--display); font-size: 18px; font-weight: 800; color: var(--g2); }
  .bk-go { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--line); color: var(--ink); transition: background .2s, color .2s; }
  .bk-go svg { width: 16px; height: 16px; }
  .bk-card:hover .bk-go, .bk-card[aria-checked='true'] .bk-go { background: var(--g); border-color: var(--g); color: #fff; }

  .bk-bar { position: sticky; bottom: 14px; z-index: 5; display: grid; grid-template-columns: auto 1fr auto auto; align-items: center; gap: 22px; padding: 16px 20px; background: var(--surface); border: 1px solid var(--line); border-radius: 22px; box-shadow: 0 20px 40px -24px rgba(0,0,0,.35); }
  .bk-bar-t h4 { white-space: nowrap; }
  .bk-bar-t small { font-size: 13px; color: var(--ink-3); }
  .bk-cta { justify-self: center; display: inline-flex; align-items: center; gap: 12px; padding: 16px 28px; border-radius: 999px; background: linear-gradient(180deg, var(--violet), var(--deep, #0f6b37)); color: #fff; font-weight: 700; font-size: 16px; white-space: nowrap; box-shadow: 0 14px 28px -14px rgba(15,122,60,.9); transition: transform .2s; }
  .bk-cta:hover { transform: translateY(-2px); }
  .bk-cta > svg:first-child { width: 22px; height: 22px; flex: none; }
  .bk-cta > svg:last-child { width: 18px; height: 18px; flex: none; }
  .bk-addcart { display: inline-flex; align-items: center; gap: 8px; justify-self: end; padding: 14px 20px; border: 1.5px solid var(--g); border-radius: 999px; background: var(--surface); color: var(--g2); font-weight: 700; font-size: 15px; white-space: nowrap; transition: transform .2s; }
  .bk-addcart:hover { transform: translateY(-2px); background: #eef8f0; }
  .bk-addcart svg { width: 19px; height: 19px; }
  .bk-info { display: flex; align-items: center; gap: 12px; padding: 12px 18px; border-radius: 14px; background: #eef8f0; font-size: 13px; color: #33443a; }
  .bk-info svg { width: 22px; height: 22px; color: var(--g); flex: none; }

  @media (max-width: 1799px) { .bk-info { display: none; } .bk-bar { grid-template-columns: auto 1fr auto; } }
  @media (max-width: 1200px) { .bk-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .bk-bar { grid-template-columns: 1fr; justify-items: start; } .bk-cta { justify-self: stretch; justify-content: center; } }
  @media (max-width: 960px) {
    .bk { grid-template-columns: 1fr; }
    .bk-side { position: static; }
    .bk-cats { display: flex; overflow-x: auto; }
    .bk-cat { flex: none; }
    .bk-cc { display: none; }
    .bk-hero { grid-template-columns: 1fr; }
    .bk-hero-art { display: none; }
    .bk-grid { grid-template-columns: 1fr 1fr; }
