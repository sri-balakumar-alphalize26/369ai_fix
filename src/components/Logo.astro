---
// 369 ai Fix wordmark: badge (wrench + rising orange arrow, from the 369 ai.Biz
// parent mark) + "369 ai Fix". Text inherits the site's display font.
interface Props { class?: string; mono?: boolean }
const { class: cls, mono = false } = Astro.props;
const u = Math.random().toString(36).slice(2, 7);
---

<svg class:list={['logo369', cls, { mono }]} viewBox="0 0 222 52" role="img" aria-label="369 ai Fix">
  <defs>
    <linearGradient id={`b-${u}`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#2fa8e6" /><stop offset="1" stop-color="#1459a8" />
    </linearGradient>
    <linearGradient id={`o-${u}`} x1="0" y1="1" x2="1" y2="0">
      <stop offset="0" stop-color="#ff5e14" /><stop offset="1" stop-color="#ffab2e" />
    </linearGradient>
  </defs>
  <!-- badge -->
  <rect x="1" y="2" width="48" height="48" rx="14" fill={`url(#b-${u})`} />
  <g transform="translate(9 10) scale(1.35)" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
    <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
  </g>
  <path d="M6 43 C18 40 30 32 40 14" fill="none" stroke={`url(#o-${u})`} stroke-width="3.6" stroke-linecap="round" />
  <path d="M34.5 13.5 L41.5 9.5 L42.5 17.5" fill="none" stroke={`url(#o-${u})`} stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" />
  <!-- wordmark -->
  <text x="60" y="35"><tspan class="w369" fill={mono ? 'currentColor' : `url(#b-${u})`}>369</tspan><tspan class="wai" dx="7">ai</tspan><tspan class="wfix" dx="6" fill={`url(#o-${u})`}>Fix</tspan></text>
  <text x="61" y="48.5" class="wtag">DOORSTEP REPAIR</text>
</svg>

<style>
  .logo369 { display: block; height: 46px; width: auto; overflow: visible; }
  .w369, .wai, .wfix { font-family: var(--display); font-weight: 800; font-size: 30px; letter-spacing: -.02em; }
  .wai { fill: #6b7280; font-weight: 700; }
  .mono .wai { fill: currentColor; opacity: .75; }
  .wtag { font-family: var(--body); font-size: 7.6px; font-weight: 700; letter-spacing: .32em; fill: #8a918e; }
  .mono .wtag { fill: currentColor; opacity: .6; }
</style>
