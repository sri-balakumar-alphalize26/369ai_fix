---
// "Spin & Win" offer popup. The prizes (slices), their colours and every text come from Odoo
// (Fix Website ▸ Pop-ups & chat ▸ Spin & Win), else the site's own (src/data/popups.ts).
// Odoo decides the rest (/api/spin): the customer signs in with their mobile and a WhatsApp code
// once (the site's own sign-in, so booking needs no second code), spins once in `every_days`,
// Odoo picks the slice by its chance and gives the winner their own code; the wheel only turns
// to that slice. The prize goes on their next booking by itself. Opening the wheel again shows
// the prize they already have.
import { staticContent, contactOf, type Contact, type Wheel, type WheelIcon } from '../lib/content';
import { DIAL } from '../lib/phone';
// WhatsApp number and the wheel from Odoo (passed by Popups), else the site's own.
const { contact = contactOf(), wheel = staticContent().wheel } = Astro.props as { contact?: Contact; wheel?: Wheel };

const I: Record<WheelIcon, string> = {
  diag: '<circle cx="11" cy="11" r="6"/><path d="M20 20l-4.5-4.5M9 11h4M11 9v4"/>',
  pick: '<circle cx="6" cy="17" r="3"/><circle cx="18" cy="17" r="3"/><path d="M6 17h5l3-7h4M14 10l-2-3H9"/>',
  clean: '<path d="M12 3l1.8 4.2L18 9l-4.2 1.8L12 15l-1.8-4.2L6 9l4.2-1.8zM19 15l.8 1.9L22 18l-2.2.9L19 21l-.8-2.1L16 18l2.2-1.1z"/>',
  fast: '<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>',
  data: '<path d="M7 18a5 5 0 0 1-.5-10A6 6 0 0 1 18 9a4.5 4.5 0 0 1-1 9zM12 11v6M9.5 14.5L12 17l2.5-2.5"/>',
  guard: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/>',
};
const prizes = wheel.slices.map((p) => ({ ...p, icon: I[p.icon] ?? I.diag }));
const n = prizes.length;
const seg = 360 / n;
const R = 148;
const pt = (deg: number, r = R) => {
  const a = ((deg - 90) * Math.PI) / 180;
  return [160 + r * Math.cos(a), 160 + r * Math.sin(a)].map((v) => v.toFixed(2)).join(' ');
};
const wa = (msg: string) => `https://wa.me/${contact.wa}?text=${encodeURIComponent(msg)}`;
---

<div class="sw" data-sw hidden data-prizes={JSON.stringify(prizes.map(({ id, full, code }) => ({ id, full, code })))}>
  <div class="sw-bg" data-sw-x></div>
  <div class="sw-card" role="dialog" aria-modal="true" aria-labelledby="sw-title">
    <button type="button" class="sw-x" data-sw-x aria-label="Close">×</button>

    <header class="sw-head">
      <span class="sw-kicker">{wheel.eyebrow}</span>
      <h2 id="sw-title">{wheel.title} <em>{wheel.title2}</em></h2>
      <p>{wheel.subtitle}</p>
    </header>

    <div class="sw-stage">
      <div class="sw-halo" aria-hidden="true"></div>
      <div class="sw-ring" aria-hidden="true"></div>
      <svg class="sw-wheel" data-sw-wheel viewBox="0 0 320 320" aria-hidden="true">
        <defs>
          <radialGradient id="sw-gloss" cx=".5" cy=".3" r=".7">
            <stop offset="0" stop-color="#fff" stop-opacity=".35" /><stop offset=".6" stop-color="#fff" stop-opacity="0" />
          </radialGradient>
        </defs>
        {prizes.map((p, i) => {
          const a0 = i * seg, a1 = (i + 1) * seg, mid = a0 + seg / 2;
          return (
            <g class="s" style={`color:${p.text_color}`}>
              <path d={`M160 160 L${pt(a0)} A${R} ${R} 0 0 1 ${pt(a1)} Z`} style={`fill:${p.color}`} />
              <g transform={`rotate(${mid} 160 160)`}>
                <g transform="translate(148 30) scale(1)" class="ico" set:html={`<g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${p.icon}</g>`} />
                <text x="160" y="76" class="t1">{p.top}</text>
                <text x="160" y="93" class="t2">{p.label}</text>
              </g>
            </g>
          );
        })}
        {[...Array(n)].map((_, i) => { const [x1, y1] = pt(i * seg, 34).split(' '); const [x2, y2] = pt(i * seg, 148).split(' '); return <line x1={x1} y1={y1} x2={x2} y2={y2} class="div" />; })}
        <circle cx="160" cy="160" r="148" fill="url(#sw-gloss)" pointer-events="none" />
        {[...Array(n * 3)].map((_, i) => { const [x, y] = pt(i * (seg / 3), 156).split(' '); return <circle cx={x} cy={y} r="2.6" class="bulb" style={`--i:${i}`} />; })}
      </svg>
      <span class="sw-pointer" aria-hidden="true"><i></i></span>
      <button type="button" class="sw-hub" data-sw-spin aria-label="Spin the wheel"><span>SPIN</span></button>
    </div>

    <div class="sw-foot" data-sw-before>
      <!-- not signed in: the mobile and a WhatsApp code, once (the site's own sign-in); signed in: just spin -->
      <div class="sw-signin" data-sw-signin hidden>
        <p class="sw-why">Sign in with your mobile to spin — one spin per customer every {wheel.every_days} days.</p>
        <div class="sw-ph">
          <select data-sw-cc aria-label="Country code">{DIAL.map((d) => <option value={d.cc} selected={d.cc === 'om'}>{d.code} {d.name}</option>)}</select>
          <input data-sw-phone inputmode="tel" maxlength="16" autocomplete="tel-national" placeholder="9123 4567" aria-label="Mobile number" />
        </div>
        <input data-sw-name data-sw-new hidden autocomplete="name" maxlength="60" placeholder="Your name" aria-label="Your name" />
        <input data-sw-code data-sw-codebox hidden inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="6-digit code from WhatsApp" aria-label="Code from WhatsApp" />
        <!-- an existing account whose number isn't proven yet confirms its password once (369 Mart's rule) -->
        <input data-sw-pass data-sw-passbox hidden type="password" autocomplete="current-password" maxlength="128" placeholder="Your password (once, to confirm it's you)" aria-label="Password" />
        <div class="sw-sbtns">
          <button type="button" class="btn sw-send" data-sw-send>Send code on WhatsApp</button>
          <button type="button" class="btn btn-primary" data-sw-verify hidden>Sign in</button>
        </div>
      </div>
      <p class="sw-as" data-sw-as hidden></p>
      <p class="sw-msg" data-sw-msg role="status" hidden></p>
      <button type="button" class="btn btn-primary sw-go" data-sw-spin>{wheel.spin}</button>
      <button type="button" class="sw-later" data-sw-x>{wheel.later}</button>
    </div>

    <!-- result sheet: the prize Odoo gave, its code and how long it lasts -->
    <div class="sw-win" data-sw-after hidden>
      <div class="win-ico" data-sw-wico></div>
      <span class="win-k" data-sw-wonk>{wheel.won}</span>
      <h3 data-sw-prize>—</h3>
      <button type="button" class="ticket" data-sw-code>
        <span class="t-l"><small>Your code</small><b data-sw-codetext>—</b></span>
        <span class="t-r" data-sw-copied>Copy</span>
      </button>
      <p class="sw-valid" data-sw-valid hidden></p>
      <!-- Odoo's own line above says how the prize is used; this note is only for a wheel without it -->
      <p data-sw-note>{wheel.note}</p>
      <div class="sw-btns">
        <a href="/services#catalog" class="btn btn-primary" data-sw-book>{wheel.book}</a>
        <a href="#" target="_blank" rel="noopener" class="btn" data-sw-wa data-base={wa(wheel.wa_msg.includes('{code}') ? wheel.wa_msg : `${wheel.wa_msg} {code}`)}>{wheel.wa}</a>
      </div>
    </div>
    <div class="confetti" data-confetti aria-hidden="true"></div>
  </div>
</div>

<template data-sw-icons>{prizes.map((p) => <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />)}</template>

<script>
  import { bindPhone, checkPhone } from '../lib/phone';
  const sw = document.querySelector<HTMLElement>('[data-sw]');
  if (sw) {
    const prizes: { id: number; full: string; code: string }[] = JSON.parse(sw.dataset.prizes!);
    const icons = [...(document.querySelector<HTMLTemplateElement>('[data-sw-icons]')!.content.children)];
    const wheel = sw.querySelector<SVGElement>('[data-sw-wheel]')!;
    const $ = <T extends HTMLElement>(s: string) => sw.querySelector<T>(s)!;
    const api = async (url: string, body?: unknown) => {
      try {
        const r = await fetch(url, body === undefined ? { credentials: 'same-origin', cache: 'no-store' } : {
          method: 'POST', credentials: 'same-origin', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) });
        let j: any = {}; try { j = await r.json(); } catch {}
        return { status: r.status, ...j };
      } catch { return { status: 0, ok: false, error: 'unavailable' }; }
    };
    let spinning = false;
    let who: any = null;          // null = not asked yet, false = signed out, else the customer
    const seg = 360 / prizes.length;
    const angleFor = (i: number) => 360 - (i * seg + seg / 2);
    const say = (m: string, bad = true) => { const el = $('[data-sw-msg]'); el.textContent = m; el.hidden = !m; el.classList.toggle('bad', bad); };
    const ERR: Record<string, string> = {
      off: 'Spin & Win is taking a short break. Back soon!',
      paused: 'All the prizes for now are gone — try again next month!',
      'too many': 'Too many spins from this connection. Try again later.',
      'sign in': 'Sign in with your mobile first.',
      unavailable: "Can't reach our system right now. Try again in a moment.",
    };
    const dayText = (d: string) => (d ? new Date(d + 'T00:00:00').toLocaleDateString([], { day: 'numeric', month: 'short' }) : '');
    type Win = { id: number; item_id: number; prize: string; code: string; valid_until: string; state: string; order: string };

    // the prize Odoo gave: the wheel on its slice, the sheet with the prize, its code and validity
    const show = (w: Win, instant = false) => {
      let i = prizes.findIndex((p) => p.id && p.id === w.item_id);
      if (i < 0) i = 0;
      if (instant) { wheel.style.transition = 'none'; wheel.style.transform = `rotate(${angleFor(i)}deg)`; }
      $('[data-sw-before]').setAttribute('hidden', '');
      const win = $('[data-sw-after]');
      win.removeAttribute('hidden');
      requestAnimationFrame(() => win.classList.add('up'));
      $('[data-sw-wonk]').textContent = instant ? 'Your prize' : $('[data-sw-wonk]').dataset.won || $('[data-sw-wonk]').textContent;
      $('[data-sw-prize]').textContent = w.prize || prizes[i].full;
      $('[data-sw-codetext]').textContent = w.code;
      $('[data-sw-wico]').replaceChildren(icons[i].cloneNode(true));
      const valid = $('[data-sw-valid]');
      valid.hidden = false;
      $('[data-sw-note]').hidden = true;   // the line below says the same thing, with the date
      valid.textContent = w.state === 'given' ? 'Already given to you — enjoy!'
        : w.state === 'used' ? `On your booking ${w.order}.`
        : w.state === 'expired' ? 'This prize has expired.'
        : w.valid_until ? `Goes on your next booking by itself. Valid till ${dayText(w.valid_until)}.` : 'Goes on your next booking by itself.';
      const wa = $<HTMLAnchorElement>('[data-sw-wa]');
      wa.href = wa.dataset.base!.replace('%7Bcode%7D', encodeURIComponent(w.code));   // the message's {code}
      sw.classList.add('won');
      window.dispatchEvent(new CustomEvent('danat-prize', { detail: w }));           // the cart's prize banner
    };
    $('[data-sw-wonk]').dataset.won = $('[data-sw-wonk]').textContent || '';

    // who is spinning: signed in = their number; signed out = the sign-in fields
    const mask = (p: string) => { const d = String(p || '').replace(/\D/g, ''); return d ? `+${d.slice(0, d.length - 4)} •••• ${d.slice(-4)}`.replace(/^\+(\d{1,3})(\d+)/, '+$1 $2') : ''; };
    const paintWho = () => {
      $('[data-sw-signin]').hidden = !!who;
      const as = $('[data-sw-as]');
      as.hidden = !who;
      as.textContent = who ? `Spinning as ${who.name || 'you'}${who.phone ? ' · ' + mask(who.phone) : ''}` : '';
      $<HTMLButtonElement>('.sw-go').disabled = !who;
    };
    const loadCurrent = async () => {
      if (!who) return;
      const r = await api('/api/spin');
      if (r.ok && r.win) show(r.win, true);
      else if (!r.ok && r.error === 'off') say(ERR.off);
    };
    const confetti = () => {
      const box = sw.querySelector<HTMLElement>('[data-confetti]')!;
      box.innerHTML = '';
      for (let k = 0; k < 70; k++) {
        const s = document.createElement('i');
        const ang = Math.random() * Math.PI * 2, dist = 160 + Math.random() * 220;
        s.style.cssText = `--dx:${Math.cos(ang) * dist}px;--dy:${Math.sin(ang) * dist - 120}px;--r:${Math.random() * 720 - 360}deg;--c:${['#f5b400', '#ffffff', 'var(--violet)', '#ff7a45', '#4ade80'][k % 5]};animation-delay:${Math.random() * .15}s`;
        box.appendChild(s);
      }
    };

    const reset = () => {
      if (spinning) return;
      wheel.style.transition = 'none'; wheel.style.transform = 'rotate(0deg)';
      const win = $('[data-sw-after]');
      win.classList.remove('up'); win.setAttribute('hidden', '');
      $('[data-sw-before]').removeAttribute('hidden');
      $('[data-sw-copied]').textContent = 'Copy';
      $('[data-sw-valid]').hidden = true;
      $('[data-sw-note]').hidden = false;
      say('');
      sw.classList.remove('won');
    };
    (window as any).__openSpin = async () => {
      reset(); // a fresh wheel; the prize they already have comes back from Odoo
      sw.hidden = false;
      requestAnimationFrame(() => sw.classList.add('in'));
      document.documentElement.style.overflow = 'hidden';
      if (who === null) { const m = await api('/api/account/me'); who = m.ok ? m : false; }
      paintWho();
      await loadCurrent();
    };
    window.addEventListener('danat-account', (e) => { who = (e as CustomEvent).detail || false; paintWho(); });
    const close = () => {
      sw.classList.remove('in');
      document.documentElement.style.overflow = '';
      setTimeout(() => (sw.hidden = true), 350);
      (window as any).__offerClosed?.();
    };
    sw.querySelectorAll('[data-sw-x]').forEach((b) => b.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !sw.hidden) close(); });

    // ---- sign in: mobile + WhatsApp code (the same steps as My account and the booking) ----
    const cc = $<HTMLSelectElement>('[data-sw-cc]'), phone = $<HTMLInputElement>('[data-sw-phone]');
    const name = $<HTMLInputElement>('[data-sw-name]'), code = $<HTMLInputElement>('[data-sw-code]'), pass = $<HTMLInputElement>('[data-sw-pass]');
    let purpose: 'signin' | 'signup' = 'signin';
    bindPhone(phone, () => cc.value, (m) => say(m));
    $('[data-sw-send]').addEventListener('click', async () => {
      const ph = checkPhone(cc.value, phone.value);
      if (!ph.ok) { say(phone.value.trim() ? ph.msg : 'Please enter your mobile number.'); phone.focus(); return; }
      if (purpose === 'signup' && name.value.trim().length < 2) { say('Please enter your name.'); name.focus(); return; }
      const btn = $<HTMLButtonElement>('[data-sw-send]');
      btn.disabled = true;
      const r = await api('/api/account/phone-start', { phone: phone.value, country: cc.value.toUpperCase(), purpose, name: name.value.trim() });
      btn.disabled = false;
      if (r.signup) {          // no account with this number yet: sign up with a name
        purpose = 'signup';
        name.hidden = false;
        say("New here? Add your name, then we'll send the code.", false);
        name.focus(); return;
      }
      if (r.signin) purpose = 'signin';
      if (!r.ok) { say(r.error || "We couldn't send the code. Try again in a moment."); return; }
      code.hidden = false;
      $('[data-sw-verify]').hidden = false;
      btn.textContent = 'Send again';
      say('Code sent on WhatsApp — it expires in 10 minutes.', false);
      code.focus();
    });
    const verify = async () => {
      const c = code.value.replace(/\D/g, '');
      if (c.length !== 6) { say('Enter the 6-digit code from WhatsApp.'); code.focus(); return; }
      const r = await api('/api/account/phone-verify', { phone: phone.value, country: cc.value.toUpperCase(), code: c,
        purpose, name: name.value.trim(), email: '', ...(pass.hidden ? {} : { password: pass.value }) });
      if (r.needPassword) {   // the code was right; this account must confirm its password once
        pass.hidden = false; say(r.error || 'Enter your password once to confirm this is your account.'); pass.focus(); return;
      }
      if (!r.ok) { say(r.error || 'That code did not work.'); return; }
      pass.hidden = true; pass.value = ''; code.value = '';
      say('');
      const m = await api('/api/account/me');
      who = m.ok ? m : r;
      window.dispatchEvent(new CustomEvent('danat-account', { detail: who }));   // the header's account button
      paintWho();
      await loadCurrent();
    };
    $('[data-sw-verify]').addEventListener('click', verify);
    code.addEventListener('keydown', (e) => { if (e.key === 'Enter') verify(); });

    // ---- the spin: Odoo picks, the wheel turns to that slice ----
    sw.querySelectorAll('[data-sw-spin]').forEach((btn) => btn.addEventListener('click', async () => {
      if (spinning || sw.classList.contains('won')) return;
      if (!who) { say(ERR['sign in']); phone.focus(); return; }
      spinning = true;
      say('');
      sw.classList.add('spinning');
      const r = await api('/api/spin', {});
      if (!r.ok) {
        spinning = false; sw.classList.remove('spinning');
        if (r.status === 401) { who = false; paintWho(); }
        say(ERR[r.error] || ERR.unavailable);
        return;
      }
      if (r.again) {           // spun already in the window: the same prize, no new spin
        spinning = false; sw.classList.remove('spinning');
        show(r.win, true);
        return;
      }
      let i = prizes.findIndex((p) => p.id && p.id === r.win.item_id);
      if (i < 0) i = 0;
      const target = 360 * 7 + angleFor(i) + (Math.random() * seg * .5 - seg * .25);
      wheel.style.transition = 'transform 5s cubic-bezier(.1,.75,.08,1)';
      wheel.style.transform = `rotate(${target}deg)`;
      setTimeout(() => {
        spinning = false;
        sw.classList.remove('spinning');
        show(r.win);
        confetti();
      }, 5100);
    }));
    sw.querySelector('[data-sw-code]')!.addEventListener('click', async () => {
      const code = sw.querySelector('[data-sw-codetext]')!.textContent!;
      try { await navigator.clipboard.writeText(code); sw.querySelector('[data-sw-copied]')!.textContent = 'Copied ✓'; }
      catch { sw.querySelector('[data-sw-copied]')!.textContent = code; }
    });
  }
</script>

<style>
  .sw { position: fixed; inset: 0; z-index: 90; display: grid; place-items: center; padding: 16px; }
  .sw[hidden] { display: none; }
  .sw-bg { position: absolute; inset: 0; background: rgba(6, 10, 9, .7); backdrop-filter: blur(6px); opacity: 0; transition: opacity .35s; }
  .sw.in .sw-bg { opacity: 1; }
  .sw-card {
    /* everything stays inside the panel: it fits the screen, and on a very short one it scrolls inside */
    position: relative; width: min(460px, 100%); max-height: calc(100vh - 32px); max-height: calc(100dvh - 32px);
    overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: none;
    display: grid; justify-items: center; align-content: start; gap: 6px; padding: 30px 28px 26px; text-align: center; color: #fff;
    border-radius: 32px;
    background:
      radial-gradient(420px circle at 50% 0%, color-mix(in srgb, var(--violet) 55%, transparent), transparent 70%),
      radial-gradient(300px circle at 100% 100%, rgba(245, 180, 0, .18), transparent 70%),
      #0c1712;
    box-shadow: 0 0 0 1px rgba(255,255,255,.08), 0 50px 120px -30px rgba(0,0,0,.8);
    transform: translateY(40px) scale(.9); opacity: 0; transition: transform .6s cubic-bezier(.2,1.25,.3,1), opacity .35s;
  }
  .sw.in .sw-card { transform: none; opacity: 1; }
  .sw-x { position: absolute; right: 16px; top: 16px; z-index: 5; width: 34px; height: 34px; border: 0; border-radius: 50%; background: rgba(255,255,255,.1); color: #fff; font-size: 20px; line-height: 1; }

  .sw-head { display: grid; gap: 4px; }
  .sw-kicker { font-size: 11px; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: #f5b400; }
  .sw-head h2 { font-size: 40px; line-height: 1; color: #fff; letter-spacing: -.02em; }
  .sw-head h2 em { font-style: normal; background: linear-gradient(120deg, #ffd96a, #f5b400); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .sw-head p { font-size: 14px; color: rgba(255,255,255,.65); }

  /* stage */
  .sw-stage { position: relative; width: min(330px, 78vw, 44vh); aspect-ratio: 1; margin: 14px 0 8px; transition: width .6s cubic-bezier(.2,.8,.2,1), margin .6s; }
  .sw-card::-webkit-scrollbar { display: none; }
  /* after the spin the result is what matters: a smaller title and wheel make room for it */
  .won .sw-stage { width: min(150px, 40vw, 18vh); margin: 14px 0 0; }
  .won .sw-head p { display: none; }
  .won.sw-card, .won .sw-card { padding-top: 22px; padding-bottom: 20px; }
  .won .sw-head h2 { font-size: 30px; }
  .sw-halo { position: absolute; inset: -12%; border-radius: 50%; background: radial-gradient(closest-side, color-mix(in srgb, var(--violet) 60%, transparent), transparent); filter: blur(16px); animation: halo 3s ease-in-out infinite; }
  @keyframes halo { 50% { opacity: .55; transform: scale(.94); } }
  .sw-ring { position: absolute; inset: -9px; border-radius: 50%; background: conic-gradient(from 0deg, #f5b400, #fff3c4, var(--violet), #f5b400, #fff3c4, var(--violet), #f5b400); animation: ring 6s linear infinite; }
  .sw-ring::after { content: ''; position: absolute; inset: 5px; border-radius: 50%; background: #0c1712; }
  @keyframes ring { to { transform: rotate(360deg); } }
  .spinning .sw-ring { animation-duration: .9s; }
  .sw-wheel { position: relative; display: block; width: 100%; height: 100%; }

  .s path { stroke: none; }   /* each slice's fill and text colour are inline, from Odoo */
  .s { color: #fff; }
  .ico :global(g) { transform: scale(1); }
  .t1 { font: 700 9.5px var(--body); text-anchor: middle; letter-spacing: .14em; text-transform: uppercase; fill: currentColor; opacity: .75; }
  .t2 { font: 800 15px var(--display); text-anchor: middle; fill: currentColor; letter-spacing: -.01em; }
  .div { stroke: rgba(12,23,18,.35); stroke-width: 1.5; }
  .bulb { fill: #fff6d6; animation: bulb 1.2s infinite; animation-delay: calc(var(--i) * .07s); }
  .spinning .bulb { animation-duration: .3s; }
  @keyframes bulb { 50% { fill: #f5b400; opacity: .5; } }

  .sw-pointer { position: absolute; left: 50%; top: -18px; z-index: 3; transform: translateX(-50%); width: 34px; height: 44px; }
