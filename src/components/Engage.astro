---
// Re-engagement (manager brief):
//  • Idle 35 s (no mouse, scroll, key or touch) → "Book Your Slot" image slider
//    with a quick phone/email field that sends to WhatsApp.
//  • Exit intent (pointer leaves through the top) or cursor still for 15 s →
//    slide-in panel from the LEFT asking what service they need.
// Each shows at most once per browser session, and never on top of another popup.
import { site, price } from '../data/site';
import { categories, iconPaths } from '../data/devices';
import DeviceArt from './DeviceArt.astro';
import { artFor } from '../data/menu';
const label: Record<string, string> = { mobile: 'Mobile repair', laptop: 'Laptop repair', printer: 'Printer repair', cctv: 'CCTV installation', network: 'Wi-Fi & networking', data: 'Data recovery' };

const tel = site.phone.tel.replace('+', '');
const slides = ['mobile', 'laptop', 'printer', 'cctv', 'data'].map((id) => categories.find((c) => c.id === id)!);
const title: Record<string, [string, string]> = { mobile: ['Mobile', 'Repair'], laptop: ['Laptop', 'Repair'], printer: ['Printer', 'Repair'], cctv: ['CCTV', 'Installation'], data: ['Data', 'Recovery'] };
const pitch: Record<string, string> = {
  mobile: 'Screen, battery, charging, camera and more – quick and reliable service.',
  laptop: 'Screens, keyboards, batteries, hinges and board-level repair.',
  printer: 'Paper jams, print quality, toner and setup – fixed on-site.',
  cctv: 'Site survey, camera install, DVR/NVR setup and phone viewing.',
  data: 'Deleted files, dead drives and formatted disks recovered.',
};
const perks: Record<string, string[]> = {
  mobile: ['Genuine parts', 'Expert technicians', 'Affordable pricing', 'Quick turnaround'],
  laptop: ['Genuine parts', 'Board-level repair', 'Affordable pricing', 'Pickup & drop'],
  printer: ['On-site service', 'All major brands', 'Affordable pricing', 'Setup included'],
  cctv: ['Site survey first', 'Clean cabling', 'Remote viewing', 'Maintenance plans'],
  data: ['Honest assessment', 'Secure handling', 'All drive types', 'Updates on WhatsApp'],
};
// Phone country codes + number lengths (shared). The visitor's own country (from /api/currency) is pre-selected.
import { DIAL as dial } from '../lib/phone';
---

<!-- Book your slot popup (on open, and after 35 s idle) -->
<div class="ig" data-idle hidden data-tel={tel}>
  <div class="ig-bg" data-idle-x></div>
  <div class="ig-card" role="dialog" aria-modal="true" aria-labelledby="ig-title">
    <button type="button" class="ig-x" data-idle-x aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>

    <!-- LEFT: product showcase -->
    <div class="ig-show">
      <span class="ig-swoosh" aria-hidden="true"></span>
      {slides.map((c, i) => (
        <div class:list={['ig-slide', { on: i === 0 }]} data-slide={i}>
          <div class="ig-copy">
            <span class="ig-eyebrow">Book your slot <i></i></span>
            <h3>{title[c.id][0]} <em>{title[c.id][1]}</em></h3>
            <p>{pitch[c.id]}</p>
            <ul class="ig-checks">
              {perks[c.id].map((k) => <li><span><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="M7 12.5l3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>{k}</li>)}
            </ul>
            <div class="ig-from"><small>Starting from</small><b>{price()}</b></div>
          </div>
          <div class="ig-product">
            <span class="ig-hand" aria-hidden="true">We fix it<br />like new!<svg viewBox="0 0 40 60" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M28 4c10 14 8 34-14 48"/><path d="M12 40l1 13 12-5"/></svg></span>
            <span class="ig-glow" aria-hidden="true"></span>
            <span class="ig-dev"><DeviceArt kind={artFor[c.id]} /></span>
            <span class="ig-pedestal" aria-hidden="true"></span>
          </div>
        </div>
      ))}
      <button type="button" class="ig-arrow prev" data-prev aria-label="Previous"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg></button>
      <button type="button" class="ig-arrow next" data-next aria-label="Next"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg></button>
      <div class="ig-thumbs" role="tablist" aria-label="Choose a service">
        {slides.map((c, i) => (
          <button type="button" role="tab" class:list={['ig-thumb', { on: i === 0 }]} data-thumb={i}>
            <span class="ig-thumb-art"><DeviceArt kind={artFor[c.id]} /></span>
            <span>{title[c.id].join(' ')}</span>
          </button>
        ))}
      </div>
      <div class="ig-dots">{slides.map((_, i) => <button type="button" data-dot={i} class:list={[{ on: i === 0 }]} aria-label={`Slide ${i + 1}`}></button>)}</div>
      <i data-prog hidden></i>
    </div>

    <!-- RIGHT: booking form -->
    <div class="ig-form">
      <span class="ig-wa-pill"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg> Book instantly on WhatsApp</span>
      <h2 id="ig-title">Book your slot</h2>
      <p class="ig-sub">Share your number or email and we'll start the booking on WhatsApp.</p>
      <div class="ig-mode" role="tablist" aria-label="Contact method">
        <button type="button" role="tab" data-mode="phone" aria-selected="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>Mobile Number</button>
        <button type="button" role="tab" data-mode="email" aria-selected="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>Email Address</button>
      </div>
      <form class="ig-quick" data-quick novalidate>
        <div class="ig-row" data-row-phone>
          <label class="ig-cc" title="Country code">
            <img class="flag" src="/flags/om.svg" alt="" width="26" height="17" data-cc-flag />
            <span data-cc-code>+968</span>
            <svg class="cc-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
            <select name="cc" aria-label="Country code" data-cc>
              {dial.map((d) => <option value={d.cc} data-code={d.code} data-len={d.len} data-eg={d.eg} selected={d.cc === 'om'}>{d.name} ({d.code})</option>)}
            </select>
          </label>
          <input name="phone" inputmode="tel" placeholder="9123 4567" maxlength="16" autocomplete="tel-national" aria-label="Mobile number" data-ph />
        </div>
        <div class="ig-row" data-row-email hidden>
          <input name="email" type="email" placeholder="name@email.com" autocomplete="email" aria-label="Email address" />
        </div>
        <p class="ig-err" data-field-err role="alert" hidden><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M12 7.5v5.5M12 16.5v.01"/></svg><span data-err-text></span><button type="button" class="ig-fix" data-err-fix hidden>Use it</button></p>
        <button type="submit" class="ig-send"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg> <span>Send on WhatsApp</span><svg class="arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        <p class="ig-msg" data-quick-msg aria-live="polite"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg><span data-quick-note>No spam. We only use your number to confirm the booking.</span></p>
      </form>
      <div class="ig-or"><span>OR</span></div>
      <a class="ig-all" href="/services#all" data-idle-x><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>View all services<svg class="arr" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <ul class="ig-feat">
        <li><span class="f1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><b>Quick Service</b><small>In most areas</small></li>
        <li><span class="f2"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l8 3v6c0 5-3.4 9.3-8 11-4.6-1.7-8-6-8-11V5z"/><path d="M8.5 12l2.5 2.5 4.5-5" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span><b>Genuine Parts</b><small>Trusted quality</small></li>
        <li><span class="f3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg></span><b>Best Price</b><small>Transparent pricing</small></li>
      </ul>
    </div>
  </div>
</div>
<!-- Left slide-in -->
<aside class="sl" data-slide-in hidden aria-label="Need help?">
  <div class="sl-head">
    <button type="button" class="sl-x" data-sl-x aria-label="Close"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    <span class="sl-av"><img data-for="danatfix" src="/brand/danat-fix@240.png" alt="" width="44" height="44" /><img data-for="369" src="/brand/369-ai-fix@240.png" alt="" width="44" height="44" /><i></i></span>
    <div>
      <b>Leaving already? 👋</b>
      <small><i class="dot"></i>We reply on WhatsApp</small>
    </div>
  </div>
  <div class="sl-body">
    <p>What do you need fixed today? Tap one — we'll reply on WhatsApp.</p>
    <div class="sl-grid">
      {categories.filter((c) => !['tablet', 'desktop', 'itsupport'].includes(c.id)).map((c, i) => (
        <a class="sl-tile" style={`--h:${c.hue}; --i:${i}`} target="_blank" rel="noopener" href={`https://wa.me/${tel}?text=${encodeURIComponent(`Hi Danat Fix, I need help with my ${c.name}.`)}`}>
          <span class="sl-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[c.icon]} /></span>
          <span>{c.name.replace(' & MacBooks', '').replace(' Installation', '').replace(' & Wi-Fi', '')}</span>
        </a>
      ))}
    </div>
    <a class="sl-cta" target="_blank" rel="noopener" href={`https://wa.me/${tel}?text=${encodeURIComponent('Hi Danat Fix, I need help with a repair.')}`}><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg> Chat with us on WhatsApp</a>
    <a class="sl-all" href="/#book-services">See all services →</a>
  </div>
</aside>
<script>
  import { checkPhone, bindPhone, limitPhone } from '../lib/phone';
    import { checkEmail } from '../lib/email';
  const idle = document.querySelector<HTMLElement>('[data-idle]');
  const sl = document.querySelector<HTMLElement>('[data-slide-in]');
  if (idle && sl) {
    const tel = idle.dataset.tel!;
    const ss = (k: string) => { try { return sessionStorage.getItem(k); } catch { return null; } };
    const sset = (k: string) => { try { sessionStorage.setItem(k, '1'); } catch {} };
    const q = new URLSearchParams(location.search);
    const IDLE_MS = Number(q.get('idle')) * 1000 || 35000;
    const STILL_MS = Number(q.get('still')) * 1000 || 15000;
    const busy = () => document.documentElement.style.overflow === 'hidden' || ![...document.querySelectorAll<HTMLElement>('[data-po],[data-sw],[data-idle]')].every((m) => m.hidden);

    // ---- idle slider ----
    let slideT = 0, cur = 0;
    const slides = [...idle.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...idle.querySelectorAll<HTMLElement>('[data-dot]')];
    const thumbs = [...idle.querySelectorAll<HTMLElement>('[data-thumb]')];
    const title_of = (i: number) => slides[i].querySelector('h3')!.textContent!.replace(/\s+/g, ' ').trim();
    const go = (i: number) => {
      cur = (i + slides.length) % slides.length;
      slides.forEach((s, k) => s.classList.toggle('on', k === cur));
      dots.forEach((d, k) => d.classList.toggle('on', k === cur));
      thumbs.forEach((d, k) => d.classList.toggle('on', k === cur));
      clearTimeout(slideT);
      slideT = window.setTimeout(() => go(cur + 1), 3500);
    };
    dots.forEach((d, k) => d.addEventListener('click', () => go(k)));
    thumbs.forEach((d, k) => d.addEventListener('click', () => go(k)));
    // Keep sliding; pause only while the visitor is typing in the form.
    const form = idle.querySelector('.ig-form')!;
    form.addEventListener('focusin', () => clearTimeout(slideT));
    form.addEventListener('focusout', () => { if (!idle.hidden) go(cur); });

    // contact mode tabs
    let mode = 'phone';
    idle.querySelectorAll<HTMLElement>('[data-mode]').forEach((b) => b.addEventListener('click', () => {
      mode = b.dataset.mode!;
      idle.querySelectorAll('[data-mode]').forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      idle.querySelector<HTMLElement>('[data-row-phone]')!.hidden = mode !== 'phone';
      idle.querySelector<HTMLElement>('[data-row-email]')!.hidden = mode !== 'email';
      (window as any).__clearQuickErr?.();
      const note = idle.querySelector('[data-quick-note]'); if (note) note.textContent = `No spam. We only use your ${mode === 'email' ? 'email' : 'number'} to confirm the booking.`;
      idle.querySelector<HTMLInputElement>(mode === 'phone' ? '[name=phone]' : '[name=email]')!.focus();
    }));
    idle.querySelector('[data-prev]')!.addEventListener('click', () => go(cur - 1));
    idle.querySelector('[data-next]')!.addEventListener('click', () => go(cur + 1));
    const openIdle = (force = false) => {
      if (!force && (ss('idle-shown') || busy())) return;
      sset('idle-shown');
      hideSl();
      idle.hidden = false;
      requestAnimationFrame(() => idle.classList.add('in'));
      document.documentElement.style.overflow = 'hidden';
      go(0);
    };
    const closeIdle = () => {
      idle.classList.remove('in');
      document.documentElement.style.overflow = '';
      clearTimeout(slideT);
      setTimeout(() => (idle.hidden = true), 350);
    };
    idle.querySelectorAll('[data-idle-x]').forEach((b) => b.addEventListener('click', closeIdle));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !idle.hidden) closeIdle(); });

    const qMsg = idle.querySelector<HTMLElement>('[data-quick-msg]')!;
    // Country code picker: shows flag + code, follows the visitor's country until they choose one
    const ccSel = idle.querySelector<HTMLSelectElement>('[data-cc]')!;
    const ccShow = () => { const o = ccSel.selectedOptions[0]; idle.querySelector<HTMLImageElement>('[data-cc-flag]')!.src = `/flags/${o.value}.svg`; idle.querySelector('[data-cc-code]')!.textContent = o.dataset.code!; const ph = idle.querySelector<HTMLInputElement>('[data-ph]')!; ph.placeholder = o.dataset.eg!; ph.value = limitPhone(ph.value, ccSel.value); };
    ccShow();
    // Error box right under the field: slides in + shakes on each new message, red border on the input
    const phIn = idle.querySelector<HTMLInputElement>('[data-ph]')!;
    const emIn = idle.querySelector<HTMLInputElement>('[name=email]')!;
    const errEl = idle.querySelector<HTMLElement>('[data-field-err]')!;
    const errFix = idle.querySelector<HTMLButtonElement>('[data-err-fix]')!;
    let suggestion = '';
    const fieldErr = (input: HTMLInputElement, m: string, suggest = '') => {
      const same = !errEl.hidden && errEl.querySelector('[data-err-text]')!.textContent === m;
      errEl.querySelector('[data-err-text]')!.textContent = m;
      errEl.hidden = !m; input.classList.toggle('bad', !!m); input.setAttribute('aria-invalid', String(!!m));
      suggestion = suggest; errFix.hidden = !suggest;
      if (m && !same) { errEl.classList.remove('shake'); void errEl.offsetWidth; errEl.classList.add('shake'); }
    };
    (window as any).__clearQuickErr = () => { fieldErr(phIn, ''); fieldErr(emIn, ''); };
    errFix.addEventListener('click', () => { if (!suggestion) return; emIn.value = suggestion; fieldErr(emIn, ''); emIn.focus(); });
    bindPhone(phIn, () => ccSel.value, (m) => fieldErr(phIn, m));
    // email: check when leaving the box; once an error shows, re-check live so it clears as soon as it's fixed
    emIn.addEventListener('blur', () => { if (!emIn.value.trim()) return; const r = checkEmail(emIn.value); fieldErr(emIn, r.msg, r.suggest); });
    // while typing: re-check at once if an error is showing; otherwise check after a short pause
    let emTimer = 0;
    emIn.addEventListener('input', () => {
      clearTimeout(emTimer);
      const run = () => { if (!emIn.value.trim()) { fieldErr(emIn, ''); return; } const r = checkEmail(emIn.value); fieldErr(emIn, r.ok ? '' : r.msg, r.suggest); };
      if (!errEl.hidden) run(); else emTimer = window.setTimeout(run, 700);
    });
    let ccTouched = false;
    ccSel.addEventListener('change', () => { ccTouched = true; ccShow(); });
    const ccAuto = (cc: unknown) => { if (ccTouched || typeof cc !== 'string') return; const v = cc.toLowerCase(); if ([...ccSel.options].some((o) => o.value === v)) { ccSel.value = v; ccShow(); } };
    ccAuto((window as any).__visitorCountry);
    window.addEventListener('visitor-country', (e) => ccAuto((e as CustomEvent).detail));

    idle.querySelector<HTMLFormElement>('[data-quick]')!.addEventListener('submit', (e) => {
      e.preventDefault();
      const fd = new FormData(e.target as HTMLFormElement);
      const raw = String(fd.get(mode) ?? '').trim();
      const msg = idle.querySelector('[data-quick-msg]')!;
      const slide = title_of(cur);
      let v = raw;
      if (mode === 'phone') {
        const r = checkPhone(ccSel.value, raw);
        if (!raw) { fieldErr(phIn, 'Please enter your mobile number.'); phIn.focus(); return; }
        if (!r.ok) { fieldErr(phIn, r.msg); phIn.focus(); return; }
        v = r.full;
      } else {
        const r = checkEmail(raw);
        if (!r.ok) { fieldErr(emIn, r.msg, r.suggest); emIn.focus(); return; }
        v = r.email;
      }
      fieldErr(mode === 'phone' ? phIn : emIn, '');
      window.open(`https://wa.me/${tel}?text=${encodeURIComponent(`Hi Danat Fix, I want to book ${slide}. My contact: ${v}`)}`, '_blank', 'noopener');
      msg.textContent = 'Thanks — opening WhatsApp to send it to our team.';
      msg.className = 'ig-msg ok';
    });

    // Opens on arrival too (Popups.astro calls this as the default welcome popup)
    (window as any).__openSlot = () => openIdle(true);

    // ---- left slide-in ----
    const showSl = () => {
      if (ss('sl-shown') || busy()) return;
      sset('sl-shown');
      sl.hidden = false;
      requestAnimationFrame(() => sl.classList.add('in'));
    };
    const hideSl = () => { sl.classList.remove('in'); setTimeout(() => (sl.hidden = true), 400); };
    sl.querySelector('[data-sl-x]')!.addEventListener('click', hideSl);
    document.addEventListener('mouseout', (e) => { if (!e.relatedTarget && e.clientY <= 0) showSl(); });

    // ---- timers ----
    let idleT = 0, stillT = 0;
    const armIdle = () => { clearTimeout(idleT); idleT = window.setTimeout(openIdle, IDLE_MS); };
    const armStill = () => { clearTimeout(stillT); stillT = window.setTimeout(showSl, STILL_MS); };
    ['scroll', 'keydown', 'touchstart', 'wheel'].forEach((ev) => addEventListener(ev, armIdle, { passive: true }));
    addEventListener('mousemove', () => { armIdle(); armStill(); }, { passive: true });
    armIdle();
