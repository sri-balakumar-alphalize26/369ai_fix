---
// Service picker with a cart, modelled on urbancompany.com: categories on the
// left, service cards with Add / quantity stepper in the middle, sticky cart
// with the promise box on the right. No ratings or booking counts — we have
// none that are real. "Proceed" hands the cart to the booking form below.
import { price, site } from '../data/site';
import { categories, iconPaths } from '../data/devices';
const tel = site.phone.tel.replace('+', '');
---

<div class="sc" data-sc data-tel={tel}>
  <aside class="sc-cats" aria-label="Device types">
    <h3>Select a device</h3>
    <div class="sc-cat-grid">
      {categories.map((c, i) => (
        <button type="button" class="sc-cat" data-sc-cat={c.id} aria-pressed={i === 0 ? 'true' : 'false'} style={`--h:${c.hue}`}>
          <span class="sc-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[c.icon]} /></span>
          <span>{c.name}</span>
        </button>
      ))}
    </div>
  </aside>

  <div class="sc-list">
    {categories.map((c, i) => (
      <section class="sc-group" data-sc-group={c.id} hidden={i !== 0}>
        <h3>{c.name}</h3>
        <p class="sc-sub">{c.short}{c.onsiteOnly ? ' · installed on-site' : ' · doorstep or pickup'}. Diagnosed first, estimate before any work.</p>
        <ul>
          {c.issues.map((iss) => (
            <li class="sc-item" data-sc-item data-sc-catid={c.id} data-cat-name={c.name} data-name={iss}>
              <div class="sc-info">
                <h4>{iss}</h4>
                <p class="sc-price">Starts at <b>{price()}</b></p>
              </div>
              <div class="sc-act">
                <button type="button" class="sc-add" data-sc-add>Add</button>
                <div class="sc-step" data-sc-step hidden>
                  <button type="button" data-sc-dec aria-label={`Remove one ${iss}`}>−</button>
                  <span data-sc-qty>1</span>
                  <button type="button" data-sc-inc aria-label={`Add one more ${iss}`}>+</button>
                </div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <aside class="sc-side">
    <div class="sc-cart">
      <h3>Cart</h3>
      <div class="sc-empty" data-sc-empty>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 4h2l2.4 11h10.2L20 7H6.2"/><circle cx="9" cy="19.5" r="1.4"/><circle cx="17" cy="19.5" r="1.4"/></svg>
        <p>No items in your cart</p>
      </div>
      <ul class="sc-lines" data-sc-lines></ul>
      <div class="sc-total" data-sc-total hidden>
        <span>Total</span><b>{price()}</b>
      </div>
      <button type="button" class="btn btn-primary sc-go" data-sc-go hidden><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" width="20" height="20"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg>Book on WhatsApp</button>
    </div>
    <div class="sc-promise">
      <h3>Danat Promise</h3>
      <ul>
        <li>Trained, verified technicians</li>
        <li>Hassle-free booking</li>
        <li>Clear estimate before work</li>
      </ul>
      <span class="sc-badge" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M9 12l2 2 4-4"/></svg>
      </span>
    </div>
  </aside>
</div>

<script>
  import { price } from '../data/site';

  const root = document.querySelector<HTMLElement>('[data-sc]');
  if (root) {
    type Line = { cat: string; catName: string; name: string; qty: number };
    const cart = new Map<string, Line>();
    const key = (cat: string, name: string) => `${cat}::${name}`;
    const linesEl = root.querySelector<HTMLElement>('[data-sc-lines]')!;
    const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[ch]!);

    const render = () => {
      root.querySelectorAll<HTMLElement>('[data-sc-item]').forEach((it) => {
        const line = cart.get(key(it.dataset.scCatid!, it.dataset.name!));
        it.querySelector<HTMLElement>('[data-sc-add]')!.hidden = !!line;
        it.querySelector<HTMLElement>('[data-sc-step]')!.hidden = !line;
        if (line) it.querySelector('[data-sc-qty]')!.textContent = String(line.qty);
      });
      const lines = [...cart.values()];
      linesEl.innerHTML = lines.map((l) =>
        `<li><span><b>${esc(l.name)}</b><small>${esc(l.catName)}${l.qty > 1 ? ` · ×${l.qty}` : ''}</small></span><span class="price-tag">${price()}</span></li>`).join('');
      const empty = lines.length === 0;
      root.querySelector<HTMLElement>('[data-sc-empty]')!.hidden = !empty;
      root.querySelector<HTMLElement>('[data-sc-total]')!.hidden = empty;
      root.querySelector<HTMLElement>('[data-sc-go]')!.hidden = empty;
    };

    root.querySelectorAll<HTMLElement>('[data-sc-item]').forEach((it) => {
      const k = key(it.dataset.scCatid!, it.dataset.name!);
      const add = () => {
        const l = cart.get(k);
        if (l) l.qty++;
        else cart.set(k, { cat: it.dataset.scCatid!, catName: it.dataset.catName!, name: it.dataset.name!, qty: 1 });
        render();
      };
      it.querySelector('[data-sc-add]')!.addEventListener('click', add);
      it.querySelector('[data-sc-inc]')!.addEventListener('click', add);
      it.querySelector('[data-sc-dec]')!.addEventListener('click', () => {
        const l = cart.get(k)!;
        if (--l.qty <= 0) cart.delete(k);
        render();
      });
    });

    root.querySelectorAll<HTMLButtonElement>('[data-sc-cat]').forEach((b) => b.addEventListener('click', () => {
      root.querySelectorAll('[data-sc-cat]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      root.querySelectorAll<HTMLElement>('[data-sc-group]').forEach((g) => (g.hidden = g.dataset.scGroup !== b.dataset.scCat));
    }));

    // Send the whole cart to Danat on WhatsApp, pre-filled.
    root.querySelector('[data-sc-go]')!.addEventListener('click', () => {
      const lines = [...cart.values()];
      const list = lines.map((l) => `• ${l.name} (${l.catName})${l.qty > 1 ? ` ×${l.qty}` : ''}`).join('\n');
      const msg = `Hi Danat, I want to book these repairs:\n${list}`;
      window.open(`https://wa.me/${root.dataset.tel}?text=${encodeURIComponent(msg)}`, '_blank', 'noopener');
    });

    render();
  }
</script>

<style>
  .sc { display: grid; grid-template-columns: 250px minmax(0, 1fr) 320px; gap: 22px; align-items: start; }
  .sc h3 { font-size: 18px; margin-bottom: 14px; }

  .sc-cats, .sc-cart, .sc-promise, .sc-list { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
  .sc-cats { padding: 18px; position: sticky; top: 100px; }
  .sc-cat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .sc-cat {
    display: grid; justify-items: center; gap: 6px; padding: 12px 6px; border-radius: 14px;
    border: 1px solid transparent; background: var(--tint); font-size: 12px; font-weight: 600; line-height: 1.25;
    color: var(--ink-2); text-align: center; transition: border-color .2s, background .2s;
  }
  .sc-cat:hover { border-color: var(--line); }
  .sc-cat[aria-pressed='true'] { border-color: var(--violet); background: var(--accent-soft); color: var(--ink); }
  .sc-ico { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: hsl(var(--h) 70% var(--chip-l)); color: hsl(var(--h) 65% var(--chip-ink-l)); }
  .sc-ico svg { width: 22px; height: 22px; }

  .sc-list { padding: 22px 24px; }
  .sc-group h3 { font-size: 24px; margin-bottom: 4px; }
  .sc-sub { color: var(--ink-3); font-size: 14px; margin-bottom: 8px; }
  .sc-group ul { list-style: none; margin: 0; padding: 0; }
  .sc-item { display: flex; gap: 16px; justify-content: space-between; align-items: center; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .sc-item:last-child { border-bottom: 0; }
  .sc-info h4 { font-size: 15px; font-weight: 700; }
  .sc-price { margin-top: 2px; font-size: 13px; color: var(--ink-2); }
  .sc-price b { color: var(--ink); }
  .sc-act { flex: none; }
  .sc-add, .sc-step {
    height: 34px; min-width: 84px; border-radius: 10px;
    background: var(--surface); border: 1px solid var(--line); box-shadow: var(--shadow); color: var(--violet); font-weight: 700; font-size: 14px;
  }
  .sc-add:hover { border-color: var(--violet); }
  .sc-step { display: flex; align-items: center; justify-content: space-between; overflow: hidden; background: var(--accent-soft); border-color: var(--violet); }
  .sc-step[hidden] { display: none; }
  .sc-step button { width: 28px; height: 100%; border: 0; background: none; color: var(--violet); font-size: 18px; font-weight: 700; }

  .sc-side { display: grid; gap: 16px; position: sticky; top: 100px; }
  .sc-cart { padding: 20px; }
  .sc-empty { display: grid; justify-items: center; gap: 8px; padding: 18px 0; color: var(--ink-3); font-size: 14px; }
  .sc-empty svg { width: 48px; height: 48px; }
  .sc-lines { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .sc-lines :global(li) { display: flex; justify-content: space-between; gap: 10px; font-size: 14px; }
  .sc-lines :global(li span:first-child) { display: grid; }
  .sc-lines :global(small) { color: var(--ink-3); font-size: 12px; }
  .sc-total { display: flex; justify-content: space-between; margin-top: 14px; padding-top: 12px; border-top: 1px dashed var(--line); font-weight: 700; }
  .sc-total b { color: var(--lime); font-size: 20px; }
  .sc-go { width: 100%; margin-top: 14px; gap: 10px; background: #25d366 !important; color: #fff !important; box-shadow: 0 12px 24px -12px rgba(37,211,102,.9); }
  .sc-promise { position: relative; padding: 20px; overflow: hidden; }
  .sc-promise ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; font-size: 14px; color: var(--ink-2); }
  .sc-promise li::before { content: '✓'; color: var(--lime); font-weight: 700; margin-right: 8px; }
  .sc-badge { position: absolute; right: 16px; top: 16px; width: 54px; height: 54px; border-radius: 50%; display: grid; place-items: center; background: var(--accent-soft); color: var(--violet); }
  .sc-badge svg { width: 28px; height: 28px; }

  @media (max-width: 1100px) {
    .sc { grid-template-columns: 220px minmax(0, 1fr); }
    .sc-side { grid-column: 1 / -1; position: static; grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    .sc { grid-template-columns: 1fr; }
    .sc-cats { position: static; }
    .sc-cat-grid { grid-template-columns: repeat(4, 1fr); }
    .sc-side { grid-template-columns: 1fr; }
    .sc-list { padding: 18px; }
  }
</style>
