---
// Site-wide cart (like e-commerce sites): header bag icon with count, slide-in
// drawer from the right. Items persist in localStorage across pages.
// Anything on the site can add with:  window.danatCart.add({ device, model, issues[] })
import { site, price } from '../data/site';
import { categories } from '../data/devices';
import { artFor } from '../data/menu';
import { photo } from '../data/photos';
import DeviceArt from './DeviceArt.astro';
const tel = site.phone.tel.replace('+', '');
const cats = categories.map((c) => ({ id: c.id, name: c.name, brands: c.brands.map((b) => b.name) }));
---

<div class="cd" data-cd data-tel={tel} data-price={price()} data-cats={JSON.stringify(cats)} data-photos={JSON.stringify(photo)} hidden>
  <div class="cd-bg" data-cd-close></div>
  <aside class="cd-panel" role="dialog" aria-modal="true" aria-labelledby="cd-title">
    <header class="cd-head">
      <div>
        <h2 id="cd-title">Your cart <span data-cd-count>(0)</span></h2>
        <p>Review your selected services and proceed.</p>
      </div>
      <button type="button" class="cd-x" data-cd-close aria-label="Close cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </header>

    <div class="cd-body">
      <ul class="cd-list" data-cd-list></ul>

      <div class="cd-empty" data-cd-empty>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6.2"/><circle cx="10" cy="20" r="1.3"/><circle cx="17" cy="20" r="1.3"/></svg>
        <b>Your cart is empty</b>
        <p>Add a repair and it will show up here.</p>
        <a href="/services#catalog" class="cd-shop" data-cd-close>Find a repair</a>
      </div>

      <div class="cd-more" data-cd-more hidden>
        <form class="cd-coupon" data-cd-coupon>
          <svg class="cd-tagic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/></svg>
          <div>
            <label for="cd-code">Have a coupon code?</label>
            <div class="cd-cin">
              <input id="cd-code" name="code" placeholder="Enter coupon code" autocomplete="off" />
              <button type="submit">Apply</button>
            </div>
            <small data-cd-cmsg hidden></small>
          </div>
        </form>

        <h3 class="cd-sh">Order summary</h3>
        <div class="cd-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a4 4 0 0 0 5 5L21 13l-8 8-3-3 8-8M3 21l6-6M5 3l4 4-2 2-4-4"/></svg>
          <span>Repairs (<i data-cd-lines>0</i>)</span><b>{price()}</b>
        </div>
        <div class="cd-row">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
          <span>Visit / pickup <em class="cd-info" tabindex="0" aria-label="Doorstep visit or pickup, confirmed on WhatsApp" data-tip="Doorstep visit or pickup — confirmed with you on WhatsApp">i</em></span><b>{price()}</b>
        </div>
        <div class="cd-total">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6v18h7M14 3l5 5v4M14 3v5h5M9 13h4M9 17h2"/><circle cx="17.5" cy="17.5" r="3.5"/><path d="M17.5 16v1.6l1 .8"/></svg>
          <div><b>Estimated total</b><small>Final price is confirmed after diagnosis, before any work.</small></div>
          <strong>{price()}</strong>
        </div>

        <ul class="cd-trust">
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>Secure booking</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><rect x="3" y="14" width="4" height="6" rx="1.5"/><rect x="17" y="14" width="4" height="6" rx="1.5"/></svg>Updates on WhatsApp</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>Since {site.since}</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 11v9H4v-9zM7 11l4-8a2 2 0 0 1 2 2v4h5.5a2 2 0 0 1 2 2.3l-1.2 6.5a2 2 0 0 1-2 1.7H7"/></svg>No hidden charges</li>
        </ul>
      </div>
    </div>

    <footer class="cd-foot" data-cd-foot hidden>
      <a class="cd-go" data-cd-go href="#" target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9 0-1.4.7-2 1-2.3.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.7-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg>Checkout on WhatsApp<svg class="ar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      <span class="cd-or">or</span>
      <a class="cd-cont" href="/services#catalog" data-cd-close>Continue booking<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
    </footer>
  </aside>

  {categories.map((c) => <template data-cd-art={c.id}><DeviceArt kind={artFor[c.id]} /></template>)}
</div>
<div class="cd-toast" data-cd-toast role="status" aria-live="polite"></div>

<script>
  type Item = { id: string; device: string; model: string; issues: string[]; qty?: Record<string, number> };
  const root = document.querySelector<HTMLElement>('[data-cd]')!;
  const tel = root.dataset.tel!, P = root.dataset.price!;
  const cats: { id: string; name: string; brands: string[] }[] = JSON.parse(root.dataset.cats!);
  const photos: Record<string, string> = JSON.parse(root.dataset.photos!);
  const KEY = 'danat-cart', CKEY = 'danat-coupon';
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const load = (): Item[] => { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch { return []; } };
  const save = (v: Item[]) => { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch {} };
  let items = load();
  let coupon = ''; try { coupon = localStorage.getItem(CKEY) || ''; } catch {}

  // Which category an item belongs to (device can be a category name, a short tab label or a brand)
  const catOf = (it: Item) => {
    const d = it.device.toLowerCase();
    return cats.find((c) => c.name.toLowerCase() === d)
      ?? cats.find((c) => c.name.toLowerCase().startsWith(d.split(' ')[0].replace(/s$/, '')))
      ?? cats.find((c) => c.brands.some((b) => b.toLowerCase() === d));
  };
  const qtyOf = (it: Item, s: string) => it.qty?.[s] ?? 1;
  const TRASH = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>';

  const render = () => {
    const lines = items.reduce((n, it) => n + it.issues.reduce((m, s) => m + qtyOf(it, s), 0), 0);
    document.querySelectorAll<HTMLElement>('[data-cart-count]').forEach((b) => { b.textContent = String(lines); b.hidden = !lines; });
    root.querySelector('[data-cd-count]')!.textContent = `(${lines})`;
    root.querySelector('[data-cd-lines]')!.textContent = String(lines);
    root.querySelector<HTMLElement>('[data-cd-empty]')!.hidden = !!items.length;
    root.querySelector<HTMLElement>('[data-cd-foot]')!.hidden = !items.length;
    root.querySelector<HTMLElement>('[data-cd-more]')!.hidden = !items.length;
    const list = root.querySelector<HTMLElement>('[data-cd-list]')!;
    list.innerHTML = items.flatMap((it, i) => it.issues.map((s, k) => {
      const c = catOf(it);
      const ph = c && photos[`${c.id}:${s}`];
      return `
      <li class="cd-item">
        <div class="cd-th" data-art="${ph ? '' : c?.id ?? 'mobile'}">${ph ? `<img src="/media/repairs/${ph}.jpg" alt="" loading="lazy" />` : ''}</div>
        <div class="cd-info-c">
          <span class="cd-chip">${esc(c?.name ?? it.device)}</span>
          <b>${esc(s)}</b>
          <small>${esc(it.model || 'Model not specified')}</small>
          <div class="cd-qrow">
            <div class="cd-qty" role="group" aria-label="Quantity">
              <button type="button" data-cd-q="${i}:${k}:-1" aria-label="One less">−</button>
              <output>${qtyOf(it, s)}</output>
              <button type="button" data-cd-q="${i}:${k}:1" aria-label="One more">+</button>
            </div>
            <strong>${P}</strong>
          </div>
        </div>
        <button type="button" class="cd-rm" data-cd-rmi="${i}:${k}" aria-label="Remove ${esc(s)}">${TRASH}</button>
      </li>`;
    })).join('');
    list.querySelectorAll<HTMLElement>('[data-art]').forEach((th) => {
      const tpl = root.querySelector<HTMLTemplateElement>(`template[data-cd-art="${th.dataset.art}"]`);
      if (th.dataset.art && tpl) th.append(tpl.content.cloneNode(true));
    });
    const msg = `Hi Danat Fix, I want to book these repairs:\n${items.map((it) => `• ${it.issues.map((s) => qtyOf(it, s) > 1 ? `${s} ×${qtyOf(it, s)}` : s).join(', ')} — ${it.model || it.device}`).join('\n')}${coupon ? `\nCoupon code: ${coupon}` : ''}`;
    root.querySelector<HTMLAnchorElement>('[data-cd-go]')!.href = `https://wa.me/${tel}?text=${encodeURIComponent(msg)}`;
    const cm = root.querySelector<HTMLElement>('[data-cd-cmsg]')!;
    cm.hidden = !coupon;
    cm.innerHTML = coupon ? `Code <b>${esc(coupon)}</b> will be sent with your booking — our team confirms it on WhatsApp. <button type="button" data-cd-cx>Remove</button>` : '';
  };

  const open = () => { root.hidden = false; requestAnimationFrame(() => root.classList.add('in')); document.documentElement.style.overflow = 'hidden'; };
  const close = () => { root.classList.remove('in'); document.documentElement.style.overflow = ''; setTimeout(() => (root.hidden = true), 320); };
  let tt = 0;
  const toast = (t: string) => { const el = document.querySelector<HTMLElement>('[data-cd-toast]')!; el.textContent = t; el.classList.add('on'); clearTimeout(tt); tt = window.setTimeout(() => el.classList.remove('on'), 2200); };

  (window as any).danatCart = {
    add(it: Omit<Item, 'id'>, opts: { open?: boolean } = {}) {
      const same = items.find((x) => x.device === it.device && x.model === it.model);
      if (same) it.issues.forEach((s) => { if (!same.issues.includes(s)) same.issues.push(s); });
      else items.push({ ...it, id: Math.random().toString(36).slice(2) });
      save(items); render();
      toast(`✓ Added to cart — ${it.issues.join(', ')}`);
      document.querySelectorAll('[data-cart-open]').forEach((b) => { b.classList.remove('bump'); void (b as HTMLElement).offsetWidth; b.classList.add('bump'); });
      if (opts.open) open();
    },
    open, items: () => items,
  };

  const removeLine = (i: number, k: number) => {
    const it = items[i]; const s = it.issues[k];
    it.issues.splice(k, 1); if (it.qty) delete it.qty[s];
    if (!it.issues.length) items.splice(i, 1);
  };
  root.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-cd-close]')) close();
    const rmi = t.closest<HTMLElement>('[data-cd-rmi]');
    if (rmi) { const [i, k] = rmi.dataset.cdRmi!.split(':').map(Number); removeLine(i, k); save(items); render(); }
    const q = t.closest<HTMLElement>('[data-cd-q]');
    if (q) {
      const [i, k, d] = q.dataset.cdQ!.split(':').map(Number);
      const it = items[i]; const s = it.issues[k]; const n = qtyOf(it, s) + d;
      if (n < 1) removeLine(i, k); else { it.qty = { ...(it.qty ?? {}), [s]: Math.min(n, 20) }; }
      save(items); render();
    }
    if (t.closest('[data-cd-cx]')) { coupon = ''; try { localStorage.removeItem(CKEY); } catch {} render(); }
  });
  root.querySelector<HTMLFormElement>('[data-cd-coupon]')!.addEventListener('submit', (e) => {
    e.preventDefault();
    const inp = (e.currentTarget as HTMLFormElement).elements.namedItem('code') as HTMLInputElement;
    const v = inp.value.trim().toUpperCase().slice(0, 30);
    if (!v) { inp.focus(); return; }
    coupon = v; inp.value = ''; try { localStorage.setItem(CKEY, v); } catch {} render();
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !root.hidden) close(); });
  document.querySelectorAll('[data-cart-open]').forEach((b) => b.addEventListener('click', open));
  addEventListener('storage', (e) => { if (e.key === KEY) { items = load(); render(); } });
  render();
</script>

<style>
  .cd { position: fixed; inset: 0; z-index: 95; }
  .cd[hidden] { display: none; }
  .cd-bg { position: absolute; inset: 0; background: rgba(10, 16, 13, .45); opacity: 0; transition: opacity .3s; }
  .cd.in .cd-bg { opacity: 1; }
  .cd-panel { position: absolute; right: 0; top: 0; bottom: 0; width: min(520px, 100%); display: flex; flex-direction: column; background: var(--surface); color: var(--ink); border-radius: 24px 0 0 24px; box-shadow: -30px 0 60px -20px rgba(0,0,0,.35); transform: translateX(100%); transition: transform .35s cubic-bezier(.2,.8,.2,1); }
  .cd.in .cd-panel { transform: none; }
  .cd-head { display: flex; align-items: start; justify-content: space-between; gap: 12px; padding: 26px 26px 14px; }
  .cd-head h2 { font-size: 26px; letter-spacing: -.02em; }
  .cd-head p { margin-top: 4px; font-size: 14.5px; color: var(--ink-3); }
  .cd-x { flex: none; display: grid; place-items: center; width: 40px; height: 40px; border: 0; border-radius: 50%; background: var(--tint-2); color: var(--ink); transition: background .2s; }
  .cd-x:hover { background: var(--line); }
  .cd-x svg { width: 18px; height: 18px; }
  .cd-body { flex: 1; overflow-y: auto; padding: 4px 26px 18px; }

  .cd-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .cd-list :global(.cd-item) { position: relative; display: grid; grid-template-columns: 116px 1fr; gap: 16px; padding: 14px; border: 1px solid var(--line); border-radius: 18px; background: var(--surface); animation: cdIn .3s ease; }
  @keyframes cdIn { from { opacity: 0; transform: translateX(20px); } }
  .cd-list :global(.cd-th) { display: grid; place-items: center; aspect-ratio: 1; border-radius: 14px; overflow: hidden; background: linear-gradient(160deg, var(--tint), var(--tint-2)); }
  .cd-list :global(.cd-th img) { width: 100%; height: 100%; object-fit: cover; }
  .cd-list :global(.cd-th svg) { width: 78%; height: 78%; }
  .cd-list :global(.cd-info-c) { display: grid; align-content: start; gap: 3px; min-width: 0; padding-right: 30px; }
  .cd-list :global(.cd-chip) { justify-self: start; padding: 3px 8px; border-radius: 6px; background: var(--accent-soft); color: var(--violet); font-size: 10.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .cd-list :global(.cd-info-c b) { margin-top: 4px; font-size: 16px; line-height: 1.25; }
  .cd-list :global(.cd-info-c small) { font-size: 13.5px; color: var(--ink-3); }
  .cd-list :global(.cd-qrow) { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 10px; }
  .cd-list :global(.cd-qty) { display: inline-grid; grid-template-columns: 38px 44px 38px; height: 38px; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
  .cd-list :global(.cd-qty button) { border: 0; background: none; font-size: 18px; color: var(--ink); transition: background .2s; }
  .cd-list :global(.cd-qty button:hover) { background: var(--tint-2); }
  .cd-list :global(.cd-qty output) { display: grid; place-items: center; border-inline: 1px solid var(--line); font-weight: 700; }
  .cd-list :global(.cd-qrow strong) { color: var(--lime); font-size: 18px; font-family: var(--display); white-space: nowrap; }
  .cd-list :global(.cd-rm) { position: absolute; right: 12px; top: 12px; display: grid; place-items: center; width: 32px; height: 32px; border: 0; border-radius: 8px; background: none; color: var(--ink-2); transition: all .2s; }
  .cd-list :global(.cd-rm:hover) { background: #fde8ec; color: #be123c; }
  .cd-list :global(.cd-rm svg) { width: 19px; height: 19px; }

  .cd-empty { display: grid; justify-items: center; gap: 8px; padding: 60px 10px; text-align: center; color: var(--ink-3); }
  .cd-empty[hidden], .cd-more[hidden] { display: none; }
  .cd-empty svg { width: 64px; height: 64px; color: var(--line); }
  .cd-empty b { font-size: 17px; color: var(--ink); }
  .cd-shop { margin-top: 10px; padding: 12px 22px; border-radius: 999px; background: var(--violet); color: var(--on-accent); font-weight: 700; }

  .cd-coupon { display: grid; grid-template-columns: auto 1fr; align-items: center; gap: 14px; margin-top: 14px; padding: 16px; border-radius: 16px; background: var(--accent-soft); }
  .cd-tagic { width: 30px; height: 30px; color: var(--violet); }
  .cd-coupon label { display: block; margin-bottom: 8px; font-size: 14px; font-weight: 700; }
  .cd-cin { display: flex; gap: 8px; }
  .cd-cin input { flex: 1; min-width: 0; height: 44px; padding: 0 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); font: inherit; font-size: 14.5px; color: var(--ink); outline: none; }
  .cd-cin input:focus { border-color: var(--violet); }
  .cd-cin button { padding: 0 18px; border: 0; border-radius: 10px; background: var(--violet); color: var(--on-accent); font-weight: 700; font-size: 14.5px; }
  .cd-coupon small { display: block; margin-top: 8px; font-size: 12.5px; color: var(--ink-2); }
  .cd-coupon small :global(button) { border: 0; background: none; padding: 0; color: #be123c; font-size: 12.5px; text-decoration: underline; }

  .cd-sh { margin: 22px 0 8px; font-size: 19px; }
  .cd-row { display: grid; grid-template-columns: 24px 1fr auto; align-items: center; gap: 12px; padding: 11px 4px; border-bottom: 1px solid var(--line); font-size: 15px; color: var(--ink-2); }
  .cd-row svg { width: 22px; height: 22px; color: var(--violet); }
  .cd-row i { font-style: normal; }
  .cd-row b { color: var(--ink); }
  .cd-info { position: relative; display: inline-grid; place-items: center; width: 17px; height: 17px; margin-left: 6px; border: 1.5px solid var(--ink-3); border-radius: 50%; font-size: 10.5px; font-style: normal; font-weight: 800; color: var(--ink-3); cursor: help; vertical-align: 1px; }
  .cd-info::after { content: attr(data-tip); position: absolute; left: 50%; bottom: calc(100% + 8px); width: 200px; padding: 8px 10px; border-radius: 8px; background: #16211b; color: #fff; font-size: 12px; font-weight: 500; line-height: 1.35; transform: translateX(-50%); opacity: 0; pointer-events: none; transition: opacity .2s; }
  .cd-info:hover::after, .cd-info:focus::after { opacity: 1; }
  .cd-total { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px; margin-top: 14px; padding: 16px 18px; border-radius: 16px; background: var(--accent-soft); }
  .cd-total > svg { width: 34px; height: 34px; color: var(--violet); }
  .cd-total b { display: block; font-size: 15px; }
  .cd-total small { display: block; margin-top: 2px; font-size: 13px; color: var(--ink-3); line-height: 1.35; }
  .cd-total strong { color: var(--violet); font-size: 28px; font-family: var(--display); white-space: nowrap; }
  .cd-trust { list-style: none; margin: 14px 0 0; padding: 14px 6px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; border: 1px solid var(--line); border-radius: 16px; }
  .cd-trust li { display: grid; justify-items: center; gap: 6px; text-align: center; font-size: 11.5px; color: var(--ink-2); }
  .cd-trust svg { width: 24px; height: 24px; color: var(--violet); }

  .cd-foot { display: grid; gap: 8px; padding: 14px 26px 22px; border-top: 1px solid var(--line); background: var(--surface); }
  .cd-foot[hidden] { display: none; }
