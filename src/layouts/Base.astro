---
import '../styles/global.css';
import { site, nav } from '../data/site';
import MegaMenu from '../components/MegaMenu.astro';
import Popups from '../components/Popups.astro';
import LocalCurrency from '../components/LocalCurrency.astro';
import BrandSwitch from '../components/BrandSwitch.astro';
import ShadePicker from '../components/ShadePicker.astro';
import Engage from '../components/Engage.astro';
import ChatBot from '../components/ChatBot.astro';
import CartDrawer from '../components/CartDrawer.astro';
import SlotPicker from '../components/SlotPicker.astro';
import PricePicker from '../components/PricePicker.astro';
import HeaderSearch from '../components/HeaderSearch.astro';
import { getContent, contactOf, type Content } from '../lib/content';
import { getCatalog, type Catalog } from '../lib/catalog';
import { hostOf } from '../lib/odoo';

interface Props {
  title?: string;
  description?: string;
  /** No welcome offer or idle pop-ups (pages opened from a WhatsApp link). */
  quiet?: boolean;
  /** The site's texts from Odoo, when the page already fetched them (the home page does). */
  content?: Content;
  /** Odoo's catalogue, when the page already fetched it (Home and Services do). */
  catalog?: Catalog;
}

// Name, tagline, contact details, header menu, branches and footer: edited in Odoo (Fix Website
// ▸ Website Details). The devices and repairs in the menu, search, chat bot, pop-ups, cart and
// footer: Odoo's catalogue (369 ai Fix ▸ Catalogue). A page built once at deploy time gets them
// at build time; the rest per request.
const host = hostOf(Astro.request);
const [content, catalog] = await Promise.all([Astro.props.content ?? getContent(host), Astro.props.catalog ?? getCatalog(host)]);
const C = content.site;
const contact = contactOf(C);
const siteName = C.name || site.name, tagline = C.tagline || site.tagline;
const { title, description = `${tagline} — screens, batteries and more for every major phone brand.`, quiet = false } = Astro.props;
const fullTitle = title ? `${title} · ${siteName}` : `${siteName} — ${tagline}`;
const menu = C.header.menu.length ? C.header.menu.map((m) => ({ href: m.link, label: m.label })) : nav;
const waNumber = contact.wa;
const cats = catalog.categories;
const year = String(new Date().getFullYear());
// Info pages (Fix Website ▸ Info Pages) listed in their footer column
const pageCols = ([['company', 'Company'], ['help', 'Help'], ['policies', 'Policies']] as const)
  .map(([key, label]) => ({ label, pages: content.pages.filter((p) => p.column === key) }))
  .filter((c) => c.pages.length);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// the areas our technicians reach: the location chip says whether a saved address is one of them
const serviceAreas = [...new Set(content.coverage.doorstep.zones.flatMap((z) => z.areas))];
// the footer: every info page in one Company column; each branch knows the words of its coverage zone
const infoPages = pageCols.flatMap((c) => c.pages);
const branchWords = (b: { name: string }) => {
  const n = b.name.toLowerCase();
  const zones = content.coverage.doorstep.zones;
  const z = zones.find((x) => x.name.toLowerCase().includes(n)) ?? zones.find((x) => x.areas.some((a) => a.toLowerCase() === n));
  return [b.name, ...(z ? [z.name, ...z.areas] : [])];
};

// Services mega menu. Every link lands on the Services page — the site stays three pages.
---

<!doctype html>
<html lang="en" data-theme="danat" data-menu="1" data-reviews="1" data-quiet={quiet ? '1' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon-danat.png" type="image/png" data-favicon />
    <link rel="apple-touch-icon" href="/favicon-danat.png" data-favicon />
    <link rel="preload" href="/fonts/schibsted.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jakarta.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        // Brand (Danat Fix default, or 369 ai Fix) - set before paint so the right logo shows first
        let br = new URLSearchParams(location.search).get('brand');
        try { localStorage.removeItem('brand'); } catch {} // every visit opens as Danat Fix; only a ?brand=369 link starts on 369
        document.documentElement.dataset.brand = br === '369' ? '369' : 'danatfix';
        // browser-tab icon follows the brand
        document.querySelectorAll('link[data-favicon]').forEach((l) => l.setAttribute('href', br === '369' ? '/favicon-369.png' : '/favicon-danat.png'));
        let sh = new URLSearchParams(location.search).get('shade');
        try { if (sh && /^(0|[1-9]|1[0-4]|2[1-8]|3[2-7])$/.test(sh)) localStorage.setItem('shade', sh); else sh = localStorage.getItem('shade'); } catch {}
        if (sh && /^([1-9]|1[0-4]|2[1-8]|3[2-7])$/.test(sh)) document.documentElement.dataset.shade = sh;
        // Theme picker removed: always the default green, menu 1, reviews 1, slot popup.
        try { ['theme', 'menu', 'reviews', 'welcome-popup'].forEach((k) => localStorage.removeItem(k)); } catch {}
      })();
    </script>
  </head>
  <body>
    <Popups contact={contact} visitFee={C.visit_fee} popups={content.popups} wheel={content.wheel} />
    <LocalCurrency />
    <Engage categories={cats} contact={contact} engage={content.engage} />
    <ChatBot coverage={content.coverage} categories={cats} contact={contact} visitFee={C.visit_fee} bot={content.bot} site={C} />
    <CartDrawer categories={cats} contact={contact} visitFee={C.visit_fee} />
    <SlotPicker />
    <PricePicker />
    <div class="aurora" aria-hidden="true">
      <span class="orb o1"></span>
      <span class="grid"></span>
    </div>

    <header class="nav">
      <div class="wrap nav-inner glass">
        <BrandSwitch />
        <nav aria-label="Main">
          <ul>
            {menu.map((n) => n.href === '/services' ? (
              <li class="has-mega">
                <a href={n.href} aria-current={path === n.href ? 'page' : undefined} aria-haspopup="true">
                  {n.label}
                  <svg class="caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                </a>
                <div class="mega"><MegaMenu categories={cats} /></div>
              </li>
            ) : (
              <li>
                <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <button type="button" class="loc-chip" data-loc-chip title="Choose your location" data-areas={JSON.stringify(serviceAreas)}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
          <span class="loc-tx"><small data-loc-state>Your location</small><b data-loc-name>Select location</b></span>
          <svg class="loc-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
        </button>        <ShadePicker />
        <HeaderSearch categories={cats} />
        <!-- the customer's account (as on 369 Mart): their initial once signed in; filled in by the script below -->
        <a href="/account" class="nav-acct" data-acct aria-label="Sign in" aria-current={path === '/account' ? 'page' : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg><b data-acct-init hidden></b></a>
        <button type="button" class="nav-cart" data-cart-open aria-label="Open cart"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 3.5h2.2l2.4 11.2a1.5 1.5 0 0 0 1.5 1.2h8.6a1.5 1.5 0 0 0 1.5-1.1l1.8-7.3H6"/><circle cx="9.5" cy="19.8" r="1.4"/><circle cx="17" cy="19.8" r="1.4"/></svg><b data-cart-count hidden>0</b></button>
        <a href={C.header.cta_link || '/services#catalog'} class="btn btn-primary nav-cta" aria-label={C.header.cta || 'Book a repair'}>{(C.header.cta || 'Book a repair').split(' ')[0]}<span class="nav-cta-x"> {(C.header.cta || 'Book a repair').split(' ').slice(1).join(' ')}</span></a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap ft-grid">
        <div class="ft-about">
          <a href="/" class="logo foot-logo" aria-label={siteName} data-no-brand><img class="logo-369" data-for="danatfix" src="/brand/danat-fix-mark.png" alt="Danat Fix" width="196" height="200" loading="lazy" /><img class="logo-369" data-for="369" src="/brand/369-ai-fix-mark.png" alt="369 ai Fix" width="257" height="200" loading="lazy" /></a>
          <p class="ft-desc">{C.footer.about || `${tagline}, across ${site.country} since ${C.since || site.since}.`}</p>
          <ul class="ft-contact">
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg><a href={`tel:${contact.tel}`}>{contact.display}</a></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg><a href={`mailto:${C.email || site.email}`}>{C.email || site.email}</a></li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg><a href="/#check-location">Check if we cover your area</a><em class="ft-tag">Doorstep</em></li>
          </ul>
          <ul class="ft-icons" aria-label="Follow us">
            {(C.social.facebook || site.social.facebook) && <li><a href={C.social.facebook || site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook" style="--c:#1877F2"><i style="--m:url(/brand/ai/facebook.svg)"></i></a></li>}
            {(C.social.instagram || site.social.instagram) && <li><a href={C.social.instagram || site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram" style="--c:#E4405F"><i style="--m:url(/brand/ai/instagram.svg)"></i></a></li>}
            <li><a href={`https://wa.me/${waNumber}`} target="_blank" rel="noopener" aria-label="WhatsApp" style="--c:#25D366"><i style="--m:url(/brand/ai/whatsapp.svg)"></i></a></li>
          </ul>
        </div>
        <div class="ft-col ft-col-wide" role="navigation" aria-label="Services">
          <p class="ft-h">Services</p>
          <ul class="ft-two">{cats.map((c) => <li><a href={`/services?cat=${c.id}#catalog`}>{c.name}</a></li>)}</ul>
        </div>
        <div class="ft-col" role="navigation" aria-label="Quick links">
          <p class="ft-h">Quick links</p>
          <ul>
            {C.quick_links.map((n) => <li><a href={n.link} target={/^https?:/.test(n.link) ? '_blank' : undefined} rel={/^https?:/.test(n.link) ? 'noopener' : undefined}>{n.label}</a></li>)}
          </ul>
        </div>
        {infoPages.length > 0 && (
          <div class="ft-col" role="navigation" aria-label="Company">
            <p class="ft-h">Company</p>
            <ul>{infoPages.map((p) => <li><a href={`/page/${p.slug}`}>{p.title}</a></li>)}</ul>
          </div>
        )}
      </div>
      <!-- Our branches: one card with a tab per branch; the branch nearest the visitor's location opens first -->
      <div class="wrap ft-offices" data-ft-branches>
        <div class="ft-bhead">
          <p class="ft-h">Our branches</p>
          <div class="ft-tabs" role="tablist" aria-label="Branch">
            {C.branches.map((b, i) => <button type="button" role="tab" id={`ft-tab-${i}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls={`ft-branch-${i}`} data-ft-tab={i} data-match={JSON.stringify(branchWords(b))}>{b.name}</button>)}
          </div>
          <span class="ft-near" data-ft-near hidden>Nearest to you</span>
        </div>
        {C.branches.map((b, i) => (
          <div class="ft-branch" id={`ft-branch-${i}`} role="tabpanel" aria-labelledby={`ft-tab-${i}`} data-ft-panel={i} hidden={i !== 0}>
            <div class="ft-binfo">
              <b><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>Oman — {b.name}</b>
              <address>{b.lines.join(' · ')}</address>
              <span class="ft-tels">{b.phones.map((p) => <a class="ft-tel" href={`tel:${p.replace(/\s/g, '')}`}>{p}</a>)}</span>
            </div>
            <div class="ft-bacts">
              {b.phones[0] && <a class="ft-call" href={`tel:${b.phones[0].replace(/\s/g, '')}`}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>Call {b.name}</a>}
              <a class="ft-dir" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(b.map)}`} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l18-8-8 18-2-8z"/></svg>Get directions</a>
            </div>
          </div>
        ))}
      </div>
      <div class="wrap ft-base">
        <span>{(C.footer.copyright || `© {year} ${siteName}. All rights reserved.`).replace('{year}', year)}</span>
        {C.footer.credit ? <span>{C.footer.credit}</span> : <span>Site developed and maintained by <a class="ft-dev" href="https://alphalize.com" target="_blank" rel="noopener">alphalize</a></span>}
      </div>
    </footer>

    <script>
      // The header's account button: the customer's initial once signed in (one sign-in for the
      // whole site, kept by Odoo's session - see src/lib/account.ts). The last answer is kept for
      // this tab so the next page paints it at once; pages that sign in or out send `danat-account`.
      {
        const btn = document.querySelector<HTMLAnchorElement>('[data-acct]');
        const paint = (who: { name?: string; phone?: string } | null) => {
          if (!btn) return;
          const name = (who?.name || '').trim();
          const init = btn.querySelector<HTMLElement>('[data-acct-init]')!;
          btn.classList.toggle('in', !!who);
          init.hidden = !who;
          init.textContent = who ? (name ? name[0].toUpperCase() : '+') : '';
          btn.setAttribute('aria-label', who ? `My account${name ? `, ${name}` : ''}` : 'Sign in');
          btn.title = who ? (name || 'My account') : 'Sign in';
        };
        const remember = (who: any) => { try { sessionStorage.setItem('df_me', JSON.stringify(who)); } catch {} };
        try { const kept = sessionStorage.getItem('df_me'); if (kept) paint(JSON.parse(kept)); } catch {}
        // the default saved address, for the location chip (below)
        const address = (a: any) => window.dispatchEvent(new CustomEvent('danat-address', { detail: a
          ? { label: a.label, area: a.area, town: a.town, line: a.line, pin: a.pin } : null }));
        const loadAddress = () => fetch('/api/account/addresses', { credentials: 'same-origin', cache: 'no-store' })
          .then(async (r) => {
            if (!r.ok) { if (r.status === 401) address(null); return; }
            const d = await r.json().catch(() => null);
            const list: any[] = d?.addresses || [];
            address(list.find((a) => a.id === d.selected) || list.find((a) => a.default) || list[0] || null);
          })
          .catch(() => {});
        fetch('/api/account/me', { credentials: 'same-origin', cache: 'no-store' })
          .then(async (r) => {
            if (r.status === 401) { paint(null); remember(null); address(null); return; }
            const who = r.ok ? await r.json().catch(() => null) : null;
            if (who?.ok) { const w = { name: who.name, phone: who.phone }; paint(w); remember(w); loadAddress(); }
          })
          .catch(() => {});   // offline or Odoo down: keep what is shown
        window.addEventListener('danat-account', (e) => {
          const who = (e as CustomEvent).detail;
          const w = who ? { name: who.name, phone: who.phone } : null;
          paint(w); remember(w);
          if (w) loadAddress(); else address(null);
        });
        // an address added or made the default (My account, booking): the chip follows
        window.addEventListener('danat-addresses', () => loadAddress());
      }

      // The footer's branch tabs. The branch nearest the visitor opens first: the one whose
      // coverage zone names the saved address (signed in) or the location chip's area.
      const branches = document.querySelector<HTMLElement>('[data-ft-branches]');
      if (branches) {
        const tabs = [...branches.querySelectorAll<HTMLButtonElement>('[data-ft-tab]')];
        const panels = [...branches.querySelectorAll<HTMLElement>('[data-ft-panel]')];
        const near = branches.querySelector<HTMLElement>('[data-ft-near]')!;
        const show = (i: number, nearest = false) => {
          tabs.forEach((t) => t.setAttribute('aria-selected', String(Number(t.dataset.ftTab) === i)));
          panels.forEach((p) => (p.hidden = Number(p.dataset.ftPanel) !== i));
          near.hidden = !nearest;
        };
        tabs.forEach((t) => t.addEventListener('click', () => show(Number(t.dataset.ftTab))));
        // place names are spelled many ways (Bawshar / Bausher): compare without "al", w/y and vowel runs
        const skel = (w: string) => w.toLowerCase().replace(/[^a-z]/g, '').replace(/[wy]/g, '').replace(/[aeiou]+/g, 'v');
        const words = (s: string) => s.split(/[\s,\-\/·]+/).filter((w) => w && !/^al$/i.test(w)).map(skel).filter(Boolean);
        const pickNearest = (text: string) => {
          if (!text) return;
          const have = new Set(words(text));
          const i = tabs.findIndex((t) => { try { return (JSON.parse(t.dataset.match || '[]') as string[]).some((m) => words(m).every((w) => have.has(w))); } catch { return false; } });
          if (i >= 0) show(i, true);
        };
        const fromAddress = (a: any) => pickNearest(a ? [a.area, a.town].filter(Boolean).join(', ') : '');
        try { const a = JSON.parse(sessionStorage.getItem('df_addr') || 'null'); if (a) fromAddress(a); else pickNearest(JSON.parse(localStorage.getItem('svc-loc') || 'null')?.name || ''); } catch {}
        window.addEventListener('danat-address', (e) => fromAddress((e as CustomEvent).detail));
        window.addEventListener('svc-loc', (e) => pickNearest((e as CustomEvent).detail?.name || ''));
      }

      // Count-up numbers, site-wide: any <b data-count="12" data-from="0" data-suffix="+"> counts up the
      // first time it scrolls into view. The final value is already in the HTML, so nothing breaks without JS.
      // window.__countUp(el) replays it (used when a panel with a number is shown).
      {
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const countUp = (el: HTMLElement) => {
          const to = Number(el.dataset.count), from = Number(el.dataset.from ?? 0), sfx = el.dataset.suffix ?? '';
          if (still || !Number.isFinite(to)) { el.textContent = to + sfx; return; }
          const t0 = performance.now(), D = 2000;
          el.classList.add('counting');
          const step = (now: number) => {
            const k = Math.min(1, (now - t0) / D), e = 1 - Math.pow(1 - k, 2);
            el.textContent = Math.round(from + (to - from) * e) + sfx;
            if (k < 1) requestAnimationFrame(step); else { el.classList.remove('counting'); el.classList.add('counted'); setTimeout(() => el.classList.remove('counted'), 600); }
          };
          el.textContent = from + sfx; requestAnimationFrame(step);
        };
        (window as any).__countUp = countUp;
        // replays every time the number scrolls back into view (up or down); armed again once it leaves
        const armed = new WeakSet<Element>();
        const io = new IntersectionObserver((es) => es.forEach((e) => {
          if (e.isIntersecting && e.intersectionRatio >= .6) { if (!armed.has(e.target)) { armed.add(e.target); countUp(e.target as HTMLElement); } }
          else if (!e.isIntersecting) armed.delete(e.target);
        }), { threshold: [0, .6] });
        document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => io.observe(el));
      }

      // Header location chip (like "Deliver to" on shopping sites): shows the last checked area,
      // opens the location picker on Home, or goes Home and opens it from other pages.
      const chip = document.querySelector<HTMLButtonElement>('[data-loc-chip]');
      if (chip) {
        const nameEl = chip.querySelector('[data-loc-name]')!;
        const stateEl = chip.querySelector('[data-loc-state]')!;
        // the small line says whether we actually serve there — never "Service at" a place we don't cover
        const paint = (v: { name?: string; covered?: boolean } | null) => {
          if (!v?.name) return;
          nameEl.textContent = v.name; stateEl.textContent = v.covered ? 'We serve here' : 'Outside our area';
          chip.classList.toggle('ok', !!v.covered); chip.classList.toggle('no', !v.covered);
          chip.title = v.covered ? `Doorstep service available in ${v.name}` : `${v.name} is outside our service area — tap to change`;
        };
        const plain = { name: nameEl.textContent, state: stateEl.textContent, title: chip.title };
        // Signed in with a saved address (as on 369 Mart): the default address, and whether we serve there.
        // A tap then manages the addresses; signed out, it stays the area picker.
        // Place names are spelled many ways (Bawshar / Bausher, Ghubra / al Ghubrah al Shamaliyah): compare
        // word by word without "al" and w/y, any run of vowels as one. Covered = every word of one of our areas is in the address.
        const skel = (w: string) => w.toLowerCase().replace(/[^a-z]/g, '').replace(/[wy]/g, '').replace(/[aeiou]+/g, 'v');
        const words = (s: string) => s.split(/[\s,\-]+/).filter((w) => w && !/^al$/i.test(w)).map(skel).filter(Boolean);
        const areas: string[][] = JSON.parse(chip.dataset.areas || '[]').map(words).filter((a: string[]) => a.length);
        const reached = (text: string) => { const have = new Set(words(text)); return areas.some((a) => a.every((w) => have.has(w))); };
        let addr: { label?: string; area?: string; town?: string; line?: string; pin?: string } | null = null;
        const paintAddr = (a: typeof addr) => {
          addr = a?.area || a?.town ? a : null;
          if (!addr) {
            nameEl.textContent = plain.name; stateEl.textContent = plain.state; chip.title = plain.title;
            chip.classList.remove('ok', 'no');
            try { paint(JSON.parse(localStorage.getItem('svc-loc') || 'null')); } catch {}
            return;
          }
          const where = [addr.area, addr.town].filter(Boolean).join(', ');
          const covered = reached(where);
          stateEl.textContent = `Service at ${addr.label || 'your address'}`;
          nameEl.textContent = where;
          chip.classList.toggle('ok', covered); chip.classList.toggle('no', !covered);
          chip.title = `${[addr.line, where, addr.pin && 'PC ' + addr.pin].filter(Boolean).join(', ')}${covered ? '' : ' (please check we reach this area)'} - tap to change`;
        };
        try { paint(JSON.parse(localStorage.getItem('svc-loc') || 'null')); } catch {}
        try { const kept = JSON.parse(sessionStorage.getItem('df_addr') || 'null'); if (kept) paintAddr(kept); } catch {}
        window.addEventListener('svc-loc', (e) => { if (!addr) paint((e as CustomEvent).detail); });
        window.addEventListener('danat-address', (e) => {
          const a = (e as CustomEvent).detail;
          try { sessionStorage.setItem('df_addr', JSON.stringify(a)); } catch {}
          paintAddr(a);
        });
        chip.addEventListener('click', () => {
          if (addr) { location.href = '/account#address'; return; }
          const open = (window as any).__openLocation; if (open) open(); else location.href = '/#check-location';
        });
      }
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        }),
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));

      const nav = document.querySelector('.nav');
      const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 12);
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });

      // Services menu. Opens on hover, but not when a page loads with the
      // pointer already over it (arms after the pointer has been outside once);
      // closes on click. Inside the visible style, hovering a device ([data-d])
      // swaps the matching panels ([data-dp]) after a short hover intent.
      const megaLi = document.querySelector<HTMLElement>('.has-mega');
      if (megaLi) {
        let t = 0;
        let armed = false;
        const close = () => { clearTimeout(t); megaLi.classList.remove('open'); };
        document.addEventListener('pointermove', (e) => { if (!megaLi.contains(e.target as Node)) armed = true; }, { passive: true });
        megaLi.addEventListener('pointerenter', () => { if (!armed) return; clearTimeout(t); t = window.setTimeout(() => megaLi.classList.add('open'), 60); });
        megaLi.addEventListener('pointerleave', () => { clearTimeout(t); t = window.setTimeout(close, 160); });
        megaLi.addEventListener('focusin', () => megaLi.classList.add('open'));
        megaLi.addEventListener('focusout', (e) => { if (!megaLi.contains(e.relatedTarget as Node)) close(); });
        megaLi.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
        megaLi.querySelectorAll<HTMLElement>('[data-mv]').forEach((mv) => {
          const items = mv.querySelectorAll<HTMLElement>('[data-d]');
          const show = (id: string) => {
            items.forEach((x) => x.classList.toggle('on', x.dataset.d === id));
            mv.querySelectorAll<HTMLElement>('[data-dp]').forEach((x) => x.classList.toggle('on', x.dataset.dp === id));
          };
          let dt = 0;
          items.forEach((x) => {
            x.addEventListener('pointerenter', () => { clearTimeout(dt); dt = window.setTimeout(() => { if (x.matches(':hover')) show(x.dataset.d!); }, 90); });
            x.addEventListener('pointerleave', () => clearTimeout(dt));
            x.addEventListener('focus', () => show(x.dataset.d!));
          });
        });
        megaLi.querySelectorAll('.mega a').forEach((a) => a.addEventListener('click', () => {
          close();
          armed = false;
          (document.activeElement as HTMLElement | null)?.blur();
        }));
      }

    </script>
  </body>
</html>

